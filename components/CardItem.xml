<?xml version="1.0" encoding="utf-8" ?>
<!-- A poster or landscape Card used in Rows and grids. Styled by the Theme.
     The Card sits inside a padded cell so it can grow from its centre, with
     a focus ring just outside its edge, without anything being cut off. -->
<component name="CardItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="showContent" />
    <field id="width" type="float" />
    <field id="height" type="float" />
    <field id="focusPercent" type="float" onChange="updateFocus" />
    <field id="rowFocusPercent" type="float" value="1.0" onChange="updateFocus" />
    <field id="rowListHasFocus" type="boolean" onChange="updateFocus" />
    <field id="gridHasFocus" type="boolean" onChange="updateFocus" />
  </interface>
  <script type="text/brightscript" uri="CardItem.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <children>
    <Group id="card">
      <Poster id="placeholder" />
      <Label id="fallback" horizAlign="center" vertAlign="center" wrap="true" maxLines="3">
        <Font role="font" uri="font:BoldSystemFontFile" size="24" />
      </Label>
      <Poster id="poster" loadDisplayMode="scaleToZoom" opacity="0" />
      <Poster id="shade" uri="pkg:/images/grad_up.png" loadDisplayMode="scaleToFill" visible="false" />
      <Label id="caption" vertAlign="center" visible="false">
        <Font role="font" uri="font:BoldSystemFontFile" size="24" />
      </Label>
      <Label id="captionSub" vertAlign="center" visible="false">
        <Font role="font" uri="font:SystemFontFile" size="18" />
      </Label>
      <Rectangle id="trackBg" visible="false" />
      <Rectangle id="track" visible="false" />
      <Poster id="corners" visible="false" />
      <Group id="badge" visible="false">
        <Poster id="badgeBg" />
        <Label id="badgeText" vertAlign="center" horizAlign="center">
          <Font role="font" uri="font:BoldSystemFontFile" size="20" />
        </Label>
      </Group>
    </Group>
    <!-- The ring sits outside the scaled Card so it stays crisp and lands on whole pixels.
         It is drawn above the Card: its curved corners pass over the square tips of the
         Card's corner covers, which would otherwise show as square corners. -->
    <Poster id="ring" opacity="0" />
    <Animation id="fadeIn" duration="0.25" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="poster.opacity" />
    </Animation>
  </children>
</component>
