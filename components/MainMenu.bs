' The Rail: an always-visible 112 px column of icons down the left edge.
' The current screen's icon sits on a soft square in the Accent; while the
' Rail has focus, the Focused icon turns solid with its name beside it.
' My requests carries a count of downloading requests while there are any.
sub init()
    m.layer = m.top.findNode("layer")
    m.index = 0
    m.nodes = []
    m.badge = invalid
    m.global.observeField("requestsDownloading", "paintBadge")
end sub

sub build()
    t = th()
    m.layer.removeChildrenIndex(m.layer.getChildCount(), 0)
    m.nodes = []
    m.badge = invalid
    items = m.top.items
    if items = invalid then items = []
    y = 240
    for i = 0 to items.Count() - 1
        it = items[i]
        ' Settings sits apart from the places to browse.
        if it.key = "settings" then y = y + 80
        g = m.layer.CreateChild("Group")
        g.translation = [24, y]
        sq = makeBox(g, 64, 64, 16, t.white, 0.10)
        ic = makeIcon(g, it.icon, 30, t.idle)
        ic.translation = [17, 17]
        tip = g.CreateChild("Group")
        tip.translation = [84, 10]
        tipW = measureText(it.label, 20, "semibold") + 40
        makeBox(tip, tipW, 44, 22, t.raised)
        tl = makeLabel(tip, it.label, 20, "semibold", t.text)
        tl.translation = [20, 0]
        tl.height = 44
        tl.vertAlign = "center"
        tip.visible = false
        if it.key = "myrequests" then m.badge = makeCountBadge(g)
        m.nodes.Push({ square: sq, icon: ic, tip: tip })
        y = y + 76
    end for
    paint()
    paintBadge()
end sub

' A small Accent dot with a number, on the icon's top right corner.
function makeCountBadge(parent as object) as object
    t = th()
    g = parent.CreateChild("Group")
    g.translation = [42, -4]
    disc = makeShape(g, "pkg:/images/circle_fill.png", 28, 28, t.accent)
    l = makeLabel(g, "", 16, "semibold", t.onAccent)
    l.width = 28
    l.height = 28
    l.horizAlign = "center"
    l.vertAlign = "center"
    return { group: g, disc: disc, label: l }
end function

sub paintBadge()
    if m.badge = invalid then return
    n = m.global.requestsDownloading
    if n = invalid then n = 0
    m.badge.group.visible = n > 0
    text = n.ToStr()
    if n > 9 then text = "9+"
    m.badge.label.text = text
end sub

function keyIndex(key as string) as integer
    items = m.top.items
    if items = invalid then return 0
    for i = 0 to items.Count() - 1
        if items[i].key = key then return i
    end for
    return 0
end function

sub onOpen()
    if m.top.open then m.index = keyIndex(m.top.currentKey)
    paint()
end sub

sub paint()
    t = th()
    items = m.top.items
    if items = invalid then return
    cur = -1
    for i = 0 to items.Count() - 1
        if items[i].key = m.top.currentKey then cur = i
    end for
    isOpen = m.top.open
    for i = 0 to m.nodes.Count() - 1
        n = m.nodes[i]
        focused = isOpen and i = m.index
        n.tip.visible = focused
        if focused
            n.square.visible = true
            n.square.blendColor = t.solid
            n.square.opacity = 1.0
            n.icon.blendColor = t.onSolid
        else if i = cur
            n.square.visible = true
            n.square.blendColor = t.white
            n.square.opacity = 0.10
            n.icon.blendColor = t.accent
        else
            n.square.visible = false
            n.icon.blendColor = t.idle
        end if
    end for
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or not m.top.open then return false
    count = m.nodes.Count()
    if key = "up"
        if m.index > 0 then m.index = m.index - 1
        paint()
    else if key = "down"
        if m.index < count - 1 then m.index = m.index + 1
        paint()
    else if key = "OK"
        if count > 0 then m.top.chosen = m.top.items[m.index].key
    else if key = "back" and m.top.backExits
        ' Let Back reach MainScene, which exits from Home.
        return false
    else if key = "right" or key = "back"
        m.top.closeRequested = true
    end if
    return true
end function
