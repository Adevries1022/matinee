<?xml version="1.0" encoding="utf-8" ?>
<!-- A title in a Discover category grid: backdrop with a kind chip and a status
     chip, then the title, details and a Request or Play button. -->
<component name="RequestItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="showContent" />
    <field id="width" type="float" />
    <field id="height" type="float" />
    <field id="focusPercent" type="float" onChange="updateFocus" />
    <field id="gridHasFocus" type="boolean" onChange="updateFocus" />
  </interface>
  <script type="text/brightscript" uri="RequestItem.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <children>
    <Group id="card" />
    <Group id="below" />
  </children>
</component>
