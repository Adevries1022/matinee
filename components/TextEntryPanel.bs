' Typing on the TV: a title, the Roku keyboard and a solid button under it.
' Play on the remote submits from anywhere; Back cancels.
sub init()
    t = th()
    m.top.findNode("veil").color = t.bg
    m.layer = m.top.findNode("layer")
    m.kb = m.top.findNode("kb")
    m.titleLabel = makeTitle(m.layer, "", 48)
    m.titleLabel.translation = [0, 96]
    m.titleLabel.width = 1920
    m.titleLabel.horizAlign = "center"
    m.hintLabel = makeLabel(m.layer, "", 22, "regular", t.muted)
    m.hintLabel.translation = [260, 168]
    m.hintLabel.width = 1400
    m.hintLabel.horizAlign = "center"
    m.hintLabel.wrap = true
    tip = makeLabel(m.layer, "Press Down to reach the button, or Play to continue. Back cancels.", 20, "regular", t.faint)
    tip.translation = [0, 1010]
    tip.width = 1920
    tip.horizAlign = "center"

    m.kb.textEditBox.maxTextLength = 200
    m.onButton = false

    ' Place the keyboard in the middle and the button under it, using the
    ' keyboard's real size so the two can never overlap.
    kbW = 1100
    kbH = 480
    br = m.kb.boundingRect()
    if br <> invalid
        if br.width > 200 then kbW = br.width
        if br.height > 200 then kbH = br.height
    end if
    top = 240
    m.kb.translation = [Int((1920 - kbW) / 2), top]
    m.btnY = top + kbH + 36
    if m.btnY > 920 then m.btnY = 920
    m.btn = makeBtn(m.layer, { kind: "primary", text: m.top.buttonText, padX: 48, w: 320 })
    placeButton()
    applyLabels()
    paint()
    m.top.observeField("focusedChild", "onFocusChanged")
end sub

sub placeButton()
    m.btn.group.translation = [Int((1920 - m.btn.w) / 2), m.btnY]
end sub

sub applyLabels()
    if m.titleLabel = invalid then return
    m.titleLabel.text = m.top.title
    m.hintLabel.text = m.top.hint
    setBtnText(m.btn, m.top.buttonText)
    placeButton()
end sub

sub applyText()
    t = m.top.text
    m.kb.text = t
    m.kb.textEditBox.cursorPosition = Len(t)
end sub

sub applySecure()
    m.kb.textEditBox.secureMode = m.top.secure
end sub

sub paint()
    paintBtn(m.btn, m.onButton)
end sub

sub onFocusChanged()
    if m.top.hasFocus()
        if not m.onButton then m.kb.setFocus(true)
    end if
end sub

sub submit()
    m.top.submitted = m.kb.text
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "play"
        submit()
        return true
    else if key = "back"
        m.top.cancelled = true
        return true
    end if
    if m.onButton
        if key = "OK"
            submit()
        else if key = "up"
            m.onButton = false
            paint()
            m.kb.setFocus(true)
        end if
        return true
    end if
    if key = "down"
        m.onButton = true
        paint()
        m.top.findNode("sink").setFocus(true)
        return true
    end if
    return false
end function
