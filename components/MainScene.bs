' Owns the screen stack, the chosen server, saved sign-ins and Seerr.
sub init()
    m.bg = m.top.findNode("bg")
    m.screens = m.top.findNode("screens")
    m.stack = []
    m.graveyard = []

    di = CreateObject("roDeviceInfo")
    g = m.global
    g.addField("serverUrl", "string", false)
    g.addField("token", "string", false)
    g.addField("userId", "string", false)
    g.addField("userName", "string", false)
    g.addField("isAdmin", "boolean", false)
    g.addField("deviceId", "string", false)
    g.addField("watchVersion", "integer", false)
    g.addField("prefs", "assocarray", false)
    g.addField("theme", "assocarray", false)
    g.addField("prefsVersion", "integer", false)
    g.addField("views", "array", false)
    g.addField("previewItems", "array", false)
    g.addField("trackPrefs", "assocarray", false)
    g.addField("seerrUrl", "string", false)
    ' Set when the TV can't look up Seerr's name: Seerr's address with the
    ' Jellyfin machine's IP in place of the name. Never saved.
    g.addField("seerrVia", "string", false)
    g.addField("seerrCookie", "string", false)
    g.addField("seerrState", "string", false)
    ' The signed-in User's Seerr account id, and how many of their requests
    ' are downloading (the number on My requests in the Rail).
    g.addField("seerrUserId", "string", false)
    g.addField("requestsDownloading", "integer", false)
    ' The signed-in User's Seerr permission bits (see Requests.bs), and,
    ' for people who can approve, how many Requests from everyone wait for
    ' approval (the second number on My requests in the Rail).
    g.addField("seerrPerms", "integer", false)
    g.addField("requestsPending", "integer", false)
    ' Ready to watch: the signed-in User's Requests that arrived on the
    ' server and that they haven't played yet, newest first. Each entry is
    '   { tmdbId: integer, mediaType: "movie" | "tv", title: string,
    '     jellyfinItemId: string ("" when Seerr doesn't know it),
    '     requestedAt: Seerr's ISO date, arrivedAt: seconds since 1970,
    '     seerrMediaId: Seerr's media id (for Report a problem) }
    ' Saved per User and server (see readyKey()). An entry goes once its
    ' title (or an episode of it) is played here, or after 14 days.
    ' Replace the whole array to change it; observers see each change.
    g.addField("readyItems", "array", false)
    g.addField("servicesVersion", "integer", false)
    ' { text, icon } for the Toast; set it with showToast().
    g.addField("toast", "assocarray", true)
    ' How Continue watching is fetched: see resumePath() in Api.bs.
    g.addField("resumeVia", "string", false)
    ' True once Roku has been told the app finished launching.
    g.addField("launched", "boolean", false)
    g.observeField("launched", "onLaunched")
    m.pendingLink = invalid
    g.deviceId = di.GetChannelClientId()
    g.watchVersion = 0
    g.prefsVersion = 0
    g.seerrState = "none"
    g.requestsDownloading = 0
    g.requestsPending = 0
    g.seerrPerms = 0
    g.readyItems = []
    m.readyState = invalid
    m.readyToasts = []
    m.readyWaiting = 0
    g.views = []
    g.previewItems = []
    g.trackPrefs = {}

    ' The Toast sits above every screen.
    m.toast = m.top.CreateChild("Toast")
    g.observeField("toast", "onToast")

    m.downloadWatch = m.top.CreateChild("Timer")
    m.downloadWatch.duration = 60
    m.downloadWatch.repeat = true
    m.downloadWatch.observeField("fire", "checkDownloads")
    g.observeField("seerrState", "onSeerrStateForWatch")

    migrateV1()
    reg = CreateObject("roRegistrySection", "Marquee")
    lastId = ""
    if reg.Exists("lastUserId") then lastId = reg.Read("lastUserId")
    applyPrefs(readPrefs(lastId))
    g.observeField("prefsVersion", "onPrefsChanged")
    onPrefsChanged()

    m.offerServices = false
    if reg.Exists("server")
        g.serverUrl = reg.Read("server")
        checkServer()
    else
        showServerPicker("")
    end if
end sub

sub onToast()
    m.toast.show = m.global.toast
end sub

sub onPrefsChanged()
    m.bg.color = th().bg
    m.top.backgroundColor = th().bg
end sub

' v1 kept a single sign-in; move it into the per-User list.
sub migrateV1()
    reg = CreateObject("roRegistrySection", "Marquee")
    if reg.Exists("token") and reg.Exists("userId")
        sessions = readSessions()
        name = ""
        if reg.Exists("userName") then name = reg.Read("userName")
        sessions[reg.Read("userId")] = { token: reg.Read("token"), name: name, imageTag: "" }
        writeSessions(sessions)
        reg.Write("lastUserId", reg.Read("userId"))
        reg.Delete("token")
        reg.Delete("userId")
        reg.Delete("userName")
        reg.Delete("lastUser")
        reg.Flush()
    end if
end sub

' ---------- Start-up decisions ----------

sub checkServer()
    m.global.token = ""
    apiRequest("/Users/Public", {}, "onPublicUsers")
end sub

sub onPublicUsers(event as object)
    res = event.getData()
    if not res.ok and res.code <= 0
        ' Away from home: try the other address once.
        away = readAway(readSetting("server"))
        if away <> "" and m.global.serverUrl <> away
            print "[Matinee] server didn't answer, trying the away address"
            m.global.serverUrl = away
            checkServer()
            return
        end if
        showServerPicker("Couldn't reach your server at " + m.global.serverUrl + ". Pick it again, or choose another one.")
        return
    end if

    ' Count everyone who could be watching: listed Users plus saved sign-ins.
    everyone = {}
    if res.ok and isValid(res.data)
        if type(res.data) = "roArray"
            for each u in res.data
                everyone[safeStr(u.Id)] = true
            end for
        end if
    end if
    sessions = readSessions()
    for each id in sessions
        everyone[id] = true
    end for

    reg = CreateObject("roRegistrySection", "Marquee")
    last = ""
    if reg.Exists("lastUserId") then last = reg.Read("lastUserId")
    alwaysAsk = false
    if reg.Exists("alwaysAsk") then alwaysAsk = (reg.Read("alwaysAsk") = "true")
    ' Who's Watching appears when more than one User could be watching,
    ' or every time if an Administrator chose "Always ask".
    ' A deep link plays for the last User without asking who's watching.
    linked = (m.pendingLink <> invalid and last <> "" and sessions.DoesExist(last))
    if linked or (not alwaysAsk and last <> "" and sessions.DoesExist(last) and everyone.Count() <= 1)
        useSession(last)
    else
        showWho("")
    end if
end sub

sub useSession(id as string)
    ' Saved sign-ins are always read fresh: Who's watching can forget one.
    s = readSessions()[id]
    m.global.token = safeStr(s.token)
    m.global.userId = id
    m.global.userName = safeStr(s.name)
    apiRequest("/Users/" + id, {}, "onSessionCheck", "GET", invalid, id)
end sub

sub onSessionCheck(event as object)
    res = event.getData()
    ' Ignore the answer for someone picked earlier: it carries their Administrator status.
    if m.global.token = "" or safeStr(res.tag) <> m.global.userId then return
    if res.ok
        admin = false
        if isValid(res.data)
            if isValid(res.data.Policy) then admin = isTrue(res.data.Policy.IsAdministrator)
        end if
        startUser(admin)
    else if res.code = 401 or res.code = 403
        forgetSession(m.global.userId)
        m.global.token = ""
        showWho("That sign-in has expired. Pick your name to sign in again.")
    else
        showServerPicker("Couldn't reach your server. Make sure Jellyfin is running, then try again.")
    end if
end sub

' A User is signed in: load their Appearance, find Seerr, go home.
sub startUser(admin as boolean)
    m.global.isAdmin = admin
    m.global.trackPrefs = {}
    m.global.resumeVia = ""
    rememberLast(m.global.userId)
    applyPrefs(readPrefs(m.global.userId))
    loadReady()
    clearStack()
    showHome()
    initSeerr()
    if m.pendingLink <> invalid
        runDeepLink()
        m.offerServices = false
        return
    end if
    ' Step 3 of setup, once per server, for an Administrator who just signed in.
    if admin and m.offerServices and readSetting("servicesOffered_" + sessionsKey(), "") = ""
        writeSetting("servicesOffered_" + sessionsKey(), "true")
        s = CreateObject("roSGNode", "SettingsScreen")
        s.setup = true
        pushScreen(s)
    end if
    m.offerServices = false
end sub

sub rememberLast(id as string)
    reg = CreateObject("roRegistrySection", "Marquee")
    reg.Write("lastUserId", id)
    reg.Flush()
end sub

' ---------- Seerr ----------

sub initSeerr()
    m.global.seerrUserId = ""
    m.global.seerrPerms = 0
    m.global.seerrState = "none"
    if readSetting("seerrEnabled", "true") <> "true" then return
    reg = CreateObject("roRegistrySection", "Marquee")
    m.global.seerrCookie = ""
    cookieKey = "seerr_" + m.global.userId
    if reg.Exists(cookieKey) then m.global.seerrCookie = reg.Read(cookieKey)
    url = ""
    if reg.Exists("seerrUrl") then url = reg.Read("seerrUrl")
    if url = ""
        findSeerr()
        return
    end if
    m.global.seerrUrl = url
    seerrRequest("/status", {}, "onSeerrStatus")
end sub

' Not set up yet: Seerr doesn't announce itself, so try where it usually
' is, in order: its usual port on the Jellyfin machine, then a "seerr" name
' on the home network. Only /status is asked, with no sign-in attached. The
' first that answers is saved; if none does, the next launch tries again.
sub findSeerr()
    m.seerrGen = safeInt(m.seerrGen) + 1
    m.seerrTries = [hostBase(m.global.serverUrl) + ":5055", "http://seerr.home", "http://seerr.lan", "http://seerr.local", "http://seerr"]
    m.seerrAnswers = []
    for i = 0 to m.seerrTries.Count() - 1
        m.seerrAnswers.Push("waiting")
        startRequest(m.seerrTries[i] + "/api/v1", "/status", {}, "onSeerrProbe", "GET", invalid, { gen: m.seerrGen, index: i }, "", {})
    end for
end sub

sub onSeerrProbe(event as object)
    res = event.getData()
    tag = res.tag
    if tag = invalid or tag.gen <> m.seerrGen then return
    found = false
    if res.ok and isValid(res.data) then found = isValid(res.data.version)
    if found
        m.seerrAnswers[tag.index] = "yes"
    else
        m.seerrAnswers[tag.index] = "no"
    end if
    ' Take the first in order that answered, once those before it have failed.
    for i = 0 to m.seerrAnswers.Count() - 1
        a = m.seerrAnswers[i]
        if a = "waiting" then return
        if a = "yes"
            m.seerrGen = m.seerrGen + 1
            print "[Matinee] found Seerr at "; m.seerrTries[i]
            m.global.seerrUrl = m.seerrTries[i]
            seerrRequest("/status", {}, "onSeerrStatus")
            return
        end if
    end for
    print "[Matinee] Seerr not found on the usual addresses"
end sub

sub onSeerrStatus(event as object)
    res = event.getData()
    found = false
    if res.ok and isValid(res.data)
        found = isValid(res.data.version)
    end if
    if not found
        m.global.seerrState = "none"
        print "[Matinee] Seerr at "; m.global.seerrUrl; " didn't answer (HTTP "; res.code; ")"
        ' -6: the TV couldn't look up the name (its DNS doesn't know home
        ' names, often after the server that answers them was down). Try the
        ' Jellyfin machine's address, which usually runs the same proxy.
        seerrHost = urlHost(m.global.seerrUrl)
        jfHost = urlHost(m.global.serverUrl)
        if res.code = -6 and m.global.seerrVia = "" and not isIpHost(seerrHost) and isIpHost(jfHost)
            m.global.seerrVia = swapHost(m.global.seerrUrl, jfHost)
            print "[Matinee] trying Seerr through "; m.global.seerrVia
            seerrRequest("/status", {}, "onSeerrStatus")
            return
        end if
        if m.global.seerrVia <> "" then m.global.seerrVia = ""
        seerrRetryLater()
        return
    end if
    m.seerrRetries = 0
    reg = CreateObject("roRegistrySection", "Marquee")
    if not reg.Exists("seerrUrl")
        reg.Write("seerrUrl", m.global.seerrUrl)
        reg.Flush()
    end if
    if m.global.seerrCookie = ""
        m.global.seerrState = "signedOut"
    else
        seerrRequest("/auth/me", {}, "onSeerrMe")
    end if
end sub

' A saved Seerr that doesn't answer (the server is still starting, or was
' down) is asked again every minute, up to 10 times, so Discover and My
' requests come back without relaunching.
sub seerrRetryLater()
    m.seerrRetries = safeInt(m.seerrRetries) + 1
    if m.seerrRetries > 10 then return
    if m.seerrRetry = invalid
        m.seerrRetry = m.top.CreateChild("Timer")
        m.seerrRetry.duration = 60
        m.seerrRetry.repeat = false
        m.seerrRetry.observeField("fire", "onSeerrRetry")
    end if
    m.seerrRetry.control = "stop"
    m.seerrRetry.control = "start"
end sub

sub onSeerrRetry()
    if m.global.seerrState <> "none" or m.global.seerrUrl = "" then return
    seerrRequest("/status", {}, "onSeerrStatus")
end sub

sub onSeerrMe(event as object)
    res = event.getData()
    if res.ok
        if isValid(res.data)
            m.global.seerrUserId = safeStr(res.data.id)
            m.global.seerrPerms = safeInt(res.data.permissions)
        end if
        m.global.seerrState = "ready"
    else if res.code = 401 or res.code = 403
        forgetSeerrSession()
    else
        m.global.seerrState = "none"
    end if
end sub

sub forgetSeerrSession()
    reg = CreateObject("roRegistrySection", "Marquee")
    reg.Delete("seerr_" + m.global.userId)
    reg.Flush()
    m.global.seerrCookie = ""
    m.global.seerrUserId = ""
    m.global.seerrPerms = 0
    m.global.seerrState = "signedOut"
end sub

' ---------- Watching requests (the Rail's counts, Ready to watch) ----------

' While Seerr is ready, look at the User's Requests every minute: how many
' are downloading, which have arrived on the server, and, for people who
' can approve, how many from everyone wait for approval.
sub onSeerrStateForWatch()
    if m.global.seerrState = "ready"
        checkDownloads()
        m.downloadWatch.control = "start"
    else
        m.downloadWatch.control = "stop"
        m.global.requestsDownloading = 0
        m.global.requestsPending = 0
    end if
end sub

sub checkDownloads()
    if m.global.seerrState <> "ready" then return
    if m.global.seerrUserId = ""
        seerrRequest("/auth/me", {}, "onWatchMe")
        return
    end if
    seerrRequest("/request", { "take": "50", "skip": "0", "sort": "added", "filter": "all", "requestedBy": m.global.seerrUserId }, "onWatchRequests", "GET", invalid, m.global.userId)
    checkPending()
end sub

sub onWatchMe(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    m.global.seerrUserId = safeStr(res.data.id)
    m.global.seerrPerms = safeInt(res.data.permissions)
    checkDownloads()
end sub

sub onWatchRequests(event as object)
    res = event.getData()
    if safeStr(res.tag) <> m.global.userId then return
    if not res.ok or not isValid(res.data) then return
    results = []
    if type(res.data.results) = "roArray" then results = res.data.results
    n = 0
    for each rq in results
        md = rq.media
        if isValid(md)
            ms = safeInt(md.status)
            if safeInt(rq.status) = 2 and ms >= 1 and ms <= 3
                if seerrDownloads(md).count > 0 then n = n + 1
            end if
        end if
    end for
    if n <> m.global.requestsDownloading then print "[Matinee] requests downloading: "; n
    m.global.requestsDownloading = n
    checkReady(results)
end sub

' Everyone's Requests waiting for approval, for people who can approve.
sub checkPending()
    if not seerrCanManage(m.global.seerrPerms)
        m.global.requestsPending = 0
        return
    end if
    seerrRequest("/request", { "take": "1", "skip": "0", "filter": "pending" }, "onWatchPending", "GET", invalid, m.global.userId)
end sub

sub onWatchPending(event as object)
    res = event.getData()
    if safeStr(res.tag) <> m.global.userId then return
    if not res.ok or not isValid(res.data) then return
    n = 0
    if isValid(res.data.pageInfo) then n = safeInt(res.data.pageInfo.results)
    if n <> m.global.requestsPending then print "[Matinee] requests waiting for approval: "; n
    m.global.requestsPending = n
end sub

' ---------- Ready to watch ----------
' Each Request's progress is a score: Seerr's media status (for its
' quality) times 100, plus how many of its seasons are on the server. The
' registry keeps the highest Request id seen and the scores of Requests
' that aren't all there yet, so only a change announces anything: nothing
' already on the server the first time Matinee looks is announced.

' The registry key, per User and server.
function readyKey() as string
    return "ready_" + m.global.userId + "_" + Mid(sessionsKey(), 10)
end function

sub loadReady()
    m.readyState = invalid
    m.readyToasts = []
    m.readyWaiting = 0
    items = []
    raw = readSetting(readyKey(), "")
    if raw <> ""
        st = ParseJson(raw)
        if type(st) = "roAssociativeArray"
            m.readyState = st
            if type(st.items) = "roArray"
                for each e in st.items
                    items.Push({ tmdbId: safeInt(e.t), mediaType: safeStr(e.k), title: safeStr(e.n), jellyfinItemId: safeStr(e.j), requestedAt: safeStr(e.r), arrivedAt: safeInt(e.a), seerrMediaId: safeInt(e.s) })
                end for
            end if
        end if
    end if
    m.global.readyItems = items
    pruneReady()
end sub

' Saved with short names: the registry is small and shared by every User.
sub saveReady()
    st = m.readyState
    if st = invalid then return
    short = []
    for each it in m.global.readyItems
        short.Push({ t: it.tmdbId, k: it.mediaType, n: it.title, j: it.jellyfinItemId, r: it.requestedAt, a: it.arrivedAt, s: it.seerrMediaId })
    end for
    st.items = short
    writeSetting(readyKey(), FormatJson(st))
end sub

function nowSeconds() as integer
    return CreateObject("roDateTime").AsSeconds()
end function

' Entries go after 14 days.
sub pruneReady()
    items = m.global.readyItems
    if items = invalid then return
    cutoff = nowSeconds() - 14 * 86400
    keep = []
    for each it in items
        if it.arrivedAt >= cutoff then keep.Push(it)
    end for
    if keep.Count() <> items.Count()
        m.global.readyItems = keep
        saveReady()
    end if
end sub

function readyScore(rq as object, md as object) as integer
    is4k = isTrue(rq.is4k)
    ms = safeInt(md.status)
    if is4k then ms = safeInt(md.status4k)
    if ms = 1 or ms > 5 then ms = 0
    wanted = {}
    if type(rq.seasons) = "roArray"
        for each rs in rq.seasons
            wanted[safeInt(rs.seasonNumber).ToStr()] = true
        end for
    end if
    here = 0
    if type(md.seasons) = "roArray"
        for each ss in md.seasons
            sst = safeInt(ss.status)
            if is4k then sst = safeInt(ss.status4k)
            if sst = 5 and wanted.DoesExist(safeInt(ss.seasonNumber).ToStr()) then here = here + 1
        end for
    end if
    ' Some Seerr versions mark a requested season finished (5) instead.
    if here = 0 and type(rq.seasons) = "roArray"
        for each rs in rq.seasons
            if safeInt(rs.status) = 5 then here = here + 1
        end for
    end if
    if here > 99 then here = 99
    return ms * 100 + here
end function

' All of it is on the server, or (a series) some of the seasons it asked for.
function scoreReady(sc as integer) as boolean
    ms = sc \ 100
    if ms = 5 then return true
    return ms = 4 and (sc mod 100) > 0
end function

sub checkReady(results as object)
    st = m.readyState
    firstLook = (st = invalid)
    if firstLook then st = { maxId: 0, open: {} }
    if type(st.open) <> "roAssociativeArray" then st.open = {}
    maxId = safeInt(st.maxId)
    newMax = maxId
    newOpen = {}
    arrived = []
    for each rq in results
        md = rq.media
        id = safeInt(rq.id)
        if isValid(md) and id > 0 and safeInt(rq.status) <> 3
            if id > newMax then newMax = id
            sc = readyScore(rq, md)
            key = id.ToStr()
            old = -1
            if st.open.DoesExist(key) then old = safeInt(st.open[key])
            ' Keep watching what isn't all there yet.
            if sc < 500 then newOpen[key] = sc
            if not firstLook and scoreReady(sc)
                ' New since the last look and already here, or further along.
                if id > maxId or (old >= 0 and sc > old) then arrived.Push(rq)
            end if
        end if
    end for
    before = FormatJson({ maxId: maxId, open: st.open })
    st.maxId = newMax
    st.open = newOpen
    m.readyState = st
    if firstLook or FormatJson({ maxId: newMax, open: newOpen }) <> before then saveReady()
    pruneReady()
    for each rq in arrived
        readyArrived(rq)
    end for
end sub

' Look up the title's name, then add it and announce it.
sub readyArrived(rq as object)
    md = rq.media
    mt = safeStr(md.mediaType)
    tmdb = safeInt(md.tmdbId)
    jf = safeStr(md.jellyfinMediaId)
    if isTrue(rq.is4k) and safeStr(md.jellyfinMediaId4k) <> "" then jf = safeStr(md.jellyfinMediaId4k)
    entry = { tmdbId: tmdb, mediaType: mt, title: "", jellyfinItemId: normId(jf), requestedAt: safeStr(rq.createdAt), arrivedAt: nowSeconds(), seerrMediaId: safeInt(md.id), userId: m.global.userId }
    print "[Matinee] ready to watch: "; mt; " "; tmdb
    m.readyWaiting = m.readyWaiting + 1
    seerrRequest("/" + mt + "/" + tmdb.ToStr(), {}, "onReadyTitle", "GET", invalid, entry)
end sub

sub onReadyTitle(event as object)
    res = event.getData()
    entry = res.tag
    if entry = invalid then return
    if m.readyWaiting > 0 then m.readyWaiting = m.readyWaiting - 1
    if entry.userId <> m.global.userId then return
    entry.Delete("userId")
    if res.ok and isValid(res.data)
        d = res.data
        entry.title = safeStr(d.title)
        if entry.title = "" then entry.title = safeStr(d.name)
        if entry.jellyfinItemId = "" and isValid(d.mediaInfo) then entry.jellyfinItemId = normId(safeStr(d.mediaInfo.jellyfinMediaId))
    end if
    if entry.title = "" then entry.title = "A title you asked for"
    ' Newest first, once per title, at most 10.
    items = [entry]
    for each it in m.global.readyItems
        same = (it.tmdbId = entry.tmdbId and it.mediaType = entry.mediaType)
        if not same and items.Count() < 10 then items.Push(it)
    end for
    m.global.readyItems = items
    saveReady()
    m.readyToasts.Push(entry.title)
    if m.readyWaiting = 0 then announceReady()
end sub

' One Toast for everything that arrived, unless the Player is up: then it
' waits until the Player closes (popScreen calls this again).
sub announceReady()
    if m.readyToasts.Count() = 0 or m.readyWaiting > 0 then return
    if playerShowing() then return
    names = m.readyToasts
    m.readyToasts = []
    text = names[0] + " is ready to watch"
    if names.Count() = 2 then text = names[0] + " and " + names[1] + " are ready to watch"
    if names.Count() > 2 then text = names[0] + " and " + (names.Count() - 1).ToStr() + " more are ready to watch"
    showToast(text, "check", 4)
end sub

function playerShowing() as boolean
    if m.stack.Count() = 0 then return false
    return m.stack.Peek().subtype() = "PlayerScreen"
end function

function normId(id as string) as string
    return LCase(id).Replace("-", "")
end function

' Playing a title (or an episode of a show) takes it off Ready to watch.
sub readyPlayed(itemId as string)
    items = m.global.readyItems
    if items = invalid or itemId = "" then return
    if items.Count() = 0 then return
    if dropReady(normId(itemId)) then return
    hasShow = false
    for each it in items
        if it.mediaType = "tv" and it.jellyfinItemId <> "" then hasShow = true
    end for
    if hasShow then apiRequest("/Users/" + m.global.userId + "/Items/" + itemId, {}, "onReadyPlayedItem")
end sub

sub onReadyPlayedItem(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    dropReady(normId(safeStr(res.data.SeriesId)))
end sub

function dropReady(id as string) as boolean
    if id = "" then return false
    keep = []
    found = false
    for each it in m.global.readyItems
        if it.jellyfinItemId = id
            found = true
        else
            keep.Push(it)
        end if
    end for
    if found
        print "[Matinee] ready to watch: played "; id
        m.global.readyItems = keep
        saveReady()
    end if
    return found
end function

sub onSeerrAuthenticated(cookie as string)
    reg = CreateObject("roRegistrySection", "Marquee")
    reg.Write("seerr_" + m.global.userId, cookie)
    reg.Flush()
    m.global.seerrCookie = cookie
    m.global.seerrState = "ready"
    popScreen()
end sub

' ---------- Screens ----------

sub showServerPicker(msg as string)
    clearStack()
    s = CreateObject("roSGNode", "ServerScreen")
    s.message = msg
    pushScreen(s)
end sub

' Connect opened from inside the app: Back returns to the screen under it,
' and nothing about the current server changes until another one is chosen.
sub changeServer()
    s = CreateObject("roSGNode", "ServerScreen")
    s.canCancel = true
    pushScreen(s)
end sub

sub showWho(msg as string)
    clearStack()
    m.global.token = ""
    m.global.seerrUserId = ""
    m.global.seerrPerms = 0
    m.global.seerrState = "none"
    m.global.readyItems = []
    m.readyState = invalid
    w = CreateObject("roSGNode", "WhoScreen")
    w.message = msg
    pushScreen(w)
end sub

sub showHome()
    home = CreateObject("roSGNode", "BrowseScreen")
    pushScreen(home)
    home.begin = true
end sub

sub signOut()
    apiRequest("/Sessions/Logout", {}, "onIgnore", "POST")
    forgetSession(m.global.userId)
    m.global.token = ""
    showWho("")
end sub

sub forgetSession(id as string)
    sessions = readSessions()
    sessions.Delete(id)
    writeSessions(sessions)
end sub

sub pushScreen(s as object)
    if m.stack.Count() > 0
        m.stack.Peek().visible = false
    end if
    if s.hasField("navigate") then s.observeField("navigate", "onNavigate")
    m.screens.appendChild(s)
    m.stack.Push(s)
    s.setFocus(true)
end sub

function popScreen(refreshTop = true as boolean) as boolean
    if m.stack.Count() <= 1 then return false
    s = m.stack.Pop()
    stopListening(s)
    if s.hasField("closed") then s.closed = true
    s.visible = false
    m.screens.removeChild(s)
    ' Keep recently closed screens alive briefly so their final
    ' network reports (like "playback stopped") can finish.
    m.graveyard.Push(s)
    if m.graveyard.Count() > 3 then m.graveyard.Shift()
    top = m.stack.Peek()
    top.visible = true
    if refreshTop
        top.setFocus(true)
        if top.hasField("refresh") then top.refresh = true
    end if
    ' Ready to watch Toasts wait while the Player is up.
    announceReady()
    return true
end function

sub popTo(depth as integer)
    while m.stack.Count() > depth
        popScreen(false)
    end while
    top = m.stack.Peek()
    if top <> invalid
        top.setFocus(true)
        if top.hasField("refresh") then top.refresh = true
    end if
end sub

sub clearStack()
    while m.stack.Count() > 0
        s = m.stack.Pop()
        stopListening(s)
        if s.hasField("closed") then s.closed = true
        s.visible = false
        m.screens.removeChild(s)
        m.graveyard.Push(s)
        if m.graveyard.Count() > 3 then m.graveyard.Shift()
    end while
end sub

' A closed screen's late network answer must not move the app.
sub stopListening(s as object)
    if s.hasField("navigate") then s.unobserveField("navigate")
end sub

sub onNavigate(event as object)
    navigateTo(event.getData())
end sub

sub navigateTo(nav as dynamic)
    if nav = invalid then return
    a = nav.action
    if a = "details"
        d = CreateObject("roSGNode", "DetailsScreen")
        if isValid(nav.seasonId) then d.seasonId = nav.seasonId
        d.backLabel = screenLabel(m.stack.Peek())
        pushScreen(d)
        d.itemId = nav.itemId
    else if a = "play"
        readyPlayed(safeStr(nav.itemId))
        p = CreateObject("roSGNode", "PlayerScreen")
        pushScreen(p)
        p.playItem = { itemId: nav.itemId, startSeconds: nav.startSeconds }
    else if a = "search"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "SearchScreen"))
    else if a = "discover"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "DiscoverScreen"))
    else if a = "requestDetails"
        rd = CreateObject("roSGNode", "RequestDetailsScreen")
        rd.backLabel = screenLabel(m.stack.Peek())
        if isValid(nav.card) then rd.card = nav.card
        pushScreen(rd)
        rd.media = { tmdbId: nav.tmdbId, mediaType: nav.mediaType }
    else if a = "discoverCategory"
        dg = CreateObject("roSGNode", "DiscoverCategoryScreen")
        dg.backLabel = screenLabel(m.stack.Peek())
        pushScreen(dg)
        dg.category = nav.category
    else if a = "myrequests"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "MyRequestsScreen"))
    else if a = "activity"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "ActivityScreen"))
    else if a = "mylist"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "MyListScreen"))
    else if a = "series" or a = "movies"
        popTo(1)
        b = CreateObject("roSGNode", "BrowseScreen")
        b.library = { kind: a }
        pushScreen(b)
        b.begin = true
    else if a = "settings"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "SettingsScreen"))
    else if a = "themes"
        pushScreen(CreateObject("roSGNode", "ThemesScreen"))
    else if a = "seerrSignIn"
        si = CreateObject("roSGNode", "SignInScreen")
        si.mode = "seerr"
        pushScreen(si)
        si.user = { id: m.global.userId, name: m.global.userName, imageTag: "", hasPassword: true }
    else if a = "seerrAuthenticated"
        onSeerrAuthenticated(nav.cookie)
    else if a = "seerrSignedOut"
        forgetSeerrSession()
    else if a = "seerrChanged"
        initSeerr()
    else if a = "rebuildHome"
        clearStack()
        showHome()
    else if a = "home"
        popTo(1)
    else if a = "back"
        popScreen()
    else if a = "signout"
        signOut()
    else if a = "switchUser"
        ' Over the current screen, so Back keeps the User signed in.
        pushScreen(CreateObject("roSGNode", "WhoScreen"))
    else if a = "changeServer"
        changeServer()
    else if a = "serverChosen"
        onServerChosen(nav)
    else if a = "userChosen"
        onUserChosen(nav.user)
    else if a = "quickConnected"
        onQuickConnected(nav)
    else if a = "authenticated"
        onAuthenticated(nav)
    end if
end sub

' The name on a back pill that returns to this screen.
function screenLabel(s as object) as string
    if s = invalid then return "Back"
    kind = s.subtype()
    if kind = "BrowseScreen"
        lib = s.library
        if lib <> invalid
            if lib.kind = "series" then return "Series"
            if lib.kind = "movies" then return "Movies"
        end if
        return "Home"
    end if
    if kind = "SearchScreen" then return "Search"
    if kind = "MyListScreen" then return "My List"
    if kind = "DiscoverScreen" then return "Discover"
    if kind = "MyRequestsScreen" then return "My requests"
    if kind = "DiscoverCategoryScreen" then return safeStr(s.category.name)
    if kind = "DetailsScreen" or kind = "RequestDetailsScreen" then return "Back"
    return "Back"
end function

sub onServerChosen(nav as object)
    ' Close everything while the old server is still current, so last reports
    ' (like "playback stopped") go to it and Back can't return to its screens.
    clearStack()
    saveServer(nav)
    checkServer()
end sub

' Remember the chosen server. Sign-ins are kept per server; Seerr is
' looked for again on the new one.
sub saveServer(nav as object)
    reg = CreateObject("roRegistrySection", "Marquee")
    previous = ""
    if reg.Exists("server") then previous = reg.Read("server")
    if previous <> nav.url
        reg.Delete("lastUserId")
        reg.Delete("seerrUrl")
    end if
    reg.Write("server", nav.url)
    reg.Write("serverName", safeStr(nav.name))
    reg.Flush()
    m.global.serverUrl = nav.url
    if isValid(nav.away) then writeAway(nav.url, nav.away)
end sub

sub onUserChosen(u as object)
    id = safeStr(u.id)
    ' Picked themself from the avatar: go back to where they were.
    if id <> "" and id = m.global.userId and m.global.token <> "" and m.stack.Count() > 1
        popScreen()
        return
    end if
    if id <> "" then applyPrefs(readPrefs(id))
    if id <> "" and readSessions().DoesExist(id)
        useSession(id)
        return
    end if
    s = CreateObject("roSGNode", "SignInScreen")
    pushScreen(s)
    s.user = u
end sub

sub onQuickConnected(nav as object)
    clearStack()
    saveServer(nav)
    onAuthenticated(nav)
end sub

sub onAuthenticated(nav as object)
    m.offerServices = true
    sessions = readSessions()
    sessions[nav.userId] = { token: nav.token, name: nav.userName, imageTag: safeStr(nav.imageTag) }
    writeSessions(sessions)
    m.global.token = nav.token
    m.global.userId = nav.userId
    m.global.userName = nav.userName
    startUser(isTrue(nav.isAdmin))
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if press and key = "back" then return popScreen()
    return false
end function

' ---------- Deep links ----------
' From Roku Search, voice or the Deep Linking Tester. The contentId is a
' Jellyfin item id. Movies and episodes play from where the User stopped,
' a series plays its next episode, a season opens on Details, and
' anything else lands on Home with a Toast.

sub onDeepLink()
    a = m.top.deepLink
    if a = invalid then return
    if not isValid(a.contentId) or not isValid(a.mediaType) then return
    id = LCase(safeStr(a.contentId)).Replace("-", "")
    m.pendingLink = { id: id, kind: LCase(safeStr(a.mediaType)) }
    print "[Matinee] deep link: "; m.pendingLink.kind; " "; id
    ' Not signed in yet: startUser() picks it up.
    if m.global.token <> "" and m.global.userId <> "" and m.stack.Count() > 0 then runDeepLink()
end sub

sub runDeepLink()
    link = m.pendingLink
    m.pendingLink = invalid
    if link = invalid then return
    popTo(1)
    rx = CreateObject("roRegex", "^[0-9a-f]{32}$", "")
    known = { movie: true, episode: true, series: true, season: true, tvspecial: true, shortformvideo: true }
    if not rx.IsMatch(link.id) or not known.DoesExist(link.kind)
        deepLinkFailed()
        return
    end if
    apiRequest("/Users/" + m.global.userId + "/Items/" + link.id, {}, "onDeepLinkItem", "GET", invalid, link.kind)
end sub

sub onDeepLinkItem(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data)
        deepLinkFailed()
        return
    end if
    item = res.data
    kind = safeStr(item.Type)
    if kind = "Series"
        playNextUp(safeStr(item.Id))
    else if kind = "Season"
        navigateTo({ action: "details", itemId: safeStr(item.SeriesId), seasonId: safeStr(item.Id) })
    else if kind = "Movie" or kind = "Episode" or kind = "Video" or kind = "MusicVideo"
        playFromBookmark(item)
    else
        deepLinkFailed()
    end if
end sub

' The series' next episode: the one in progress, or the one after the last
' watched. A series nobody has started plays from its first episode.
sub playNextUp(seriesId as string)
    q = { seriesId: seriesId, userId: m.global.userId, limit: "1", enableResumable: "true", fields: "UserData" }
    apiRequest("/Shows/NextUp", q, "onDeepLinkNextUp", "GET", invalid, seriesId)
end sub

sub onDeepLinkNextUp(event as object)
    res = event.getData()
    ep = firstItem(res)
    if ep <> invalid
        playFromBookmark(ep)
        return
    end if
    q = { userId: m.global.userId, fields: "UserData", limit: "20" }
    apiRequest("/Shows/" + safeStr(res.tag) + "/Episodes", q, "onDeepLinkEpisodes")
end sub

sub onDeepLinkEpisodes(event as object)
    res = event.getData()
    first = invalid
    if res.ok and isValid(res.data) and isValid(res.data.Items)
        ' Skip Specials (season 0) when the series has regular episodes.
        for each ep in res.data.Items
            if first = invalid then first = ep
            if safeInt(ep.ParentIndexNumber) > 0
                first = ep
                exit for
            end if
        end for
    end if
    if first = invalid
        deepLinkFailed()
        return
    end if
    playFromBookmark(first)
end sub

function firstItem(res as object) as dynamic
    if not res.ok or not isValid(res.data) then return invalid
    if not isValid(res.data.Items) then return invalid
    if res.data.Items.Count() = 0 then return invalid
    return res.data.Items[0]
end function

sub playFromBookmark(item as object)
    secs = 0
    if isValid(item.UserData) then secs = ticksToSeconds(item.UserData.PlaybackPositionTicks)
    navigateTo({ action: "play", itemId: safeStr(item.Id), startSeconds: secs })
end sub

sub deepLinkFailed()
    print "[Matinee] deep link: not found"
    showToast("Couldn't find that title on your server", "info")
end sub

sub onLaunched()
    if not m.global.launched then return
    m.top.signalBeacon("AppLaunchComplete")
    print "[Matinee] launch complete"
end sub
