' Owns the screen stack, the chosen server, saved sign-ins and Seerr.
sub init()
    m.bg = m.top.findNode("bg")
    m.screens = m.top.findNode("screens")
    m.stack = []
    m.graveyard = []

    di = CreateObject("roDeviceInfo")
    g = m.global
    g.addField("serverUrl", "string", false)
    g.addField("token", "string", false)
    g.addField("userId", "string", false)
    g.addField("userName", "string", false)
    g.addField("isAdmin", "boolean", false)
    g.addField("deviceId", "string", false)
    g.addField("watchVersion", "integer", false)
    g.addField("prefs", "assocarray", false)
    g.addField("theme", "assocarray", false)
    g.addField("prefsVersion", "integer", false)
    g.addField("views", "array", false)
    g.addField("previewItems", "array", false)
    g.addField("trackPrefs", "assocarray", false)
    g.addField("seerrUrl", "string", false)
    g.addField("seerrCookie", "string", false)
    g.addField("seerrState", "string", false)
    ' The signed-in User's Seerr account id, and how many of their requests
    ' are downloading (the number on My requests in the Rail).
    g.addField("seerrUserId", "string", false)
    g.addField("requestsDownloading", "integer", false)
    g.addField("servicesVersion", "integer", false)
    g.deviceId = di.GetChannelClientId()
    g.watchVersion = 0
    g.prefsVersion = 0
    g.seerrState = "none"
    g.requestsDownloading = 0
    g.views = []
    g.previewItems = []
    g.trackPrefs = {}

    m.downloadWatch = m.top.CreateChild("Timer")
    m.downloadWatch.duration = 60
    m.downloadWatch.repeat = true
    m.downloadWatch.observeField("fire", "checkDownloads")
    g.observeField("seerrState", "onSeerrStateForWatch")

    migrateV1()
    reg = CreateObject("roRegistrySection", "Marquee")
    lastId = ""
    if reg.Exists("lastUserId") then lastId = reg.Read("lastUserId")
    applyPrefs(readPrefs(lastId))
    g.observeField("prefsVersion", "onPrefsChanged")
    onPrefsChanged()

    m.offerServices = false
    if reg.Exists("server")
        g.serverUrl = reg.Read("server")
        checkServer()
    else
        showServerPicker("")
    end if
end sub

sub onPrefsChanged()
    m.bg.color = th().bg
    m.top.backgroundColor = th().bg
end sub

' v1 kept a single sign-in; move it into the per-User list.
sub migrateV1()
    reg = CreateObject("roRegistrySection", "Marquee")
    if reg.Exists("token") and reg.Exists("userId")
        sessions = readSessions()
        name = ""
        if reg.Exists("userName") then name = reg.Read("userName")
        sessions[reg.Read("userId")] = { token: reg.Read("token"), name: name, imageTag: "" }
        writeSessions(sessions)
        reg.Write("lastUserId", reg.Read("userId"))
        reg.Delete("token")
        reg.Delete("userId")
        reg.Delete("userName")
        reg.Delete("lastUser")
        reg.Flush()
    end if
end sub

' ---------- Start-up decisions ----------

sub checkServer()
    m.global.token = ""
    apiRequest("/Users/Public", {}, "onPublicUsers")
end sub

sub onPublicUsers(event as object)
    res = event.getData()
    if not res.ok and res.code <= 0
        ' Away from home: try the other address once.
        away = readAway(readSetting("server"))
        if away <> "" and m.global.serverUrl <> away
            print "[Matinee] server didn't answer, trying the away address"
            m.global.serverUrl = away
            checkServer()
            return
        end if
        showServerPicker("Couldn't reach your server at " + m.global.serverUrl + ". Pick it again, or choose another one.")
        return
    end if

    ' Count everyone who could be watching: listed Users plus saved sign-ins.
    everyone = {}
    if res.ok and isValid(res.data)
        if type(res.data) = "roArray"
            for each u in res.data
                everyone[safeStr(u.Id)] = true
            end for
        end if
    end if
    sessions = readSessions()
    for each id in sessions
        everyone[id] = true
    end for

    reg = CreateObject("roRegistrySection", "Marquee")
    last = ""
    if reg.Exists("lastUserId") then last = reg.Read("lastUserId")
    alwaysAsk = false
    if reg.Exists("alwaysAsk") then alwaysAsk = (reg.Read("alwaysAsk") = "true")
    ' Who's Watching appears when more than one User could be watching,
    ' or every time if an Administrator chose "Always ask".
    if not alwaysAsk and last <> "" and sessions.DoesExist(last) and everyone.Count() <= 1
        useSession(last)
    else
        showWho("")
    end if
end sub

sub useSession(id as string)
    ' Saved sign-ins are always read fresh: Who's watching can forget one.
    s = readSessions()[id]
    m.global.token = safeStr(s.token)
    m.global.userId = id
    m.global.userName = safeStr(s.name)
    apiRequest("/Users/" + id, {}, "onSessionCheck", "GET", invalid, id)
end sub

sub onSessionCheck(event as object)
    res = event.getData()
    ' Ignore the answer for someone picked earlier: it carries their Administrator status.
    if m.global.token = "" or safeStr(res.tag) <> m.global.userId then return
    if res.ok
        admin = false
        if isValid(res.data)
            if isValid(res.data.Policy) then admin = isTrue(res.data.Policy.IsAdministrator)
        end if
        startUser(admin)
    else if res.code = 401 or res.code = 403
        forgetSession(m.global.userId)
        m.global.token = ""
        showWho("That sign-in has expired. Pick your name to sign in again.")
    else
        showServerPicker("Couldn't reach your server. Make sure Jellyfin is running, then try again.")
    end if
end sub

' A User is signed in: load their Appearance, find Seerr, go home.
sub startUser(admin as boolean)
    m.global.isAdmin = admin
    m.global.trackPrefs = {}
    rememberLast(m.global.userId)
    applyPrefs(readPrefs(m.global.userId))
    clearStack()
    showHome()
    initSeerr()
    ' Step 3 of setup, once per server, for an Administrator who just signed in.
    if admin and m.offerServices and readSetting("servicesOffered_" + sessionsKey(), "") = ""
        writeSetting("servicesOffered_" + sessionsKey(), "true")
        s = CreateObject("roSGNode", "SettingsScreen")
        s.setup = true
        pushScreen(s)
    end if
    m.offerServices = false
end sub

sub rememberLast(id as string)
    reg = CreateObject("roRegistrySection", "Marquee")
    reg.Write("lastUserId", id)
    reg.Flush()
end sub

' ---------- Seerr ----------

sub initSeerr()
    m.global.seerrUserId = ""
    m.global.seerrState = "none"
    if readSetting("seerrEnabled", "true") <> "true" then return
    reg = CreateObject("roRegistrySection", "Marquee")
    m.global.seerrCookie = ""
    cookieKey = "seerr_" + m.global.userId
    if reg.Exists(cookieKey) then m.global.seerrCookie = reg.Read(cookieKey)
    url = ""
    if reg.Exists("seerrUrl") then url = reg.Read("seerrUrl")
    if url = ""
        findSeerr()
        return
    end if
    m.global.seerrUrl = url
    seerrRequest("/status", {}, "onSeerrStatus")
end sub

' Not set up yet: Seerr doesn't announce itself, so try where it usually
' is, in order: its usual port on the Jellyfin machine, then a "seerr" name
' on the home network. Only /status is asked, with no sign-in attached. The
' first that answers is saved; if none does, the next launch tries again.
sub findSeerr()
    m.seerrGen = safeInt(m.seerrGen) + 1
    m.seerrTries = [hostBase(m.global.serverUrl) + ":5055", "http://seerr.home", "http://seerr.lan", "http://seerr.local", "http://seerr"]
    m.seerrAnswers = []
    for i = 0 to m.seerrTries.Count() - 1
        m.seerrAnswers.Push("waiting")
        startRequest(m.seerrTries[i] + "/api/v1", "/status", {}, "onSeerrProbe", "GET", invalid, { gen: m.seerrGen, index: i }, "", {})
    end for
end sub

sub onSeerrProbe(event as object)
    res = event.getData()
    tag = res.tag
    if tag = invalid or tag.gen <> m.seerrGen then return
    found = false
    if res.ok and isValid(res.data) then found = isValid(res.data.version)
    if found
        m.seerrAnswers[tag.index] = "yes"
    else
        m.seerrAnswers[tag.index] = "no"
    end if
    ' Take the first in order that answered, once those before it have failed.
    for i = 0 to m.seerrAnswers.Count() - 1
        a = m.seerrAnswers[i]
        if a = "waiting" then return
        if a = "yes"
            m.seerrGen = m.seerrGen + 1
            print "[Matinee] found Seerr at "; m.seerrTries[i]
            m.global.seerrUrl = m.seerrTries[i]
            seerrRequest("/status", {}, "onSeerrStatus")
            return
        end if
    end for
    print "[Matinee] Seerr not found on the usual addresses"
end sub

sub onSeerrStatus(event as object)
    res = event.getData()
    found = false
    if res.ok and isValid(res.data)
        found = isValid(res.data.version)
    end if
    if not found
        m.global.seerrState = "none"
        return
    end if
    reg = CreateObject("roRegistrySection", "Marquee")
    if not reg.Exists("seerrUrl")
        reg.Write("seerrUrl", m.global.seerrUrl)
        reg.Flush()
    end if
    if m.global.seerrCookie = ""
        m.global.seerrState = "signedOut"
    else
        seerrRequest("/auth/me", {}, "onSeerrMe")
    end if
end sub

sub onSeerrMe(event as object)
    res = event.getData()
    if res.ok
        if isValid(res.data) then m.global.seerrUserId = safeStr(res.data.id)
        m.global.seerrState = "ready"
    else if res.code = 401 or res.code = 403
        forgetSeerrSession()
    else
        m.global.seerrState = "none"
    end if
end sub

sub forgetSeerrSession()
    reg = CreateObject("roRegistrySection", "Marquee")
    reg.Delete("seerr_" + m.global.userId)
    reg.Flush()
    m.global.seerrCookie = ""
    m.global.seerrUserId = ""
    m.global.seerrState = "signedOut"
end sub

' ---------- Downloading requests (the Rail's count) ----------

' While Seerr is ready, count the User's downloading requests every minute.
sub onSeerrStateForWatch()
    if m.global.seerrState = "ready"
        checkDownloads()
        m.downloadWatch.control = "start"
    else
        m.downloadWatch.control = "stop"
        m.global.requestsDownloading = 0
    end if
end sub

sub checkDownloads()
    if m.global.seerrState <> "ready" then return
    if m.global.seerrUserId = ""
        seerrRequest("/auth/me", {}, "onWatchMe")
        return
    end if
    seerrRequest("/request", { "take": "40", "skip": "0", "sort": "added", "filter": "processing", "requestedBy": m.global.seerrUserId }, "onWatchRequests")
end sub

sub onWatchMe(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    m.global.seerrUserId = safeStr(res.data.id)
    checkDownloads()
end sub

sub onWatchRequests(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    n = 0
    if isValid(res.data.results)
        for each rq in res.data.results
            if isValid(rq.media)
                if seerrDownloads(rq.media).count > 0 then n = n + 1
            end if
        end for
    end if
    if n <> m.global.requestsDownloading then print "[Matinee] requests downloading: "; n
    m.global.requestsDownloading = n
end sub

sub onSeerrAuthenticated(cookie as string)
    reg = CreateObject("roRegistrySection", "Marquee")
    reg.Write("seerr_" + m.global.userId, cookie)
    reg.Flush()
    m.global.seerrCookie = cookie
    m.global.seerrState = "ready"
    popScreen()
end sub

' ---------- Screens ----------

sub showServerPicker(msg as string)
    clearStack()
    s = CreateObject("roSGNode", "ServerScreen")
    s.message = msg
    pushScreen(s)
end sub

' Connect opened from inside the app: Back returns to the screen under it,
' and nothing about the current server changes until another one is chosen.
sub changeServer()
    s = CreateObject("roSGNode", "ServerScreen")
    s.canCancel = true
    pushScreen(s)
end sub

sub showWho(msg as string)
    clearStack()
    m.global.token = ""
    m.global.seerrUserId = ""
    m.global.seerrState = "none"
    w = CreateObject("roSGNode", "WhoScreen")
    w.message = msg
    pushScreen(w)
end sub

sub showHome()
    home = CreateObject("roSGNode", "BrowseScreen")
    pushScreen(home)
    home.begin = true
end sub

sub signOut()
    apiRequest("/Sessions/Logout", {}, "onIgnore", "POST")
    forgetSession(m.global.userId)
    m.global.token = ""
    showWho("")
end sub

sub forgetSession(id as string)
    sessions = readSessions()
    sessions.Delete(id)
    writeSessions(sessions)
end sub

sub pushScreen(s as object)
    if m.stack.Count() > 0
        m.stack.Peek().visible = false
    end if
    if s.hasField("navigate") then s.observeField("navigate", "onNavigate")
    m.screens.appendChild(s)
    m.stack.Push(s)
    s.setFocus(true)
end sub

function popScreen(refreshTop = true as boolean) as boolean
    if m.stack.Count() <= 1 then return false
    s = m.stack.Pop()
    stopListening(s)
    if s.hasField("closed") then s.closed = true
    s.visible = false
    m.screens.removeChild(s)
    ' Keep recently closed screens alive briefly so their final
    ' network reports (like "playback stopped") can finish.
    m.graveyard.Push(s)
    if m.graveyard.Count() > 3 then m.graveyard.Shift()
    top = m.stack.Peek()
    top.visible = true
    if refreshTop
        top.setFocus(true)
        if top.hasField("refresh") then top.refresh = true
    end if
    return true
end function

sub popTo(depth as integer)
    while m.stack.Count() > depth
        popScreen(false)
    end while
    top = m.stack.Peek()
    if top <> invalid
        top.setFocus(true)
        if top.hasField("refresh") then top.refresh = true
    end if
end sub

sub clearStack()
    while m.stack.Count() > 0
        s = m.stack.Pop()
        stopListening(s)
        if s.hasField("closed") then s.closed = true
        s.visible = false
        m.screens.removeChild(s)
        m.graveyard.Push(s)
        if m.graveyard.Count() > 3 then m.graveyard.Shift()
    end while
end sub

' A closed screen's late network answer must not move the app.
sub stopListening(s as object)
    if s.hasField("navigate") then s.unobserveField("navigate")
end sub

sub onNavigate(event as object)
    nav = event.getData()
    if nav = invalid then return
    a = nav.action
    if a = "details"
        d = CreateObject("roSGNode", "DetailsScreen")
        if isValid(nav.seasonId) then d.seasonId = nav.seasonId
        d.backLabel = screenLabel(m.stack.Peek())
        pushScreen(d)
        d.itemId = nav.itemId
    else if a = "play"
        p = CreateObject("roSGNode", "PlayerScreen")
        pushScreen(p)
        p.playItem = { itemId: nav.itemId, startSeconds: nav.startSeconds }
    else if a = "search"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "SearchScreen"))
    else if a = "discover"
        popTo(1)
        ds = CreateObject("roSGNode", "DiscoverScreen")
        pushScreen(ds)
        if isValid(nav.tmdbId) then ds.open = { tmdbId: nav.tmdbId, mediaType: nav.mediaType }
    else if a = "discoverCategory"
        dg = CreateObject("roSGNode", "DiscoverGridScreen")
        dg.backLabel = screenLabel(m.stack.Peek())
        pushScreen(dg)
        dg.category = nav.category
    else if a = "myrequests"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "MyRequestsScreen"))
    else if a = "activity"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "ActivityScreen"))
    else if a = "mylist"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "MyListScreen"))
    else if a = "series" or a = "movies"
        popTo(1)
        b = CreateObject("roSGNode", "BrowseScreen")
        b.library = { kind: a }
        pushScreen(b)
        b.begin = true
    else if a = "settings"
        popTo(1)
        pushScreen(CreateObject("roSGNode", "SettingsScreen"))
    else if a = "themes"
        pushScreen(CreateObject("roSGNode", "ThemesScreen"))
    else if a = "seerrSignIn"
        si = CreateObject("roSGNode", "SignInScreen")
        si.mode = "seerr"
        pushScreen(si)
        si.user = { id: m.global.userId, name: m.global.userName, imageTag: "", hasPassword: true }
    else if a = "seerrAuthenticated"
        onSeerrAuthenticated(nav.cookie)
    else if a = "seerrSignedOut"
        forgetSeerrSession()
    else if a = "seerrChanged"
        initSeerr()
    else if a = "rebuildHome"
        clearStack()
        showHome()
    else if a = "home"
        popTo(1)
    else if a = "back"
        popScreen()
    else if a = "signout"
        signOut()
    else if a = "switchUser"
        showWho("")
    else if a = "changeServer"
        changeServer()
    else if a = "serverChosen"
        onServerChosen(nav)
    else if a = "userChosen"
        onUserChosen(nav.user)
    else if a = "quickConnected"
        onQuickConnected(nav)
    else if a = "authenticated"
        onAuthenticated(nav)
    end if
end sub

' The name on a back pill that returns to this screen.
function screenLabel(s as object) as string
    if s = invalid then return "Back"
    kind = s.subtype()
    if kind = "BrowseScreen"
        lib = s.library
        if lib <> invalid
            if lib.kind = "series" then return "Series"
            if lib.kind = "movies" then return "Movies"
        end if
        return "Home"
    end if
    if kind = "SearchScreen" then return "Search"
    if kind = "MyListScreen" then return "My List"
    if kind = "DiscoverScreen" then return "Discover"
    if kind = "MyRequestsScreen" then return "My requests"
    return "Back"
end function

sub onServerChosen(nav as object)
    ' Close everything while the old server is still current, so last reports
    ' (like "playback stopped") go to it and Back can't return to its screens.
    clearStack()
    saveServer(nav)
    checkServer()
end sub

' Remember the chosen server. Sign-ins are kept per server; Seerr is
' looked for again on the new one.
sub saveServer(nav as object)
    reg = CreateObject("roRegistrySection", "Marquee")
    previous = ""
    if reg.Exists("server") then previous = reg.Read("server")
    if previous <> nav.url
        reg.Delete("lastUserId")
        reg.Delete("seerrUrl")
    end if
    reg.Write("server", nav.url)
    reg.Write("serverName", safeStr(nav.name))
    reg.Flush()
    m.global.serverUrl = nav.url
    if isValid(nav.away) then writeAway(nav.url, nav.away)
end sub

sub onUserChosen(u as object)
    id = safeStr(u.id)
    if id <> "" then applyPrefs(readPrefs(id))
    if id <> "" and readSessions().DoesExist(id)
        useSession(id)
        return
    end if
    s = CreateObject("roSGNode", "SignInScreen")
    pushScreen(s)
    s.user = u
end sub

sub onQuickConnected(nav as object)
    clearStack()
    saveServer(nav)
    onAuthenticated(nav)
end sub

sub onAuthenticated(nav as object)
    m.offerServices = true
    sessions = readSessions()
    sessions[nav.userId] = { token: nav.token, name: nav.userName, imageTag: safeStr(nav.imageTag) }
    writeSessions(sessions)
    m.global.token = nav.token
    m.global.userId = nav.userId
    m.global.userName = nav.userName
    startUser(isTrue(nav.isAdmin))
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if press and key = "back" then return popScreen()
    return false
end function
