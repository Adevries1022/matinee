sub init()
    m.card = m.top.findNode("card")
    m.ring = m.top.findNode("ring")
    m.placeholder = m.top.findNode("placeholder")
    m.fallback = m.top.findNode("fallback")
    m.poster = m.top.findNode("poster")
    m.shade = m.top.findNode("shade")
    m.caption = m.top.findNode("caption")
    m.captionSub = m.top.findNode("captionSub")
    m.trackBg = m.top.findNode("trackBg")
    m.track = m.top.findNode("track")
    m.corners = m.top.findNode("corners")
    m.badge = m.top.findNode("badge")
    m.badgeBg = m.top.findNode("badgeBg")
    m.badgeText = m.top.findNode("badgeText")
    m.fadeIn = m.top.findNode("fadeIn")
    m.below = m.top.findNode("below")
    m.remove = m.top.findNode("remove")
    m.removable = false
    m.belowTitle = m.top.findNode("belowTitle")
    m.belowText = m.top.findNode("belowText")
    m.poster.observeField("loadStatus", "onPosterStatus")

    t = th()
    ' Read once: these are used on every focus step.
    m.focusScale = t.focusScale
    m.padX = t.cellPadX
    m.padY = t.cellPadY
    m.w = 0
    m.h = 0
    m.placeholder.uri = "pkg:/images/fill_r14.9.png"
    m.placeholder.blendColor = t.raised
    m.fallback.font = makeFont(22, "display")
    m.fallback.color = t.muted
    m.caption.font = makeFont(24, "display")
    m.caption.color = t.text
    m.captionSub.font = makeFont(16)
    m.captionSub.color = t.meta
    m.shade.blendColor = t.black
    m.trackBg.color = t.trackOver
    m.track.color = t.accent
    m.ring.uri = "pkg:/images/ring_r18_w4.9.png"
    m.ring.blendColor = t.accent
    ' Covers the artwork's square corners in the background color.
    m.corners.uri = "pkg:/images/corners_r14.9.png"
    m.corners.blendColor = t.bg
    m.badgeBg.uri = "pkg:/images/fill_r8.9.png"
    m.badgeBg.blendColor = t.black
    m.badgeBg.opacity = 0.6
    m.badgeText.font = makeFont(16, "semibold")
    m.badgeText.color = t.text
    removeBg = m.top.findNode("removeBg")
    removeBg.blendColor = t.black
    removeBg.opacity = 0.6
    m.top.findNode("removeIcon").blendColor = t.text
    m.belowTitle.font = makeFont(22, "semibold")
    m.belowTitle.color = t.text
    m.belowText.font = makeFont(18)
    m.belowText.color = t.muted
end sub

sub showContent()
    c = m.top.itemContent
    if c = invalid then return
    ' Only MediaContent has a Card size. Some firmware hands a grid's section
    ' node to its item component; draw nothing rather than crash on it.
    if c.cardW = invalid or c.cardH = invalid
        m.card.visible = false
        m.ring.visible = false
        m.w = 0
        m.h = 0
        return
    end if
    m.card.visible = true
    m.ring.visible = true
    if m.poster.uri = c.HDPosterUrl and m.poster.loadStatus = "ready"
        m.poster.opacity = 1
    else
        m.fadeIn.control = "stop"
        m.poster.opacity = 0
        m.poster.uri = c.HDPosterUrl
    end if
    m.fallback.text = c.heading
    m.caption.text = c.heading
    m.captionSub.text = c.subtitle
    m.badgeText.text = c.badge
    m.belowTitle.text = c.heading
    m.belowText.text = c.description
    layout()
end sub

sub onPosterStatus()
    if m.poster.loadStatus = "ready" then m.fadeIn.control = "start"
end sub

sub layout()
    c = m.top.itemContent
    if c = invalid then return
    w = c.cardW
    h = c.cardH
    if w = invalid or h = invalid or w = 0 or h = 0 then return
    m.card.translation = [m.padX, m.padY]
    m.w = w
    m.h = h
    m.placeholder.width = w
    m.placeholder.height = h
    m.poster.width = w
    m.poster.height = h
    m.poster.loadWidth = w
    m.poster.loadHeight = h
    m.corners.width = w
    m.corners.height = h
    m.fallback.translation = [16, 0]
    m.fallback.width = w - 32
    m.fallback.height = h

    landscape = w > h
    m.below.visible = c.textBelow
    if c.textBelow
        m.below.translation = [m.padX, m.padY + h + 14]
        m.belowTitle.width = w
        m.belowTitle.height = 30
        m.belowText.translation = [0, 40]
        m.belowText.width = w
    end if
    showCap = landscape and c.heading <> "" and not c.textBelow
    ' Episode Cards show watched episodes as a full bar, like the board.
    fullBar = c.textBelow and c.played
    showTrack = (c.progress > 0.01 and c.progress < 0.97) or fullBar
    showSub = showCap and c.subtitle <> ""

    ' The title at the bottom left with the episode or time left under it,
    ' and the progress bar below both.
    bottom = h - 18
    if showTrack then bottom = h - 34
    if showSub
        m.captionSub.translation = [20, bottom - 20]
        m.captionSub.width = w - 40
        m.captionSub.height = 20
        bottom = bottom - 24
    end if
    m.caption.translation = [20, bottom - 30]
    m.caption.width = w - 40
    m.caption.height = 30
    m.shade.visible = showCap or showTrack
    m.caption.visible = showCap
    m.captionSub.visible = showSub
    shadeH = 100
    if showSub then shadeH = 110
    m.shade.translation = [0, h - shadeH]
    m.shade.width = w
    m.shade.height = shadeH
    m.shade.opacity = 0.78

    m.trackBg.visible = showTrack
    m.track.visible = showTrack
    m.trackBg.translation = [20, h - 23]
    m.trackBg.width = w - 40
    m.trackBg.height = 5
    m.track.translation = [20, h - 23]
    m.track.height = 5
    if fullBar
        m.track.width = w - 40
    else if showTrack
        m.track.width = (w - 40) * c.progress
    end if

    m.removable = c.removable
    m.remove.translation = [w - 60, 12]

    hasBadge = (c.badge <> "")
    m.badge.visible = hasBadge
    if hasBadge
        bw = measureText(c.badge, 16, "semibold") + 20
        if bw > w - 32 then bw = w - 32
        m.badge.translation = [16, 14]
        m.badgeBg.width = bw
        m.badgeBg.height = 30
        m.badgeText.width = bw
        m.badgeText.height = 30
    end if

    m.card.scaleRotateCenter = [w / 2, h / 2]
    updateFocus()
end sub

sub updateFocus()
    pct = 0
    if m.top.rowListHasFocus or m.top.gridHasFocus
        pct = m.top.focusPercent * m.top.rowFocusPercent
    end if
    m.ring.opacity = pct
    m.remove.visible = m.removable and pct > 0.5
    if m.w = 0 or m.h = 0 then return
    ' Grow by whole pixels on each side, so the Card's rounded corners and the
    ' ring line up exactly instead of landing on fractional pixels.
    gx = Int((m.focusScale - 1) * m.w / 2 * pct + 0.5)
    gy = Int((m.focusScale - 1) * m.h / 2 * pct + 0.5)
    m.card.scale = [(m.w + gx * 2) / m.w, (m.h + gy * 2) / m.h]
    ' The 4 px ring hugs the grown Card.
    ox = gx + 4
    oy = gy + 4
    m.ring.translation = [m.padX - ox, m.padY - oy]
    m.ring.width = m.w + ox * 2
    m.ring.height = m.h + oy * 2
end sub
