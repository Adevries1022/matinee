<?xml version="1.0" encoding="utf-8" ?>
<!-- Sign in one User: Quick Connect code first, password as a backup. -->
<component name="SignInScreen" extends="Group">
  <interface>
    <field id="mode" type="string" value="jellyfin" />
    <field id="user" type="assocarray" onChange="start" />
    <field id="closed" type="boolean" onChange="onClosed" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="SignInScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <children>
    <Label id="brand" text="MATINEE" translation="[96,60]">
      <Font role="font" uri="font:BoldSystemFontFile" size="30" />
    </Label>
    <Group id="avatar" translation="[870,130]" />
    <Label id="nameLabel" translation="[0,330]" width="1920" horizAlign="center">
      <Font role="font" uri="font:BoldSystemFontFile" size="44" />
    </Label>
    <Label id="code" translation="[0,420]" width="1920" horizAlign="center">
      <Font role="font" uri="font:BoldSystemFontFile" size="128" />
    </Label>
    <Label id="instr" translation="[360,600]" width="1200" horizAlign="center" wrap="true" lineSpacing="6">
      <Font role="font" uri="font:SystemFontFile" size="30" />
    </Label>
    <Group id="btn" translation="[700,800]">
      <Poster id="btnBg" width="520" height="76" uri="pkg:/images/fill_round.9.png" />
      <Label id="btnLabel" width="520" height="76" horizAlign="center" vertAlign="center" text="Use password instead">
        <Font role="font" uri="font:BoldSystemFontFile" size="30" />
      </Label>
    </Group>
    <Label id="status" translation="[160,910]" width="1600" horizAlign="center" wrap="true">
      <Font role="font" uri="font:SystemFontFile" size="28" />
    </Label>
    <Timer id="poll" duration="3" repeat="true" />
  </children>
</component>
