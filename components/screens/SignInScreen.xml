<?xml version="1.0" encoding="utf-8" ?>
<!-- Sign in one User (step 2 of setup), or sign in to Seerr: a Quick Connect
     code first, the password as a backup. -->
<component name="SignInScreen" extends="Group">
  <interface>
    <field id="mode" type="string" value="jellyfin" />
    <field id="user" type="assocarray" onChange="start" />
    <field id="closed" type="boolean" onChange="onClosed" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="SignInScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <children>
    <Group id="layer" />
    <Group id="codeHost" />
    <Timer id="poll" duration="3" repeat="true" />
  </children>
</component>
