<?xml version="1.0" encoding="utf-8" ?>
<!-- Home, and the Series and Movies screens when "library" is set:
     the Rail, a Hero for the focused title, and Rows of Cards. -->
<component name="BrowseScreen" extends="Group">
  <interface>
    <!-- library: { kind: "series" | "movies" } -->
    <field id="library" type="assocarray" />
    <field id="begin" type="boolean" onChange="load" />
    <field id="refresh" type="boolean" alwaysNotify="true" onChange="onRefresh" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="BrowseScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/TrailerHost.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/MenuHost.bs" />
  <children>
    <Group id="heroLayer" />
    <Label id="status" wrap="true" />
    <RowList
      id="rows"
      itemComponentName="CardItem"
      numRows="3"
      drawFocusFeedback="false"
      vertFocusAnimationStyle="fixedFocus"
      rowFocusAnimationStyle="floatingFocus"
      showRowLabel="[true]"
      visible="false" />
    <Group id="chrome" />
  </children>
</component>
