<?xml version="1.0" encoding="utf-8" ?>
<!-- Search: Matinee's own A-Z / 0-9 keys on the left, results on the right. -->
<component name="SearchScreen" extends="Group">
  <interface>
    <field id="refresh" type="boolean" alwaysNotify="true" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="SearchScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/OptionsHost.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/MenuHost.bs" />
  <children>
    <Group id="layer" />
    <MarkupGrid
      id="grid"
      itemComponentName="CardItem"
      numColumns="3"
      numRows="4"
      drawFocusFeedback="false"
      vertFocusAnimationStyle="floatingFocus"
      visible="false" />
    <Group id="sink" focusable="true" />
    <Timer id="debounce" duration="0.35" repeat="false" />
  </children>
</component>
