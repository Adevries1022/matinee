' One Discover category: a streaming service or a genre, laid out like
' Discover (a Hero and Rows, from DiscoverHost.bs). A service is browsed
' like the service itself: popular, new and top rated, then Rows by genre
' (Crime series, Anime, Documentaries...), each filtered to that service.
' A genre gets popular, new, top rated and coming soon. Rows Seerr has too
' few titles for are left out, and no title repeats. Back returns to
' Discover.

sub init()
    m.heroLayer = m.top.findNode("heroLayer")
    m.rows = m.top.findNode("rows")
    m.layer = m.top.findNode("layer")
    m.sink = m.top.findNode("sink")
    m.back = makeBackPill(m.layer, m.top.backLabel)
    m.top.observeField("focusedChild", "onFocusChanged")
    m.top.observeField("backLabel", "onBackLabel")
    discoverInit()
    m.minRow = 6
    m.dedupe = true
end sub

sub onBackLabel()
    setBtnText(m.back, m.top.backLabel)
end sub

sub onCategory()
    cat = m.top.category
    if cat = invalid then return
    name = safeStr(cat.name)
    m.eyebrowPrefix = name
    heroText("", name, "", "Loading...")
    m.heroNote.text = ""
    defs = []
    if cat.kind = "service"
        q = { "watchProviders": safeStr(cat.id), "watchRegion": safeStr(cat.region) }
        addRow(defs, "Popular series", "tv", q, {})
        addRow(defs, "Popular movies", "movie", q, {})
        addRow(defs, "New series", "tv", q, recentQuery("tv"))
        addRow(defs, "New movies", "movie", q, recentQuery("movie"))
        addRow(defs, "Top rated series", "tv", q, topQuery())
        for each g in serviceGenreRows()
            extra = { "genre": g.id }
            if g.id = "" then extra = { "keywords": g.keyword }
            addRow(defs, g.title, g.mt, q, extra)
        end for
        addRow(defs, "Top rated movies", "movie", q, topQuery())
    else
        mt = safeStr(cat.mediaType)
        kind = "movies"
        if mt = "tv" then kind = "series"
        m.eyebrowPrefix = name + " " + kind
        q = { "genre": safeStr(cat.id) }
        addRow(defs, "Popular", mt, q, {})
        addRow(defs, "New", mt, q, recentQuery(mt))
        addRow(defs, "Top rated", mt, q, topQuery())
        addRow(defs, "Coming soon", mt, q, upcomingQuery(mt))
    end if
    fetchRows(defs)
end sub

' A service's Rows by genre. TMDB genre ids (the movie and TV lists
' differ); 210024 is TMDB's anime keyword.
function serviceGenreRows() as object
    return [
        { title: "Crime series", mt: "tv", id: "80" }
        { title: "Comedy movies", mt: "movie", id: "35" }
        { title: "Anime", mt: "tv", id: "", keyword: "210024" }
        { title: "Action movies", mt: "movie", id: "28" }
        { title: "Sci-fi and fantasy series", mt: "tv", id: "10765" }
        { title: "Thrillers", mt: "movie", id: "53" }
        { title: "Comedy series", mt: "tv", id: "35" }
        { title: "Documentaries", mt: "movie", id: "99" }
        { title: "Docuseries", mt: "tv", id: "99" }
        { title: "Drama series", mt: "tv", id: "18" }
        { title: "Horror movies", mt: "movie", id: "27" }
        { title: "Kids", mt: "tv", id: "10762" }
        { title: "Reality TV", mt: "tv", id: "10764" }
        { title: "Romance movies", mt: "movie", id: "10749" }
    ]
end function

sub addRow(defs as object, title as string, mediaType as string, base as object, extra as object)
    q = { "page": "1" }
    q.Append(base)
    q.Append(extra)
    path = "/discover/movies"
    if mediaType = "tv" then path = "/discover/tv"
    defs.Push({ title: title, path: path, query: q, mediaType: mediaType, tiles: "" })
end sub

' "2026-11-22", days from today.
function isoDay(days as integer) as string
    d = CreateObject("roDateTime")
    d.FromSeconds(d.AsSeconds() + days * 86400)
    return Left(d.ToISOString(), 10)
end function

function dateKey(mediaType as string) as string
    if mediaType = "tv" then return "firstAirDate"
    return "primaryReleaseDate"
end function

' The newest releases up to today, among titles a few people have scored
' (sorting by popularity would only repeat the Popular Row).
function recentQuery(mediaType as string) as object
    q = { "voteCountGte": "20" }
    q[dateKey(mediaType) + "Lte"] = isoDay(0)
    if mediaType = "tv"
        q["sortBy"] = "first_air_date.desc"
    else
        q["sortBy"] = "primary_release_date.desc"
    end if
    return q
end function

' Best scored, among titles enough people have scored.
function topQuery() as object
    return { "sortBy": "vote_average.desc", "voteCountGte": "300" }
end function

function upcomingQuery(mediaType as string) as object
    q = {}
    q[dateKey(mediaType) + "Gte"] = isoDay(1)
    return q
end function

function makeTiles(_d as object, _data as dynamic) as object
    return []
end function

sub tileSelected(_c as object)
end sub

function canTakeFocus() as boolean
    return true
end function

sub noRows()
    heroText("", safeStr(m.top.category.name), "", "Nothing here right now.")
    m.heroNote.text = ""
end sub

' ---------- Focus & keys ----------

sub restoreContentFocus()
    if m.rows.visible and m.rows.content <> invalid
        m.rows.setFocus(true)
    else
        m.sink.setFocus(true)
    end if
end sub

sub onFocusChanged()
    if m.top.hasFocus() then restoreContentFocus()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back" then return rowsBackToTop()
    return false
end function
