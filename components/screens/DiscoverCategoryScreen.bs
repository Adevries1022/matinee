' One Discover category: a streaming service or a genre, laid out like
' Discover (a Hero and Rows, from DiscoverHost.bs). A service is browsed
' like the service itself: popular, new and top rated, then Rows by genre
' (Crime series, Anime, Documentaries...), each filtered to that service.
' A genre gets popular, new, top rated and coming soon, then Rows of that
' genre on each streaming service and by decade. Rows Seerr has too few
' titles for are left out, and no title repeats. Back returns to Discover.

sub init()
    m.heroLayer = m.top.findNode("heroLayer")
    m.rows = m.top.findNode("rows")
    m.layer = m.top.findNode("layer")
    m.sink = m.top.findNode("sink")
    m.back = makeBackPill(m.layer, m.top.backLabel)
    m.top.observeField("focusedChild", "onFocusChanged")
    m.top.observeField("backLabel", "onBackLabel")
    discoverInit()
    m.minRow = 6
    m.dedupe = true
end sub

sub onBackLabel()
    setBtnText(m.back, m.top.backLabel)
end sub

sub onCategory()
    cat = m.top.category
    if cat = invalid then return
    name = safeStr(cat.name)
    m.eyebrowPrefix = name
    heroText("", name, "", "Loading...")
    m.heroNote.text = ""
    defs = []
    if cat.kind = "service"
        q = { "watchProviders": safeStr(cat.id), "watchRegion": safeStr(cat.region) }
        addRow(defs, "Popular series", "tv", q, {})
        addRow(defs, "Popular movies", "movie", q, {})
        addRow(defs, "New series", "tv", q, recentQuery("tv"))
        addRow(defs, "New movies", "movie", q, recentQuery("movie"))
        addRow(defs, "Top rated series", "tv", q, topQuery())
        for each g in serviceGenreRows()
            extra = { "genre": g.id }
            if g.id = "" then extra = { "keywords": g.keyword }
            addRow(defs, g.title, g.mt, q, extra)
        end for
        addRow(defs, "Top rated movies", "movie", q, topQuery())
    else
        mt = safeStr(cat.mediaType)
        kind = "movies"
        if mt = "tv" then kind = "series"
        m.eyebrowPrefix = name + " " + kind
        q = { "genre": safeStr(cat.id) }
        region = safeStr(cat.region)
        if region = "" then region = "US"
        ' The genre on each service, mixed in with the general Rows and
        ' the decades, like a service's own genre page.
        svcRows = []
        for each sv in serviceList()
            sq = { "watchProviders": sv.id.ToStr(), "watchRegion": region }
            svcRows.Push({ title: "On " + sv.name, extra: sq })
        end for
        general = [
            { title: "Popular", extra: {} }
            { title: "New", extra: recentQuery(mt) }
            { title: "Top rated", extra: topQuery() }
            { title: "From the 2010s", extra: decadeQuery(mt, "2010", "2019") }
            { title: "Coming soon", extra: upcomingQuery(mt) }
            { title: "From the 2000s", extra: decadeQuery(mt, "2000", "2009") }
            { title: "From the " + Chr(8217) + "90s", extra: decadeQuery(mt, "1990", "1999") }
            { title: "Classics", extra: classicsQuery(mt) }
        ]
        for i = 0 to general.Count() - 1
            g = general[i]
            addRow(defs, g.title, mt, q, g.extra)
            ' After the first two general Rows, one service Row after each.
            if i >= 1 and i - 1 < svcRows.Count() then addRow(defs, svcRows[i - 1].title, mt, q, svcRows[i - 1].extra)
        end for
        for j = general.Count() - 1 to svcRows.Count() - 1
            addRow(defs, svcRows[j].title, mt, q, svcRows[j].extra)
        end for
    end if
    fetchRows(defs)
end sub

function makeTiles(_d as object, _data as dynamic) as object
    return []
end function

sub tileSelected(_c as object)
end sub

function canTakeFocus() as boolean
    return true
end function

sub noRows()
    heroText("", safeStr(m.top.category.name), "", "Nothing here right now.")
    m.heroNote.text = ""
end sub

' ---------- Focus & keys ----------

sub restoreContentFocus()
    if m.rows.visible and m.rows.content <> invalid
        m.rows.setFocus(true)
    else
        m.sink.setFocus(true)
    end if
end sub

sub onFocusChanged()
    if m.top.hasFocus() then restoreContentFocus()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back" then return rowsBackToTop()
    return false
end function
