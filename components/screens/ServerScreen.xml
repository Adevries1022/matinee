<?xml version="1.0" encoding="utf-8" ?>
<!-- Connect a server (step 1 of setup): found on the network, an address,
     or Quick Connect from another device. -->
<component name="ServerScreen" extends="Group">
  <interface>
    <field id="message" type="string" onChange="onMessage" />
    <!-- canCancel: opened from inside the app, so Back returns to it -->
    <field id="canCancel" type="boolean" onChange="onCanCancel" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="closed" type="boolean" onChange="onClosed" />
  </interface>
  <script type="text/brightscript" uri="ServerScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <children>
    <Group id="layer" />
    <Group id="panelLayer" />
    <Timer id="poll" duration="3" repeat="true" />
    <Timer id="clock" duration="1" repeat="true" />
  </children>
</component>
