' Plays a title and reports progress to Jellyfin. The Player OSD (from the
' Player board) replaces Roku's trickplay bar: a header with the title, a
' pause badge, the Up next card, the seek bar, and a row of controls with
' -10 s, play/pause, +10 s, Subtitles, Audio and Next episode.
' Keys: OK or Play/Pause toggles; Left/Right seek 10 s on the seek bar
' (presses add up before the jump); Rewind/Fast-forward seek 30 s;
' Up/Down move between the header, seek bar and controls; * opens subtitles.
' Back hides the OSD and keeps playing; with it hidden, Back leaves.
' Skip intro shows during the Intro segment; OK on it jumps past it.

sub init()
    m.video = m.top.findNode("video")
    m.status = m.top.findNode("status")
    m.osd = m.top.findNode("osd")
    m.upNext = m.top.findNode("upNext")
    m.picker = m.top.findNode("picker")
    m.sink = m.top.findNode("sink")
    m.countdown = m.top.findNode("countdown")
    m.hideTimer = m.top.findNode("hideTimer")
    m.seekTimer = m.top.findNode("seekTimer")
    m.skipLayer = m.top.findNode("skipLayer")

    t = th()
    m.status.font = makeFont(30)
    m.status.color = t.text

    m.video.notificationInterval = 1
    m.video.observeField("state", "onState")
    m.video.observeField("position", "onPosition")
    m.video.observeField("availableAudioTracks", "onAudioTracks")
    m.countdown.observeField("fire", "onTick")
    m.hideTimer.observeField("fire", "hideOsd")
    m.seekTimer.observeField("fire", "applySeek")
    m.scrubTimer = m.top.findNode("scrubTimer")
    m.holdTimer = m.top.findNode("holdTimer")
    m.scrubTimer.observeField("fire", "scrubStep")
    m.holdTimer.observeField("fire", "onHold")
    m.scrubLevel = 0
    m.scrubDir = 0
    m.scrubByHold = false
    m.scrubTicks = 0
    m.scrubWasPlaying = false
    m.holdKey = ""
    m.trick = invalid
    m.top.observeField("focusedChild", "onFocusChanged")

    m.di = CreateObject("roDeviceInfo")
    m.started = false
    m.stopped = false
    m.nextEp = invalid
    m.pickerOpen = false
    m.subBusy = false
    m.findLang = "eng"
    m.subPollTimer = invalid
    m.subsBefore = 0
    m.subPolls = 0
    m.wantSubLang = ""
    m.wantAudioLang = ""
    m.audioStreams = []
    m.subStreams = []
    m.playMethod = ""
    m.audioIndex = -1
    m.subIndex = -1
    m.mediaSourceId = ""
    m.playSessionId = ""
    m.item = invalid
    m.zone = "seek"
    m.ctlIndex = 1
    m.seekTarget = -1
    clearSegments()
    buildSpinner()
    buildOsd()
end sub

' ---------- Loading spinner ----------

' A quarter arc turning over a faint ring, in the middle of the screen,
' while a title loads or buffers.
sub buildSpinner()
    t = th()
    sz = t.spinnerSize
    g = CreateObject("roSGNode", "Group")
    g.translation = [(1920 - sz) \ 2, (1080 - sz) \ 2]
    g.visible = false
    m.top.insertChild(g, 2)
    track = g.CreateChild("Poster")
    track.uri = "pkg:/images/spinner_track.png"
    track.width = sz
    track.height = sz
    track.blendColor = t.white
    track.opacity = 0.18
    spin = g.CreateChild("Group")
    spin.id = "spinArc"
    spin.scaleRotateCenter = [sz / 2.0, sz / 2.0]
    arc = spin.CreateChild("Poster")
    arc.uri = "pkg:/images/spinner_arc.png"
    arc.width = sz
    arc.height = sz
    arc.blendColor = t.accent
    anim = g.CreateChild("Animation")
    anim.duration = 0.9
    anim.repeat = true
    anim.easeFunction = "linear"
    ri = anim.CreateChild("FloatFieldInterpolator")
    ri.key = [0.0, 1.0]
    ri.keyValue = [0.0, -6.2831853]
    ri.fieldToInterp = "spinArc.rotation"
    m.spinner = g
    m.spinAnim = anim
end sub

sub showSpinner(on as boolean)
    if on = m.spinner.visible then return
    m.spinner.visible = on
    if on
        m.spinAnim.control = "start"
    else
        m.spinAnim.control = "stop"
    end if
end sub

' A message in the middle of the screen (errors), instead of the spinner.
sub showStatus(text as string)
    showSpinner(false)
    m.status.text = text
    m.status.visible = true
end sub

sub clearSegments()
    m.introStart = -1
    m.introEnd = -1
    m.outroStart = -1
    m.inIntro = false
    m.skipDismissed = false
end sub

' ---------- Starting playback ----------

sub start()
    p = m.top.playItem
    if p = invalid then return
    if not isValid(p.itemId) then return
    m.itemId = p.itemId
    m.startSeconds = 0
    if isValid(p.startSeconds) then m.startSeconds = p.startSeconds
    ' A restart (after changing tracks) asks for specific streams.
    m.wantAudio = invalid
    m.wantSub = invalid
    if isValid(p.audioIndex) then m.wantAudio = p.audioIndex
    if isValid(p.subIndex) then m.wantSub = p.subIndex
    ' After finding subtitles: show the new track in this language.
    m.wantSubLang = ""
    if isValid(p.subLang) then m.wantSubLang = p.subLang
    m.wantAudioLang = ""
    if isValid(p.audioLang) then m.wantAudioLang = p.audioLang
    m.isRestart = isTrue(p.restart)
    m.secondPass = false
    m.started = false
    m.stopped = false
    m.lastReport = 0
    if not m.isRestart
        m.nextEp = invalid
        clearSegments()
    end if
    m.upNextShown = false
    m.upNextCancelled = false
    m.upNext.visible = false
    closePicker()
    m.countdown.control = "stop"
    m.scrubTimer.control = "stop"
    m.scrubLevel = 0
    m.seekTarget = -1
    m.status.visible = false
    showSpinner(true)
    m.loadStart = CreateObject("roTimespan")
    if m.isRestart
        requestPlayback()
    else
        m.trick = invalid
        apiRequest("/Items/" + m.itemId, { "userId": m.global.userId, "Fields": "Trickplay" }, "onItem")
    end if
end sub

sub onItem(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data)
        showStatus("Couldn't load this title (error " + res.code.ToStr() + ").")
        return
    end if
    m.item = res.data
    readTrickplay(m.item)
    setHeader()
    refreshNextUi()
    ' Intro and Outro times, from Jellyfin's media segments (Intro Skipper).
    apiRequest("/MediaSegments/" + m.itemId, {}, "onSegments")
    if safeStr(m.item.Type) = "Episode" and isValid(m.item.SeriesId)
        apiRequest("/Shows/" + safeStr(m.item.SeriesId) + "/Episodes", { "userId": m.global.userId, "startItemId": m.itemId, "Limit": "3", "EnableTotalRecordCount": "false" }, "onNextEp")
    end if
    requestPlayback()
end sub

function prefValue(key as string, fallback as dynamic) as dynamic
    p = m.global.prefs
    if p = invalid then return fallback
    v = p[key]
    if v = invalid then return fallback
    return v
end function

function maxBitrate() as integer
    b = safeInt(prefValue("maxBitrate", 0))
    if b <= 0 then b = 40000000
    return b
end function

sub requestPlayback()
    query = { "userId": m.global.userId, "IsPlayback": "true", "AutoOpenLiveStream": "true", "MaxStreamingBitrate": maxBitrate().ToStr() }
    if prefValue("directPlay", "prefer") = "off"
        query["EnableDirectPlay"] = "false"
        query["EnableDirectStream"] = "false"
    end if
    if m.wantAudio <> invalid then query["AudioStreamIndex"] = m.wantAudio.ToStr()
    if m.wantSub <> invalid
        query["SubtitleStreamIndex"] = m.wantSub.ToStr()
        ' Picture subtitles are burned in, which only a transcode can do.
        ' Newer servers still offer direct play then, so ask for it outright.
        if isImageSub(m.wantSub)
            query["EnableDirectPlay"] = "false"
            query["EnableDirectStream"] = "false"
        end if
    end if
    if m.startSeconds > 0 then query["StartTimeTicks"] = (Int(m.startSeconds) * 10000000&).ToStr()
    apiRequest("/Items/" + m.itemId + "/PlaybackInfo", query, "onPlaybackInfo", "POST", { "DeviceProfile": deviceProfile() })
end sub

sub onNextEp(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    items = res.data.Items
    if not isValid(items) then return
    for i = 0 to items.Count() - 2
        if safeStr(items[i].Id) = m.itemId then m.nextEp = items[i + 1]
    end for
    refreshNextUi()
end sub

' Jellyfin's trickplay images (10.9 and newer, when the library has them):
' sheets of small pictures taken every Interval ms, TileWidth across and
' TileHeight down. Takes the size nearest 320 px wide.
sub readTrickplay(item as object)
    m.trick = invalid
    tp = item.Trickplay
    if not isValid(tp) or type(tp) <> "roAssociativeArray" then return
    for each sourceId in tp
        sizes = tp[sourceId]
        if type(sizes) = "roAssociativeArray"
            best = invalid
            for each w in sizes
                info = sizes[w]
                if best = invalid or Abs(safeInt(info.Width) - 320) < Abs(safeInt(best.Width) - 320) then best = info
            end for
            if best <> invalid and safeInt(best.Width) > 0 and safeInt(best.Interval) > 0
                m.trick = { sourceId: sourceId, w: safeInt(best.Width), h: safeInt(best.Height), cols: safeInt(best.TileWidth), rows: safeInt(best.TileHeight), count: safeInt(best.ThumbnailCount), interval: safeInt(best.Interval), tile: -1 }
                if m.trick.cols < 1 then m.trick.cols = 1
                if m.trick.rows < 1 then m.trick.rows = 1
                print "[Matinee] trickplay: "; m.trick.count; " pictures at "; m.trick.w; " px"
                return
            end if
        end if
    end for
end sub

' The picture at seconds, above the seek bar at x.
sub paintTrick(seconds as float, x as integer)
    tr = m.trick
    show = tr <> invalid and m.seekTarget >= 0 and m.osd.visible
    m.trickWrap.visible = show
    if not show
        m.scrubLabel.translation = [0, m.barY - 80]
        return
    end if
    n = Int(seconds * 1000 / tr.interval)
    if n >= tr.count then n = tr.count - 1
    if n < 0 then n = 0
    perTile = tr.cols * tr.rows
    tile = n \ perTile
    k = n mod perTile
    ' Shown 320 px wide, in the pictures' own shape.
    dw = 320
    dh = Int(320 * tr.h / tr.w)
    if tile <> tr.tile
        tr.tile = tile
        ' A whole sheet is loaded at most 2048 px wide, to keep memory low.
        sheetW = tr.cols * dw
        sheetH = tr.rows * dh
        s = 1.0
        if sheetW > 2048 then s = 2048 / sheetW
        m.trickSheet.width = sheetW
        m.trickSheet.height = sheetH
        m.trickSheet.loadWidth = Int(sheetW * s)
        m.trickSheet.loadHeight = Int(sheetH * s)
        m.trickSheet.uri = m.global.serverUrl + "/Videos/" + m.itemId + "/Trickplay/" + tr.w.ToStr() + "/" + tile.ToStr() + ".jpg?MediaSourceId=" + tr.sourceId + "&api_key=" + m.global.token
    end if
    m.trickSheet.translation = [-(k mod tr.cols) * dw, -(k \ tr.cols) * dh]
    gx = x - dw \ 2
    if gx < 80 then gx = 80
    if gx > 1920 - 80 - dw then gx = 1920 - 80 - dw
    m.trickWrap.translation = [gx, m.barY - 40 - dh]
    m.trickFrame.translation = [-4, -4]
    m.trickFrame.width = dw + 8
    m.trickFrame.height = dh + 8
    m.trickGroup.clippingRect = [0, 0, dw, dh]
    m.scrubLabel.translation = [0, m.barY - 40 - dh - 52]
end sub

sub onSegments(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    items = res.data.Items
    if not isValid(items) then return
    for each seg in items
        kind = safeStr(seg.Type)
        if kind = "Intro" and m.introStart < 0
            m.introStart = ticksToSeconds(seg.StartTicks)
            m.introEnd = ticksToSeconds(seg.EndTicks)
        else if kind = "Outro" and m.outroStart < 0
            m.outroStart = ticksToSeconds(seg.StartTicks)
        end if
    end for
    if m.introEnd <= m.introStart then m.introStart = -1
    print "[Matinee] segments: intro " + m.introStart.ToStr() + "-" + m.introEnd.ToStr() + ", outro " + m.outroStart.ToStr()
end sub

' Tell Jellyfin what this Roku can play, so it direct-plays when possible
' and only transcodes when it has to.
function deviceProfile() as object
    vc = "h264"
    if m.di.CanDecodeVideo({ codec: "hevc" }).result = true then vc = vc + ",hevc"
    if m.di.CanDecodeVideo({ codec: "vp9" }).result = true then vc = vc + ",vp9"
    ac = "aac,mp3"
    hasAc3 = false
    for each a in ["ac3", "eac3", "flac", "opus"]
        if m.di.CanDecodeAudio({ codec: a }).result = true
            ac = ac + "," + a
            if a = "ac3" then hasAc3 = true
        end if
    end for
    tAudio = "aac"
    tChannels = "2"
    if hasAc3
        tAudio = "ac3,aac"
        tChannels = "6"
    end if
    subs = []
    for each f in ["vtt", "srt", "subrip", "ass", "ssa", "mov_text"]
        subs.Push({ "Format": f, "Method": "External" })
    end for
    ' Picture-based subtitles can't be drawn by the Roku: burn them in.
    for each f in ["pgssub", "pgs", "dvdsub", "dvbsub", "vobsub"]
        subs.Push({ "Format": f, "Method": "Encode" })
    end for
    return {
        "MaxStreamingBitrate": maxBitrate(),
        "MaxStaticBitrate": 100000000,
        "MusicStreamingTranscodingBitrate": 192000,
        "DirectPlayProfiles": [{ "Container": "mp4,m4v,mov,mkv", "Type": "Video", "VideoCodec": vc, "AudioCodec": ac }],
        "TranscodingProfiles": [{ "Container": "ts", "Type": "Video", "VideoCodec": "h264", "AudioCodec": tAudio, "Context": "Streaming", "Protocol": "hls", "MaxAudioChannels": tChannels, "MinSegments": 1, "BreakOnNonKeyFrames": true }],
        "ContainerProfiles": [],
        "CodecProfiles": [],
        "SubtitleProfiles": subs
    }
end function

sub onPlaybackInfo(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data)
        showStatus("Jellyfin couldn't start playback (error " + res.code.ToStr() + ").")
        return
    end if
    data = res.data
    if isValid(data.ErrorCode)
        showStatus("Jellyfin couldn't start playback: " + safeStr(data.ErrorCode))
        return
    end if
    if not isValid(data.MediaSources)
        showStatus("This title has no playable files.")
        return
    end if
    if data.MediaSources.Count() = 0
        showStatus("This title has no playable files.")
        return
    end if

    ms = data.MediaSources[0]
    readStreams(ms)

    ' First time through: pick tracks from the User's settings, or from
    ' what they chose earlier in this binge.
    if not m.isRestart and not m.secondPass
        chooseTracks(ms)
        needsServer = false
        if not isTrue(ms.SupportsDirectPlay) and m.audioIndex <> safeInt(ms.DefaultAudioStreamIndex) then needsServer = true
        if isImageSub(m.subIndex) then needsServer = true
        if needsServer
            m.secondPass = true
            m.wantAudio = m.audioIndex
            m.wantSub = m.subIndex
            requestPlayback()
            return
        end if
    else if m.isRestart
        if m.wantAudio <> invalid then m.audioIndex = m.wantAudio
        if m.wantSub <> invalid then m.subIndex = m.wantSub
        if m.wantSubLang <> "" then m.subIndex = bestSub(m.wantSubLang, false)
        if m.wantAudioLang <> ""
            m.audioIndex = safeInt(ms.DefaultAudioStreamIndex)
            for each s in m.audioStreams
                if s.lang = m.wantAudioLang
                    m.audioIndex = s.index
                    exit for
                end if
            end for
        end if
    end if

    m.playSessionId = safeStr(data.PlaySessionId)
    m.mediaSourceId = safeStr(ms.Id)
    server = m.global.serverUrl
    token = m.global.token

    content = CreateObject("roSGNode", "ContentNode")
    if isTrue(ms.SupportsDirectPlay) and prefValue("directPlay", "prefer") <> "off" and not isImageSub(m.subIndex)
        url = server + "/Videos/" + m.itemId + "/stream?static=true&MediaSourceId=" + m.mediaSourceId
        url = url + "&PlaySessionId=" + m.playSessionId + "&api_key=" + token + "&ApiKey=" + token
        fmt = LCase(safeStr(ms.Container))
        comma = Instr(1, fmt, ",")
        if comma > 0 then fmt = Left(fmt, comma - 1)
        if fmt = "mov" or fmt = "m4v" then fmt = "mp4"
        content.streamFormat = fmt
        m.playMethod = "DirectPlay"
    else if isValid(ms.TranscodingUrl)
        url = server + safeStr(ms.TranscodingUrl)
        lu = LCase(url)
        if Instr(1, lu, "api_key=") = 0 and Instr(1, lu, "apikey=") = 0 then url = url + "&api_key=" + token
        content.streamFormat = "hls"
        m.playMethod = "Transcode"
    else
        showStatus("This file can't be played on your Roku.")
        return
    end if

    ' Text subtitles are sent as WebVTT files the Roku draws itself.
    tracks = []
    for each s in m.subStreams
        if s.isText
            tracks.Push({ Language: s.lang, TrackName: subUrl(s.index), Description: s.title })
        end if
    end for
    content.SubtitleTracks = tracks

    content.url = url
    content.title = playTitle(m.item)
    content.PlayStart = m.startSeconds
    m.pendingContent = content
    ' A transcode that starts partway in is warmed up first, so the sound
    ' doesn't run ahead of the picture (see warmHls in ApiTask).
    if m.playMethod = "Transcode" and m.startSeconds > 5
        m.warmToken = m.playSessionId
        warmTranscode(url, m.startSeconds * 1.0, "onWarm")
        return
    end if
    beginVideo()
end sub

sub onWarm(event as object)
    res = event.getData()
    if m.warmToken <> m.playSessionId or m.pendingContent = invalid then return
    seg = -1
    if isValid(res.data) then seg = res.data.segment
    msElapsed = 0
    if m.loadStart <> invalid then msElapsed = m.loadStart.TotalMilliseconds()
    print "[Matinee] player: warmed transcode (segment "; seg; ", ok "; res.ok; " "; res.error; ") after "; msElapsed; " ms"
    beginVideo()
end sub

sub beginVideo()
    content = m.pendingContent
    m.pendingContent = invalid
    if content = invalid then return
    m.video.content = content
    m.video.control = "play"
    applySubtitle()
    refreshTrackPills()
    m.status.visible = false
    m.started = true
    if m.top.isInFocusChain() and not m.pickerOpen then m.sink.setFocus(true)
    apiRequest("/Sessions/Playing", {}, "onIgnore", "POST", progressBody(false))
    showOsd()
end sub

function subUrl(index as integer) as string
    return m.global.serverUrl + "/Videos/" + m.itemId + "/" + m.mediaSourceId + "/Subtitles/" + index.ToStr() + "/0/Stream.vtt?api_key=" + m.global.token
end function

function playTitle(item as object) as string
    if item = invalid then return ""
    if safeStr(item.Type) = "Episode" then return safeStr(item.SeriesName)
    return safeStr(item.Name)
end function

' ---------- Tracks ----------

function languageName(code as string) as string
    names = { eng: "English", en: "English", spa: "Spanish", es: "Spanish", fre: "French", fra: "French", fr: "French", ger: "German", deu: "German", de: "German", ita: "Italian", it: "Italian", jpn: "Japanese", ja: "Japanese", kor: "Korean", ko: "Korean", chi: "Chinese", zho: "Chinese", zh: "Chinese", por: "Portuguese", pt: "Portuguese", rus: "Russian", ru: "Russian", dut: "Dutch", nld: "Dutch", nl: "Dutch", swe: "Swedish", sv: "Swedish", nor: "Norwegian", nob: "Norwegian", dan: "Danish", fin: "Finnish", pol: "Polish", tur: "Turkish", ara: "Arabic", hin: "Hindi", heb: "Hebrew", gre: "Greek", ell: "Greek", hun: "Hungarian", cze: "Czech", ces: "Czech", tha: "Thai", vie: "Vietnamese", ind: "Indonesian", ukr: "Ukrainian" }
    if names.DoesExist(code) then return names[code]
    return ""
end function

function channelText(n as integer) as string
    if n = 1 then return "Mono"
    if n = 2 then return "Stereo"
    if n = 6 then return "5.1"
    if n = 8 then return "7.1"
    if n > 0 then return n.ToStr() + " ch"
    return ""
end function

sub readStreams(ms as object)
    m.audioStreams = []
    m.subStreams = []
    if not isValid(ms.MediaStreams) then return
    for each s in ms.MediaStreams
        kind = safeStr(s.Type)
        title = safeStr(s.DisplayTitle)
        if title = "" then title = safeStr(s.Language)
        if title = "" then title = "Track " + safeInt(s.Index).ToStr()
        lang = LCase(safeStr(s.Language))
        short = languageName(lang)
        if short = "" then short = title
        if kind = "Audio"
            ch = channelText(safeInt(s.Channels))
            if ch <> "" and short <> title then short = short + " " + ch
        end if
        forced = isTrue(s.IsForced)
        ' Forced subtitles only translate the odd foreign line, so say so.
        if kind = "Subtitle" and forced then short = short + " (Forced)"
        info = { index: safeInt(s.Index), lang: lang, title: title, short: short, isText: isTrue(s.IsTextSubtitleStream), forced: forced }
        if kind = "Audio" then m.audioStreams.Push(info)
        if kind = "Subtitle" then m.subStreams.Push(info)
    end for
end sub

function isImageSub(index as dynamic) as boolean
    if index = invalid then return false
    for each s in m.subStreams
        if s.index = index then return not s.isText
    end for
    return false
end function

function findStream(list as object, index as dynamic) as object
    if index = invalid then return invalid
    for each s in list
        if s.index = index then return s
    end for
    return invalid
end function

' Server defaults, then the Subtitles settings, then what was chosen earlier.
sub chooseTracks(ms as object)
    m.audioIndex = -1
    if isValid(ms.DefaultAudioStreamIndex) then m.audioIndex = safeInt(ms.DefaultAudioStreamIndex)
    m.subIndex = -1
    if isValid(ms.DefaultSubtitleStreamIndex) then m.subIndex = safeInt(ms.DefaultSubtitleStreamIndex)
    mode = safeStr(prefValue("subtitles", "auto"))
    lang = safeStr(prefValue("subtitleLang", ""))
    if mode = "off"
        m.subIndex = -1
    else if mode = "on"
        m.subIndex = bestSub(lang, false)
    end if
    tp = m.global.trackPrefs
    if tp = invalid then return
    if not isTrue(tp.set) then return
    if safeStr(tp.audioLang) <> ""
        for each s in m.audioStreams
            if s.lang = tp.audioLang
                m.audioIndex = s.index
                exit for
            end if
        end for
    end if
    if isTrue(tp.subOff)
        m.subIndex = -1
    else if safeStr(tp.subLang) <> ""
        m.subIndex = bestSub(tp.subLang, isTrue(tp.subForced))
    end if
end sub

' The subtitle track to show for a language ("" for any): full subtitles
' unless forced ones are wanted, text before pictures (pictures need a
' transcode), and the first track as a last resort.
function bestSub(lang as string, wantForced as boolean) as integer
    best = -1
    bestScore = -1
    for each s in m.subStreams
        score = 0
        if lang = "" or s.lang = lang then score = score + 4
        if s.forced = wantForced then score = score + 2
        if s.isText then score = score + 1
        if score > bestScore
            best = s.index
            bestScore = score
        end if
    end for
    return best
end function

' Show the chosen text subtitle, or none.
sub applySubtitle()
    s = findStream(m.subStreams, m.subIndex)
    if s <> invalid
        if s.isText
            m.video.subtitleTrack = subUrl(s.index)
            m.video.globalCaptionMode = "On"
            return
        end if
    end if
    m.video.globalCaptionMode = "Off"
end sub

' For direct play the Roku switches audio itself, matched by order.
sub onAudioTracks()
    if m.playMethod <> "DirectPlay" then return
    selectRokuAudio()
end sub

sub selectRokuAudio()
    tracks = m.video.availableAudioTracks
    if tracks = invalid then return
    trackPos = -1
    for i = 0 to m.audioStreams.Count() - 1
        if m.audioStreams[i].index = m.audioIndex then trackPos = i
    end for
    if trackPos >= 0 and trackPos < tracks.Count()
        m.video.audioTrack = tracks[trackPos].Track
    end if
end sub

' ---------- The OSD ----------

sub buildOsd()
    t = th()
    o = m.osd
    top = makeShape(o, "pkg:/images/grad_vd.png", 1920, 260, t.black, 0.75)
    top.loadDisplayMode = "scaleToFill"
    bottom = makeFadeUp(o, 1920, 420, t.black, 0.88)
    bottom.translation = [0, 660]

    ' Header: round back button, title and episode.
    m.backBtn = makeBtn(o, { kind: "round", icon: "back", h: 64, iconSize: 28 })
    m.backBtn.group.translation = [80, 56]
    m.hTitle = makeLabel(o, "", 32, "display", t.text)
    m.hTitle.translation = [172, 54]
    m.hTitle.height = 40
    m.hTitle.vertAlign = "center"
    m.hSub = makeLabel(o, "", 20, "regular", t.meta)
    m.hSub.translation = [172, 96]
    ' The title's Logo in place of its name, as in the Hero, with the
    ' episode line below it.
    m.hLogoBox = [172, 28, t.playerLogoW, t.playerLogoH]
    m.hLogo = makeLogo(o)
    m.hLogo.observeField("loadStatus", "onHeaderLogo")

    ' Pause badge in the middle.
    m.pauseBadge = o.CreateChild("Group")
    m.pauseBadge.translation = [860, 440]
    makeShape(m.pauseBadge, "pkg:/images/circle.png", 200, 200, t.black, 0.45)
    ic = makeIcon(m.pauseBadge, "play", 84, t.text)
    ic.translation = [62, 58]

    ' Up next card.
    m.nextCard = o.CreateChild("Group")
    m.nextCard.translation = [1920 - 80 - 440, 1080 - 236 - 122]
    makeBox(m.nextCard, 440, 122, 18, t.nextCard, 0.85)
    m.nextThumb = m.nextCard.CreateChild("Poster")
    m.nextThumb.translation = [16, 16]
    m.nextThumb.width = 160
    m.nextThumb.height = 90
    m.nextThumb.loadWidth = 160
    m.nextThumb.loadHeight = 90
    m.nextThumb.loadDisplayMode = "scaleToZoom"
    corners = makeShape(m.nextCard, "pkg:/images/corners_r10.9.png", 160, 90, t.nextCard)
    corners.translation = [16, 16]
    lbl = makeLabel(m.nextCard, "UP NEXT", 15, "semibold", t.accent)
    lbl.translation = [194, 22]
    m.nextTitle = makeLabel(m.nextCard, "", 20, "semibold", t.text)
    m.nextTitle.translation = [194, 46]
    m.nextTitle.width = 230
    m.nextInfo = makeLabel(m.nextCard, "", 16, "regular", t.muted)
    m.nextInfo.translation = [194, 76]
    m.nextInfo.width = 230
    m.nextCard.visible = false

    ' Seek bar row: elapsed, bar with Accent fill and white thumb, remaining.
    m.barX = 80 + 84
    m.barW = 1920 - 80 - 96 - m.barX
    barY = 874
    m.elapsed = makeLabel(o, "0:00", 20, "regular", t.heading)
    m.elapsed.translation = [80, barY - 15]
    m.elapsed.height = 30
    m.elapsed.vertAlign = "center"
    m.remaining = makeLabel(o, "", 20, "regular", t.muted)
    m.remaining.translation = [1920 - 80 - 84, barY - 15]
    m.remaining.width = 84
    m.remaining.height = 30
    m.remaining.horizAlign = "right"
    m.remaining.vertAlign = "center"
    m.barBg = o.CreateChild("Rectangle")
    m.barBg.translation = [m.barX, barY - 4]
    m.barBg.width = m.barW
    m.barBg.height = 8
    m.barBg.color = t.trackOver
    m.barFill = o.CreateChild("Rectangle")
    m.barFill.translation = [m.barX, barY - 4]
    m.barFill.height = 8
    m.barFill.color = t.accent
    ' "Fast-forward 2x" over the seek bar while scrubbing.
    m.scrubLabel = makeLabel(o, "", 26, "semibold", t.text)
    m.scrubLabel.translation = [0, barY - 80]
    m.scrubLabel.width = 1920
    m.scrubLabel.horizAlign = "center"
    m.scrubLabel.visible = false
    ' The trickplay picture over the seek bar while seeking: a frame, and a
    ' clipped window onto one sheet of pictures (see paintTrick).
    m.trickWrap = o.CreateChild("Group")
    m.trickWrap.visible = false
    m.trickFrame = makeBox(m.trickWrap, 328, 188, 12, t.white)
    m.trickGroup = m.trickWrap.CreateChild("Group")
    m.trickSheet = m.trickGroup.CreateChild("Poster")
    m.trickSheet.loadDisplayMode = "scaleToFill"
    m.thumbRing = makeShape(o, "pkg:/images/circle.png", 40, 40, t.accent)
    m.thumb = makeShape(o, "pkg:/images/circle.png", 28, 28, t.white)
    m.barY = barY

    ' Controls: -10, play/pause, +10 on the left; pills on the right.
    m.btnBack10 = makeBtn(o, { kind: "round", icon: "rewind10", h: 72, iconSize: 32 })
    m.btnBack10.group.translation = [80, 932]
    m.btnPlay = makeBtn(o, { kind: "round", icon: "pause", h: 96, iconSize: 40 })
    m.btnPlay.kind = "primary"
    m.btnPlay.group.translation = [172, 920]
    m.btnFwd10 = makeBtn(o, { kind: "round", icon: "forward10", h: 72, iconSize: 32 })
    m.btnFwd10.group.translation = [288, 932]
    m.btnSubs = makeBtn(o, { kind: "pill", icon: "subtitles", text: "Subtitles", h: 64, size: 20, style: "medium", padX: 24 })
    m.btnAudio = makeBtn(o, { kind: "pill", icon: "audio", text: "Audio", h: 64, size: 20, style: "medium", padX: 24 })
    m.btnNext = makeBtn(o, { kind: "pill", icon: "next", text: "Next episode", h: 64, size: 20, padX: 28, iconSize: 24, iconAfter: true })
    m.btnNext.kind = "primary"
    m.controls = [m.btnBack10, m.btnPlay, m.btnFwd10, m.btnSubs, m.btnAudio, m.btnNext]

    ' Skip intro: on its own layer, so it shows without the OSD.
    m.btnSkip = makeBtn(m.skipLayer, { kind: "pill", icon: "next", text: "Skip intro", h: 64, size: 22, padX: 30, iconSize: 24, iconAfter: true })
    layoutPills()
    paintOsd()
end sub

' Skip intro shows while the position is inside the Intro. With the OSD
' hidden it is Focused, so OK skips; with the OSD up it sits above the seek
' bar and is reached with Up.
sub paintSkip()
    show = m.inIntro and not m.skipDismissed and not m.pickerOpen and not m.upNext.visible and not m.nextCard.visible
    if not show and m.zone = "skip" then m.zone = "seek"
    m.skipLayer.visible = show
    if not show then return
    x = 1920 - 80 - m.btnSkip.w
    if m.osd.visible
        m.btnSkip.group.translation = [x, 770]
        paintBtn(m.btnSkip, m.zone = "skip")
    else
        m.btnSkip.group.translation = [x, 1080 - 80 - 64]
        paintBtn(m.btnSkip, true)
    end if
end sub

sub skipIntro()
    if m.introEnd <= 0 then return
    m.video.seek = m.introEnd
    m.skipDismissed = true
    m.zone = "seek"
    paintSkip()
    if m.osd.visible then paintOsd()
end sub

sub layoutPills()
    x = 1920 - 80
    for i = m.controls.Count() - 1 to 3 step -1
        b = m.controls[i]
        if b.group.visible
            x = x - b.w
            b.group.translation = [x, 936]
            x = x - 20
        end if
    end for
end sub

sub setHeader()
    it = m.item
    if it = invalid then return
    m.hTitle.text = playTitle(it)
    showLogo(m.hLogo, m.hTitle, logoUrl(it, th().playerLogoW, th().playerLogoH), m.hLogoBox)
    placeHeaderSub()
    if safeStr(it.Type) = "Episode"
        parts = []
        if isValid(it.ParentIndexNumber) then parts.Push("Season " + it.ParentIndexNumber.ToStr())
        if isValid(it.IndexNumber) then parts.Push("Episode " + it.IndexNumber.ToStr())
        parts.Push(safeStr(it.Name))
        m.hSub.text = parts.Join(" " + Chr(183) + " ")
    else
        parts = []
        if isValid(it.ProductionYear) then parts.Push(it.ProductionYear.ToStr())
        r = formatRuntime(it.RunTimeTicks)
        if r <> "" then parts.Push(r)
        m.hSub.text = parts.Join(" " + Chr(183) + " ")
    end if
end sub

sub onHeaderLogo()
    placeLogo(m.hLogo, m.hTitle, m.hLogoBox)
    placeHeaderSub()
end sub

' The episode line sits under the Logo when there is one, else under the name.
sub placeHeaderSub()
    if m.hLogo.visible
        m.hSub.translation = [172, m.hLogoBox[1] + m.hLogoBox[3] + 12]
    else
        m.hSub.translation = [172, 96]
    end if
end sub

sub refreshNextUi()
    has = m.nextEp <> invalid
    m.btnNext.group.visible = has
    if has
        ep = m.nextEp
        code = ""
        if isValid(ep.IndexNumber) then code = "E" + ep.IndexNumber.ToStr() + " " + Chr(183) + " "
        m.nextTitle.text = code + safeStr(ep.Name)
        m.nextInfo.text = formatRuntime(ep.RunTimeTicks)
        m.nextThumb.uri = imageUrl(safeStr(ep.Id), "Primary", 320)
    end if
    if not has and m.ctlIndex = 5 then m.ctlIndex = 1
    layoutPills()
end sub

sub refreshTrackPills()
    subText = "Subtitles " + Chr(183) + " Off"
    s = findStream(m.subStreams, m.subIndex)
    if s <> invalid then subText = "Subtitles " + Chr(183) + " " + s.short
    setBtnText(m.btnSubs, subText)
    a = findStream(m.audioStreams, m.audioIndex)
    audioText = "Audio"
    if a <> invalid then audioText = "Audio " + Chr(183) + " " + a.short
    setBtnText(m.btnAudio, audioText)
    m.btnSubs.group.visible = m.subStreams.Count() > 0
    m.btnAudio.group.visible = m.audioStreams.Count() > 1
    if not m.controls[m.ctlIndex].group.visible then m.ctlIndex = 1
    layoutPills()
    paintOsd()
end sub

sub paintOsd()
    paused = (m.video.state = "paused")
    m.pauseBadge.visible = paused and m.scrubLevel = 0
    paintScrub()
    if paused
        setBtnIcon(m.btnPlay, "play")
    else
        setBtnIcon(m.btnPlay, "pause")
    end if
    focus = -1
    if m.zone = "controls" then focus = m.ctlIndex
    paintBtns(m.controls, focus)
    paintBtn(m.backBtn, m.zone = "header")
    ' The Up next card shows only while Next episode is Focused.
    m.nextCard.visible = (m.nextEp <> invalid and focus = 5)
    m.thumbRing.visible = (m.zone = "seek")
    updateBar()
    paintSkip()
end sub

sub updateBar()
    dur = m.video.duration
    curPos = m.video.position
    if m.seekTarget >= 0 then curPos = m.seekTarget
    if dur <= 0
        dur = 0
        if m.item <> invalid then dur = ticksToSeconds(m.item.RunTimeTicks)
    end if
    frac = 0.0
    if dur > 0 then frac = curPos / dur
    if frac < 0 then frac = 0
    if frac > 1 then frac = 1
    m.barFill.width = Int(m.barW * frac)
    tx = m.barX + Int(m.barW * frac)
    m.thumb.translation = [tx - 14, m.barY - 14]
    m.thumbRing.translation = [tx - 20, m.barY - 20]
    paintTrick(curPos, tx)
    m.elapsed.text = formatClock(Int(curPos))
    remain = Int(dur - curPos)
    if remain < 0 then remain = 0
    m.remaining.text = Chr(8722) + formatClock(remain)
end sub

sub showOsd()
    if not m.started then return
    m.osd.visible = true
    paintOsd()
    restartHideTimer()
end sub

sub restartHideTimer()
    m.hideTimer.control = "stop"
    if m.video.state = "playing" and not m.pickerOpen then m.hideTimer.control = "start"
end sub

sub hideOsd()
    if m.video.state <> "playing" or m.pickerOpen or m.seekTarget >= 0 then return
    closeOsd()
end sub

' Back hides the OSD whatever the state; playback carries on.
sub closeOsd()
    m.hideTimer.control = "stop"
    m.osd.visible = false
    m.zone = "seek"
    paintSkip()
end sub

sub togglePause()
    if m.video.state = "paused"
        m.video.control = "resume"
    else if m.video.state = "playing"
        m.video.control = "pause"
    end if
    showOsd()
end sub

' Presses add up; the jump happens once they stop.
sub seekBy(secs as integer)
    if not m.started then return
    base = m.video.position
    if m.seekTarget >= 0 then base = m.seekTarget
    target = base + secs
    if target < 0 then target = 0
    dur = m.video.duration
    if dur > 0 and target > dur - 2 then target = dur - 2
    m.seekTarget = target
    showOsd()
    m.seekTimer.control = "stop"
    m.seekTimer.control = "start"
end sub

sub applySeek()
    if m.seekTarget < 0 then return
    m.video.seek = m.seekTarget
    m.seekTarget = -1
    restartHideTimer()
end sub

' ---------- Fast-forward and rewind ----------
' Fast-forward or Rewind starts scrubbing; pressing it again goes faster
' (three speeds), the other one turns around. Holding Left or Right scrubs
' until it's let go. OK or Play jumps there; Back cancels.

function scrubSpeeds() as object
    ' Seconds of video per second of scrubbing, for 1x, 2x and 3x.
    return [30, 90, 240]
end function

' byHold: started by holding Left or Right, so it speeds up on its own the
' longer the key is held (2x after 2 s, 3x after 5 s).
sub startScrub(dirn as integer, byHold = false as boolean)
    if not m.started then return
    if m.scrubLevel = 0
        ' The picture holds still while scrubbing, as on the streaming services.
        m.scrubWasPlaying = (m.video.state = "playing")
        if m.scrubWasPlaying then m.video.control = "pause"
    end if
    m.scrubByHold = byHold
    m.scrubTicks = 0
    if m.scrubLevel > 0 and m.scrubDir = dirn
        if m.scrubLevel < scrubSpeeds().Count() then m.scrubLevel = m.scrubLevel + 1
    else
        m.scrubLevel = 1
        m.scrubDir = dirn
    end if
    m.seekTimer.control = "stop"
    if m.seekTarget < 0 then m.seekTarget = m.video.position
    m.hideTimer.control = "stop"
    m.osd.visible = true
    paintOsd()
    m.scrubTimer.control = "start"
end sub

sub scrubStep()
    if m.scrubLevel <= 0 then return
    if m.scrubByHold
        m.scrubTicks = m.scrubTicks + 1
        was = m.scrubLevel
        m.scrubLevel = 1
        if m.scrubTicks >= 8 then m.scrubLevel = 2
        if m.scrubTicks >= 20 then m.scrubLevel = 3
        if m.scrubLevel <> was then paintScrub()
    end if
    rate = scrubSpeeds()[m.scrubLevel - 1] * 0.25
    target = m.seekTarget + m.scrubDir * rate
    if target < 0 then target = 0
    dur = m.video.duration
    if dur > 0 and target > dur - 2 then target = dur - 2
    m.seekTarget = target
    updateBar()
end sub

' commit: jump to the scrubbed spot; otherwise stay where playback is.
sub stopScrub(commit as boolean)
    m.scrubTimer.control = "stop"
    m.holdTimer.control = "stop"
    m.holdKey = ""
    if m.scrubLevel = 0 then return
    m.scrubLevel = 0
    m.scrubDir = 0
    if commit
        applySeek()
        if m.video.state = "paused" then m.video.control = "resume"
    else
        m.seekTarget = -1
        if m.scrubWasPlaying then m.video.control = "resume"
    end if
    m.scrubByHold = false
    paintOsd()
    restartHideTimer()
end sub

sub onHold()
    if m.holdKey = "left" then startScrub(-1, true)
    if m.holdKey = "right" then startScrub(1, true)
end sub

sub paintScrub()
    m.scrubLabel.visible = m.scrubLevel > 0
    if m.scrubLevel = 0 then return
    word = "Fast-forward"
    if m.scrubDir < 0 then word = "Rewind"
    m.scrubLabel.text = word + " " + m.scrubLevel.ToStr() + Chr(215)
end sub

sub doControl(index as integer)
    if index = 0
        seekBy(-10)
    else if index = 1
        togglePause()
    else if index = 2
        seekBy(10)
    else if index = 3
        openPicker("sub")
    else if index = 4
        openPicker("audio")
    else if index = 5
        if m.nextEp <> invalid then playNext()
    end if
end sub

sub moveControl(dirn as integer)
    i = m.ctlIndex + dirn
    while i >= 0 and i < m.controls.Count()
        if m.controls[i].group.visible then exit while
        i = i + dirn
    end while
    if i >= 0 and i < m.controls.Count() then m.ctlIndex = i
    paintOsd()
end sub

' ---------- Track picker ----------

sub openPicker(kind as string)
    if not m.started then return
    m.pickKind = kind
    m.pickerRows = []
    if kind = "audio"
        for each s in m.audioStreams
            m.pickerRows.Push({ kind: "audio", index: s.index, label: s.title })
        end for
    else
        m.pickerRows.Push({ kind: "sub", index: -1, label: "Off" })
        for each s in m.subStreams
            lbl = s.title
            if not s.isText then lbl = lbl + " (burned in)"
            m.pickerRows.Push({ kind: "sub", index: s.index, label: lbl })
        end for
        lang = findLang()
        m.pickerRows.Push({ kind: "find", index: -2, label: "Find " + languageName(lang) + " subtitles" + Chr(8230) })
    end if
    m.pickIndex = 0
    for i = 0 to m.pickerRows.Count() - 1
        r = m.pickerRows[i]
        if (r.kind = "audio" and r.index = m.audioIndex) or (r.kind = "sub" and r.index = m.subIndex) then m.pickIndex = i
    end for
    m.pickerOpen = true
    m.hideTimer.control = "stop"
    paintSkip()
    drawPicker()
    m.picker.visible = true
    m.sink.setFocus(true)
end sub

sub closePicker()
    m.pickerOpen = false
    m.picker.visible = false
    restartHideTimer()
    paintSkip()
end sub

sub drawPicker()
    t = th()
    p = m.picker
    p.removeChildrenIndex(p.getChildCount(), 0)
    px = 1920 - 80 - 560
    makeBox(p, 560, 840, 24, t.panel, 0.96).translation = [px, 80]
    head = "Subtitles"
    if m.pickKind = "audio" then head = "Audio"
    if m.pickKind = "find" then head = "Find " + languageName(m.findLang) + " subtitles"
    makeTitle(p, head, 34).translation = [px + 40, 120]
    maxRows = 9
    first = 0
    if m.pickIndex > maxRows - 1 then first = m.pickIndex - (maxRows - 1)
    y = 200
    for i = first to m.pickerRows.Count() - 1
        if y < 860
            r = m.pickerRows[i]
            focused = (i = m.pickIndex)
            if focused then makeBox(p, 500, 64, 14, t.solid).translation = [px + 30, y]
            current = (r.kind = "audio" and r.index = m.audioIndex) or (r.kind = "sub" and r.index = m.subIndex)
            color = t.text
            if focused then color = t.onSolid
            if current
                tickColor = t.accent
                if focused then tickColor = t.onSolid
                makeIcon(p, "check", 28, tickColor).translation = [px + 50, y + 18]
            end if
            style = "regular"
            if focused then style = "semibold"
            lbl = makeLabel(p, r.label, 22, style, color)
            lbl.translation = [px + 96, y]
            lbl.width = 420
            lbl.height = 64
            lbl.vertAlign = "center"
            y = y + 72
        end if
    end for
end sub

sub pickerChoose()
    r = m.pickerRows[m.pickIndex]
    if r.kind = "find"
        findSubtitles()
        return
    else if r.kind = "remote"
        downloadSubtitle(r.id)
        return
    else if r.kind = "note"
        if not m.subBusy then openPicker("sub")
        return
    end if
    tp = m.global.trackPrefs
    if tp = invalid then tp = {}
    tp.set = true
    if r.kind = "audio"
        m.audioIndex = r.index
        s = findStream(m.audioStreams, r.index)
        if s <> invalid then tp.audioLang = s.lang
        m.global.trackPrefs = tp
        if m.playMethod = "DirectPlay"
            selectRokuAudio()
        else
            restartWithTracks()
            return
        end if
    else if r.kind = "sub"
        wasBurned = isImageSub(m.subIndex)
        m.subIndex = r.index
        if r.index = -1
            tp.subOff = true
            tp.subLang = ""
        else
            tp.subOff = false
            s = findStream(m.subStreams, r.index)
            if s <> invalid
                tp.subLang = s.lang
                tp.subForced = s.forced
            end if
        end if
        m.global.trackPrefs = tp
        ' Burned-in subtitles need the server to make a new stream.
        if isImageSub(r.index) or wasBurned
            restartWithTracks()
            return
        end if
        applySubtitle()
    end if
    closePicker()
    refreshTrackPills()
end sub

sub restartWithTracks()
    curPos = Int(m.video.position)
    reportStopped()
    m.video.control = "stop"
    closePicker()
    m.top.playItem = { itemId: m.itemId, startSeconds: curPos, audioIndex: m.audioIndex, subIndex: m.subIndex, restart: true }
end sub

' ---------- Finding subtitles ----------
' Jellyfin searches its subtitle plugins (such as Open Subtitles) for the
' playing title, downloads the chosen file next to the video, and adds it
' as a track. Playback then restarts where it was to load the new track.

' The language to search in: the Subtitles setting, else English.
function findLang() as string
    lang = safeStr(prefValue("subtitleLang", ""))
    if lang = "" then lang = "eng"
    return lang
end function

sub showSubNote(lines as object, busy as boolean)
    m.subBusy = busy
    m.pickerRows = []
    for each l in lines
        m.pickerRows.Push({ kind: "note", index: -3, label: l })
    end for
    m.pickIndex = 0
    drawPicker()
end sub

sub findSubtitles()
    m.pickKind = "find"
    m.findLang = findLang()
    showSubNote(["Searching" + Chr(8230)], true)
    apiRequest("/Items/" + m.itemId + "/RemoteSearch/Subtitles/" + m.findLang, {}, "onRemoteSubs", "GET", invalid, m.itemId)
end sub

sub onRemoteSubs(event as object)
    res = event.getData()
    if not m.pickerOpen or m.pickKind <> "find" or safeStr(res.tag) <> m.itemId then return
    if res.code = 401 or res.code = 403
        showSubNote(["Your Jellyfin account isn" + Chr(8217) + "t allowed", "to download subtitles."], false)
        return
    end if
    found = []
    if res.ok and type(res.data) = "roArray" then found = res.data
    if found.Count() = 0
        if res.ok
            showSubNote(["None found. Jellyfin needs a", "subtitle plugin, such as", "Open Subtitles, to search."], false)
        else
            showSubNote(["Couldn" + Chr(8217) + "t search (error " + res.code.ToStr() + ")."], false)
        end if
        return
    end if
    ' Exact matches for this file first, then the most downloaded.
    exact = []
    others = []
    ' Forced ones (only the odd foreign line) go last.
    forcedSubs = []
    for each s in found
        if Right(safeStr(s.Id), 7) = "-forced" or isTrue(s.IsForced)
            forcedSubs.Push(s)
        else if isTrue(s.IsHashMatch)
            exact.Push(s)
        else
            others.Push(s)
        end if
    end for
    others.SortBy("DownloadCount", "r")
    m.pickerRows = []
    for each s in exact
        m.pickerRows.Push({ kind: "remote", index: -3, id: safeStr(s.Id), label: "Exact match " + Chr(183) + " " + safeStr(s.Name) })
    end for
    for each s in others
        if m.pickerRows.Count() < 20 then m.pickerRows.Push({ kind: "remote", index: -3, id: safeStr(s.Id), label: safeStr(s.Name) })
    end for
    for each s in forcedSubs
        if m.pickerRows.Count() < 20 then m.pickerRows.Push({ kind: "remote", index: -3, id: safeStr(s.Id), label: "Forced " + Chr(183) + " " + safeStr(s.Name) })
    end for
    m.subBusy = false
    m.pickIndex = 0
    drawPicker()
end sub

sub downloadSubtitle(id as string)
    ' Count this language's tracks, to tell when the new one arrives.
    m.subsBefore = 0
    for each s in m.subStreams
        if s.lang = m.findLang then m.subsBefore = m.subsBefore + 1
    end for
    showSubNote(["Downloading" + Chr(8230)], true)
    apiRequest("/Items/" + m.itemId + "/RemoteSearch/Subtitles/" + id, {}, "onSubDownloaded", "POST", invalid, m.itemId)
end sub

sub onSubDownloaded(event as object)
    res = event.getData()
    if not m.pickerOpen or m.pickKind <> "find" or safeStr(res.tag) <> m.itemId then return
    if not res.ok
        showSubNote(["Couldn" + Chr(8217) + "t download it (error " + res.code.ToStr() + ").", "Try another."], false)
        return
    end if
    print "[Matinee] player: downloaded "; m.findLang; " subtitles for "; m.itemId
    m.subPolls = 0
    pollNewSub()
end sub

' Jellyfin adds the track once it has rescanned the title.
sub pollNewSub()
    showSubNote(["Adding the subtitles" + Chr(8230)], true)
    apiRequest("/Items/" + m.itemId, { "userId": m.global.userId, "Fields": "MediaStreams" }, "onSubPoll", "GET", invalid, m.itemId)
end sub

sub onSubPoll(event as object)
    res = event.getData()
    if not m.pickerOpen or m.pickKind <> "find" or safeStr(res.tag) <> m.itemId then return
    n = 0
    if res.ok and isValid(res.data) and isValid(res.data.MediaStreams)
        for each s in res.data.MediaStreams
            if safeStr(s.Type) = "Subtitle" and LCase(safeStr(s.Language)) = m.findLang then n = n + 1
        end for
    end if
    if n > m.subsBefore
        tp = m.global.trackPrefs
        if tp = invalid then tp = {}
        tp.set = true
        tp.subOff = false
        tp.subLang = m.findLang
        tp.subForced = false
        m.global.trackPrefs = tp
        m.subBusy = false
        ' Jellyfin lists downloaded subtitles first, which renumbers every
        ' other track, so the audio is found again by its language.
        audioLang = ""
        a = findStream(m.audioStreams, m.audioIndex)
        if a <> invalid then audioLang = a.lang
        curPos = Int(m.video.position)
        reportStopped()
        m.video.control = "stop"
        closePicker()
        m.top.playItem = { itemId: m.itemId, startSeconds: curPos, audioLang: audioLang, subLang: m.findLang, restart: true }
        return
    end if
    m.subPolls = m.subPolls + 1
    if m.subPolls >= 10
        showSubNote(["Downloaded. They" + Chr(8217) + "ll be in the list", "the next time you play this."], false)
        return
    end if
    if m.subPollTimer = invalid
        m.subPollTimer = m.top.CreateChild("Timer")
        m.subPollTimer.duration = 1.5
        m.subPollTimer.observeField("fire", "pollNewSub")
    end if
    m.subPollTimer.control = "start"
end sub

' ---------- Progress reporting ----------

function progressBody(paused as boolean) as object
    curPos = m.video.position
    if curPos < 1 then curPos = m.startSeconds
    ticks = Int(curPos) * 10000000&
    return {
        "ItemId": m.itemId,
        "MediaSourceId": m.mediaSourceId,
        "PlaySessionId": m.playSessionId,
        "PositionTicks": ticks,
        "IsPaused": paused,
        "PlayMethod": m.playMethod,
        "AudioStreamIndex": m.audioIndex,
        "SubtitleStreamIndex": m.subIndex,
        "CanSeek": true
    }
end function

sub onPosition()
    if not m.started then return
    curPos = m.video.position
    if m.osd.visible then updateBar()
    if Abs(curPos - m.lastReport) >= 10
        m.lastReport = curPos
        apiRequest("/Sessions/Playing/Progress", {}, "onIgnore", "POST", progressBody(false))
    end if
    inIntro = m.introStart >= 0 and curPos >= m.introStart and curPos < m.introEnd - 1
    if inIntro <> m.inIntro
        m.inIntro = inIntro
        ' Leaving the Intro (or seeking back before it) offers the skip again next time.
        if not inIntro and curPos < m.introStart then m.skipDismissed = false
        paintSkip()
    end if
    dur = m.video.duration
    if m.nextEp <> invalid and not m.upNextShown and not m.upNextCancelled and not m.pickerOpen and autoplayNext()
        ' Up next comes up when the end credits (the Outro) start, or 25 s
        ' before the end when the server doesn't know where they are.
        atOutro = m.outroStart > 0 and dur > 0 and m.outroStart > dur / 2 and curPos >= m.outroStart
        if dur > 120 and (atOutro or (dur - curPos) <= 25) then showUpNext()
    end if
end sub

function autoplayNext() as boolean
    return prefValue("autoplayNext", true) <> false
end function

sub onState()
    st = m.video.state
    if st = "paused"
        showSpinner(false)
        if m.started then apiRequest("/Sessions/Playing/Progress", {}, "onIgnore", "POST", progressBody(true))
        showOsd()
    else if st = "playing"
        m.status.visible = false
        showSpinner(false)
        if m.loadStart <> invalid
            print "[Matinee] player: playing after "; m.loadStart.TotalMilliseconds(); " ms at "; m.video.position; " s ("; m.playMethod; ")"
            m.loadStart = invalid
            subtitlesTip()
            launchComplete()
        end if
        if m.osd.visible then paintOsd()
        restartHideTimer()
    else if st = "buffering"
        showSpinner(true)
    else if st = "finished"
        if m.nextEp <> invalid and not m.upNextCancelled and autoplayNext()
            playNext()
        else
            reportStopped()
            m.top.navigate = { action: "back" }
        end if
    else if st = "error"
        showStatus("Playback failed: " + safeStr(m.video.errorMsg) + Chr(10) + "Press Back to return.")
    end if
end sub

' Roku TVs keep * for their own picture and sound menu during video, so
' the first time a TV plays something, say how to reach subtitles instead.
sub subtitlesTip()
    if readSetting("subtitlesTipShown") <> "" then return
    if CreateObject("roDeviceInfo").GetModelType() <> "TV" then return
    writeSetting("subtitlesTipShown", "true")
    showToast("For subtitles, press Down twice, then choose Subtitles", "subtitles", th().tipSeconds, "top")
end sub

sub reportStopped()
    if not m.started or m.stopped then return
    m.stopped = true
    apiRequest("/Sessions/Playing/Stopped", {}, "onIgnore", "POST", progressBody(false))
    m.global.watchVersion = m.global.watchVersion + 1
end sub

' ---------- Up next at the end of an episode ----------

sub showUpNext()
    t = th()
    m.upNextShown = true
    m.countLeft = 10
    ' A small card: the next episode's picture with the countdown as a bar
    ' filling along its bottom edge, then its name and the keys.
    cardW = 360
    pad = 12
    picW = cardW - pad * 2
    picH = picW * 9 \ 16
    cardH = pad + picH + 14 + 26 + 4 + 22 + pad
    g = m.upNext
    g.removeChildrenIndex(g.getChildCount(), 0)
    g.translation = [1920 - 80 - cardW, 1080 - 80 - cardH]
    makeBox(g, cardW, cardH, 18, t.panel, 0.94)
    makeBox(g, picW, picH, 10, t.raised).translation = [pad, pad]
    pic = g.CreateChild("Poster")
    pic.translation = [pad, pad]
    pic.width = picW
    pic.height = picH
    pic.loadWidth = picW
    pic.loadHeight = picH
    pic.loadDisplayMode = "scaleToZoom"
    pic.uri = imageUrl(safeStr(m.nextEp.Id), "Primary", 640)
    track = g.CreateChild("Rectangle")
    track.translation = [pad, pad + picH - 6]
    track.width = picW
    track.height = 6
    track.color = t.barBg
    fill = g.CreateChild("Rectangle")
    fill.id = "upFill"
    fill.translation = [pad, pad + picH - 6]
    fill.width = 0
    fill.height = 6
    fill.color = t.accent
    makeShape(g, "pkg:/images/corners_r10.9.png", picW, picH, t.panel, 0.94).translation = [pad, pad]
    y = pad + picH + 14
    title = makeLabel(g, "Up next " + Chr(183) + " " + m.nextTitle.text, 20, "semibold", t.text)
    title.translation = [pad + 4, y]
    title.width = picW - 8
    hint = makeLabel(g, "OK plays now " + Chr(183) + " Back keeps watching", 16, "regular", t.muted)
    hint.translation = [pad + 4, y + 30]
    hint.width = picW - 8
    ' The bar fills over the countdown.
    anim = g.CreateChild("Animation")
    anim.duration = m.countLeft
    anim.easeFunction = "linear"
    interp = anim.CreateChild("FloatFieldInterpolator")
    interp.key = [0.0, 1.0]
    interp.keyValue = [0.0, picW * 1.0]
    interp.fieldToInterp = "upFill.width"
    g.visible = true
    paintSkip()
    anim.control = "start"
    m.countdown.control = "start"
    m.sink.setFocus(true)
end sub

sub onTick()
    m.countLeft = m.countLeft - 1
    if m.countLeft <= 0 then playNext()
end sub

sub playNext()
    m.countdown.control = "stop"
    nxt = m.nextEp
    if nxt = invalid then return
    reportStopped()
    m.video.control = "stop"
    m.upNext.visible = false
    m.osd.visible = false
    m.top.playItem = { itemId: safeStr(nxt.Id), startSeconds: 0 }
end sub

sub cancelUpNext()
    m.upNextCancelled = true
    m.countdown.control = "stop"
    m.upNext.visible = false
end sub

' ---------- Focus, keys, closing ----------

sub onFocusChanged()
    if m.top.hasFocus() then m.sink.setFocus(true)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press
        ' Letting go of a held Left or Right ends its scrub there.
        if key = m.holdKey
            held = m.scrubLevel > 0
            m.holdTimer.control = "stop"
            m.holdKey = ""
            if held then stopScrub(true)
            return held
        end if
        return false
    end if
    ' A held key repeats its press; the hold (and its scrub) carries on.
    if (key = "left" or key = "right") and key = m.holdKey and not m.pickerOpen then return true
    if m.scrubLevel > 0 and not m.pickerOpen
        if key = "fastforward"
            startScrub(1)
        else if key = "rewind"
            startScrub(-1)
        else if key = "back"
            stopScrub(false)
        else
            stopScrub(true)
        end if
        return true
    end if
    if m.pickerOpen
        if key = "up"
            if m.pickIndex > 0 then m.pickIndex = m.pickIndex - 1
            drawPicker()
        else if key = "down"
            if m.pickIndex < m.pickerRows.Count() - 1 then m.pickIndex = m.pickIndex + 1
            drawPicker()
        else if key = "OK"
            pickerChoose()
        else if (key = "back" or key = "left") and m.pickKind = "find"
            ' Back from a search returns to the Subtitles list.
            m.subBusy = false
            openPicker("sub")
        else if key = "back" or key = "options" or key = "left"
            closePicker()
        end if
        return true
    end if
    if m.upNext.visible
        if key = "OK" or key = "play"
            playNext()
            return true
        else if key = "back"
            cancelUpNext()
            return true
        end if
    end if
    if key = "back"
        ' First Back hides the OSD (or Skip intro); the next leaves.
        if m.osd.visible
            closeOsd()
            return true
        end if
        if m.skipLayer.visible
            m.skipDismissed = true
            paintSkip()
            return true
        end if
        return false
    end if
    if key = "OK" and not m.osd.visible and m.skipLayer.visible
        skipIntro()
        return true
    end if
    if key = "options"
        openPicker("sub")
        return true
    else if key = "play"
        togglePause()
        return true
    else if key = "rewind"
        startScrub(-1)
        return true
    else if key = "fastforward"
        startScrub(1)
        return true
    end if
    ' Holding Left or Right on the seek bar (or with no OSD) scrubs.
    if (key = "left" or key = "right") and (not m.osd.visible or m.zone = "seek")
        m.holdKey = key
        m.holdTimer.control = "stop"
        m.holdTimer.control = "start"
    end if
    if not m.osd.visible
        ' The first press only brings up the OSD, except for seeking.
        if key = "left"
            seekBy(-10)
        else if key = "right"
            seekBy(10)
        else
            showOsd()
        end if
        return true
    end if
    restartHideTimer()
    if m.zone = "header"
        if key = "OK"
            m.top.navigate = { action: "back" }
        else if key = "down"
            m.zone = "seek"
            if m.skipLayer.visible then m.zone = "skip"
            paintOsd()
        end if
        return true
    else if m.zone = "seek"
        if key = "left"
            seekBy(-10)
        else if key = "right"
            seekBy(10)
        else if key = "OK"
            togglePause()
        else if key = "up"
            m.zone = "header"
            if m.skipLayer.visible then m.zone = "skip"
            paintOsd()
        else if key = "down"
            m.zone = "controls"
            paintOsd()
        end if
        return true
    else if m.zone = "skip"
        if key = "OK"
            skipIntro()
        else if key = "up"
            m.zone = "header"
            paintOsd()
        else if key = "down"
            m.zone = "seek"
            paintOsd()
        end if
        return true
    else if m.zone = "controls"
        if key = "left"
            moveControl(-1)
        else if key = "right"
            moveControl(1)
        else if key = "OK"
            doControl(m.ctlIndex)
        else if key = "up"
            m.zone = "seek"
            paintOsd()
        end if
        return true
    end if
    return false
end function

sub onClosed()
    if not m.top.closed then return
    m.countdown.control = "stop"
    m.hideTimer.control = "stop"
    m.scrubTimer.control = "stop"
    m.holdTimer.control = "stop"
    ' A warm-up still running must not start the video after leaving.
    m.pendingContent = invalid
    m.warmToken = ""
    showSpinner(false)
    reportStopped()
    m.video.control = "stop"
end sub
