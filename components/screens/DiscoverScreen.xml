<?xml version="1.0" encoding="utf-8" ?>
<!-- Discover: trending and popular titles from Seerr, ready to Request. -->
<component name="DiscoverScreen" extends="Group">
  <interface>
    <field id="begin" type="boolean" onChange="load" />
    <field id="refresh" type="boolean" alwaysNotify="true" onChange="onRefresh" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="DiscoverScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/TrailerHost.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/MenuHost.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/HeroHost.bs" />
  <children>
    <Group id="heroLayer" />
    <Group id="signInBox" visible="false" />
    <Label id="status" wrap="true" text="Loading...">
      <Font role="font" uri="font:SystemFontFile" size="34" />
    </Label>
    <RowList
      id="rows"
      itemComponentName="CardItem"
      numRows="4"
      drawFocusFeedback="false"
      vertFocusAnimationStyle="fixedFocus"
      rowFocusAnimationStyle="floatingFocus"
      showRowLabel="[true]"
      rowLabelOffset="[[0,14]]"
      visible="false" />
  </children>
</component>
