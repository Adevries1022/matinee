<?xml version="1.0" encoding="utf-8" ?>
<!-- Discover (Seerr): browse what to request. A Hero for the Focused title
     and Rows: trending, popular, coming soon, streaming services and
     genres. Services and genres open a DiscoverCategoryScreen. -->
<component name="DiscoverScreen" extends="Group">
  <interface>
    <field id="refresh" type="boolean" alwaysNotify="true" onChange="onRefresh" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="DiscoverScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/MenuHost.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/DiscoverHost.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ratings.bs" />
  <children>
    <Group id="heroLayer" />
    <RowList
      id="rows"
      itemComponentName="CardItem"
      numRows="3"
      drawFocusFeedback="false"
      vertFocusAnimationStyle="fixedFocus"
      rowFocusAnimationStyle="floatingFocus"
      showRowLabel="[true]"
      visible="false" />
    <Group id="empty" visible="false" />
    <Group id="sink" focusable="true" />
  </children>
</component>
