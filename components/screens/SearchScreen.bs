' Search (the Search board): a query field with an Accent border, a 6-column
' A-Z / 0-9 key grid with Space, Delete and Clear, and results in three
' columns. Under the keys, up to three Suggestions finish what's being typed
' (the top one also shows faintly in the field); OK on one searches for it.
' With no query it shows "Popular right now". Titles that aren't on
' the server but can be requested through Seerr come after library matches.

sub init()
    t = th()
    m.layer = m.top.findNode("layer")
    m.grid = m.top.findNode("grid")
    m.sink = m.top.findNode("sink")
    m.debounce = m.top.findNode("debounce")

    ' Query field
    field = m.layer.CreateChild("Group")
    field.translation = [160, 96]
    makeBox(field, 520, 80, 16, t.panel)
    makeOutline(field, 520, 80, 16, t.accent)
    makeIcon(field, "search", 30, t.idle).translation = [24, 25]
    m.queryLabel = makeLabel(field, "", 30, "medium", t.faint)
    m.queryLabel.translation = [70, 0]
    m.queryLabel.width = 430
    m.queryLabel.height = 80
    m.queryLabel.vertAlign = "center"
    ' The rest of the top Suggestion, faint, right after what's typed.
    m.ghost = makeLabel(field, "", 30, "medium", t.faint)
    m.ghost.height = 80
    m.ghost.vertAlign = "center"

    ' Keys: 36 characters in 6 columns, then Space, Delete and Clear.
    m.keys = []
    chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
    for i = 0 to 35
        k = makeKey(Mid(chars, i + 1, 1), "", 80, 160 + (i mod 6) * 88, 204 + (i \ 6) * 80)
        m.keys.Push(k)
    end for
    m.keys.Push(makeKey("Space", "", 168, 160, 708))
    m.keys.Push(makeKey("", "backspace", 168, 336, 708))
    m.keys.Push(makeKey("Clear", "", 168, 512, 708))

    ' Suggestions: up to three titles that finish what's being typed.
    m.sugRows = []
    for i = 0 to 2
        g = m.layer.CreateChild("Group")
        g.translation = [160, 804 + i * 72]
        bg = makeBox(g, 520, 60, 12, t.raised)
        ic = makeIcon(g, "search", 22, t.muted)
        ic.translation = [20, 19]
        lbl = makeLabel(g, "", 22, "regular", t.heading)
        lbl.translation = [56, 0]
        lbl.width = 444
        lbl.height = 60
        lbl.vertAlign = "center"
        g.visible = false
        m.sugRows.Push({ group: g, bg: bg, icon: ic, label: lbl })
    end for

    ' Results
    m.heading = makeLabel(m.layer, "Popular right now", 30, "semibold", t.heading)
    m.heading.translation = [760, 96]
    m.heading.width = 1080
    m.heading.height = 80
    m.heading.vertAlign = "center"
    m.grid.translation = [760 - t.cellPadX, 204 - t.cellPadY]
    m.grid.itemSize = [340 + t.cellPadX * 2, 191 + t.cellPadY * 2]
    m.grid.itemSpacing = [30 - t.cellPadX * 2, 30 - t.cellPadY * 2]
    m.empty = m.layer.CreateChild("Group")
    m.empty.translation = [760, 204]
    makePanel(m.empty, 1080, 170, 18)
    et = makeLabel(m.empty, "Nothing matches that yet", 28, "semibold", t.text)
    et.translation = [48, 44]
    eb = makeLabel(m.empty, "Try a different title, or search by genre like " + Chr(8220) + "drama" + Chr(8221) + " or " + Chr(8220) + "mystery" + Chr(8221) + ".", 22, "regular", t.muted)
    eb.translation = [48, 92]
    eb.width = 984
    m.empty.visible = false

    m.debounce.observeField("fire", "doSearch")
    m.grid.observeField("itemSelected", "onSelected")
    m.top.observeField("focusedChild", "onFocusChanged")

    m.query = ""
    m.searched = "-"
    m.keyIndex = 0
    m.zone = "keys"
    m.libItems = []
    m.seerrItems = []
    m.flat = []
    m.suggestions = []
    m.sugIndex = 0
    m.jumpToResults = false
    setupMenu("search")
    setupOptions()
    showQuery()
    paintKeys()
    doSearch()
end sub

function makeKey(text as string, iconName as string, w as integer, x as integer, y as integer) as object
    t = th()
    g = m.layer.CreateChild("Group")
    g.translation = [x, y]
    bg = makeBox(g, w, 72, 12, t.raised)
    lbl = invalid
    ic = invalid
    if iconName <> ""
        ic = makeIcon(g, iconName, 30, t.heading)
        ic.translation = [(w - 30) \ 2, 21]
    else
        size = 26
        if Len(text) > 1 then size = 22
        lbl = makeLabel(g, text, size, "semibold", t.heading)
        lbl.width = w
        lbl.height = 72
        lbl.horizAlign = "center"
        lbl.vertAlign = "center"
    end if
    return { bg: bg, label: lbl, icon: ic, text: text }
end function

sub paintKeys()
    t = th()
    for i = 0 to m.keys.Count() - 1
        k = m.keys[i]
        focused = (m.zone = "keys" and i = m.keyIndex)
        fg = t.heading
        if focused
            k.bg.blendColor = t.solid
            fg = t.onSolid
        else
            k.bg.blendColor = t.raised
        end if
        if k.label <> invalid then k.label.color = fg
        if k.icon <> invalid then k.icon.blendColor = fg
    end for
end sub

sub showQuery()
    t = th()
    if m.query = ""
        m.queryLabel.text = "Titles, genres"
        m.queryLabel.color = t.faint
    else
        m.queryLabel.text = m.query
        m.queryLabel.color = t.text
    end if
    showGhost()
end sub

' The top Suggestion's remaining letters, when it starts with the query.
sub showGhost()
    m.ghost.text = ""
    q = m.query
    if q = "" or m.suggestions.Count() = 0 then return
    s = m.suggestions[0]
    if Len(s) <= Len(q) or LCase(Left(s, Len(q))) <> LCase(q) then return
    x = 70 + measureText(q, 30, "medium")
    if Right(q, 1) = " " then x = x + measureText("a a", 30, "medium") - measureText("aa", 30, "medium")
    if x >= 500 then return
    m.ghost.translation = [x, 0]
    m.ghost.width = 500 - x
    m.ghost.text = Mid(s, Len(q) + 1)
end sub

' Titles from the results that best finish the query: those starting with
' it first, then those with a word starting with it, then the rest.
sub makeSuggestions()
    m.suggestions = []
    q = LCase(m.searched)
    if q = "" then return
    tiers = [[], [], []]
    seen = {}
    for each c in m.flat
        title = safeStr(c.title)
        low = LCase(title)
        if title <> "" and low <> q and not seen.DoesExist(low)
            seen[low] = true
            if Left(low, Len(q)) = q
                tiers[0].Push(title)
            else if Instr(1, " " + low, " " + q) > 0
                tiers[1].Push(title)
            else
                tiers[2].Push(title)
            end if
        end if
    end for
    for each tier in tiers
        for each title in tier
            if m.suggestions.Count() < m.sugRows.Count() then m.suggestions.Push(title)
        end for
    end for
end sub

sub paintSuggestions()
    t = th()
    for i = 0 to m.sugRows.Count() - 1
        r = m.sugRows[i]
        r.group.visible = i < m.suggestions.Count()
        if r.group.visible
            r.label.text = m.suggestions[i]
            if m.zone = "suggest" and i = m.sugIndex
                r.bg.blendColor = t.solid
                r.label.color = t.onSolid
                r.icon.blendColor = t.onSolid
            else
                r.bg.blendColor = t.raised
                r.label.color = t.heading
                r.icon.blendColor = t.muted
            end if
        end if
    end for
end sub

' Search for the chosen Suggestion, then move to its results.
sub pickSuggestion()
    if m.sugIndex >= m.suggestions.Count() then return
    m.query = LCase(m.suggestions[m.sugIndex])
    m.jumpToResults = true
    m.debounce.control = "stop"
    showQuery()
    doSearch()
end sub

sub pressKey()
    if m.keyIndex < 36
        if Len(m.query) < 24 then m.query = m.query + LCase(m.keys[m.keyIndex].text)
    else if m.keyIndex = 36
        if m.query <> "" and Right(m.query, 1) <> " " then m.query = m.query + " "
    else if m.keyIndex = 37
        if m.query <> "" then m.query = Left(m.query, Len(m.query) - 1)
    else
        m.query = ""
    end if
    showQuery()
    m.debounce.control = "stop"
    m.debounce.control = "start"
end sub

' Move around the key grid: 6 rows of 6, then a row of 3 wide keys.
sub moveKey(key as string)
    i = m.keyIndex
    if i < 36
        row = i \ 6
        col = i mod 6
        if key = "left"
            if col = 0
                openMenu()
                return
            end if
            i = i - 1
        else if key = "right"
            if col = 5
                if m.flat.Count() > 0 then setZone("grid")
                return
            end if
            i = i + 1
        else if key = "up"
            if row > 0 then i = i - 6
        else if key = "down"
            if row < 5
                i = i + 6
            else
                i = 36 + col \ 2
            end if
        end if
    else
        col = i - 36
        if key = "left"
            if col = 0
                openMenu()
                return
            end if
            i = i - 1
        else if key = "right"
            if col = 2
                if m.flat.Count() > 0 then setZone("grid")
                return
            end if
            i = i + 1
        else if key = "up"
            i = 30 + col * 2
        else if key = "down"
            if m.suggestions.Count() > 0
                m.sugIndex = 0
                setZone("suggest")
            end if
            return
        end if
    end if
    m.keyIndex = i
    paintKeys()
end sub

' ---------- Searching ----------

sub doSearch()
    q = m.query.Trim()
    if q = m.searched then return
    m.searched = q
    m.seerrItems = []
    if q = ""
        apiRequest("/Items", { "userId": m.global.userId, "Recursive": "true", "IncludeItemTypes": "Movie,Series", "SortBy": "PlayCount,CommunityRating", "SortOrder": "Descending", "Limit": "18", "Fields": "Genres,ChildCount", "EnableTotalRecordCount": "false" }, "onResults", "GET", invalid, q)
        return
    end if
    apiRequest("/Items", { "userId": m.global.userId, "searchTerm": q, "Recursive": "true", "IncludeItemTypes": "Movie,Series", "Limit": "36", "Fields": "Genres,ChildCount", "EnableTotalRecordCount": "false" }, "onResults", "GET", invalid, q)
    if m.global.seerrState = "ready"
        seerrRequest("/search", { "query": q, "page": "1" }, "onSeerrResults", "GET", invalid, q)
    end if
end sub

sub onResults(event as object)
    res = event.getData()
    if safeStr(res.tag) <> m.searched then return
    m.libItems = []
    if res.ok and isValid(res.data)
        if isValid(res.data.Items) then m.libItems = res.data.Items
    end if
    render()
end sub

sub onSeerrResults(event as object)
    res = event.getData()
    if safeStr(res.tag) <> m.searched then return
    m.seerrItems = []
    if res.ok and isValid(res.data)
        if isValid(res.data.results)
            for each r in res.data.results
                mt = safeStr(r.mediaType)
                ' Titles already fully on the server show up above.
                if (mt = "movie" or mt = "tv") and seerrStatus(r) <> 5 then m.seerrItems.Push(r)
            end for
        end if
    else if res.code = 401 or res.code = 403
        m.top.navigate = { action: "seerrSignedOut" }
    end if
    render()
end sub

sub render()
    root = CreateObject("roSGNode", "ContentNode")
    m.flat = []
    for each it in m.libItems
        c = itemToContent(it, true)
        c.cardW = 340
        c.cardH = 191
        c.subtitle = c.genre
        root.appendChild(c)
        m.flat.Push(c)
    end for
    for each r in m.seerrItems
        c = seerrToContent(r)
        c.HDPosterUrl = tmdbImage(r.backdropPath, "w500")
        c.cardW = 340
        c.cardH = 191
        c.subtitle = "Not on your server " + Chr(183) + " Request it"
        root.appendChild(c)
        m.flat.Push(c)
    end for
    q = m.searched
    n = m.flat.Count()
    if q = ""
        m.heading.text = "Popular right now"
    else if n = 1
        m.heading.text = "1 result for " + Chr(8220) + q + Chr(8221)
    else
        m.heading.text = n.ToStr() + " results for " + Chr(8220) + q + Chr(8221)
    end if
    m.grid.content = root
    m.grid.visible = n > 0
    m.empty.visible = (n = 0 and q <> "")
    makeSuggestions()
    if m.sugIndex >= m.suggestions.Count() then m.sugIndex = 0
    showGhost()
    if m.jumpToResults and n > 0
        m.jumpToResults = false
        setZone("grid")
    else if (n = 0 and m.zone = "grid") or (m.suggestions.Count() = 0 and m.zone = "suggest")
        setZone("keys")
    else
        paintSuggestions()
    end if
end sub

sub onSelected(event as object)
    i = event.getData()
    if i < 0 or i >= m.flat.Count() then return
    optionsCardPressed(m.flat[i])
end sub

' A short OK press opens the title; holding OK opens Title Options.
sub cardTapped(c as object)
    if Left(c.itemType, 6) = "seerr-"
        m.top.navigate = seerrNav(c)
    else
        m.top.navigate = { action: "details", itemId: c.itemId }
    end if
end sub

' Results don't show watched or My List state, so there's nothing to redraw.
sub titleChanged(_change as object)
end sub

' ---------- Focus ----------

sub setZone(zone as string)
    m.zone = zone
    paintKeys()
    paintSuggestions()
    restoreContentFocus()
end sub

sub restoreContentFocus()
    if m.zone = "grid" and m.grid.visible
        m.grid.setFocus(true)
    else if m.zone = "suggest" and m.suggestions.Count() > 0
        m.sink.setFocus(true)
    else
        m.zone = "keys"
        m.sink.setFocus(true)
    end if
end sub

sub onFocusChanged()
    if m.top.hasFocus() and not menuIsOpen() then restoreContentFocus()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if optionsKey(key, press) then return true
    if not press or menuIsOpen() then return false
    if m.zone = "keys"
        if key = "OK"
            pressKey()
            return true
        else if key = "left" or key = "right" or key = "up" or key = "down"
            moveKey(key)
            return true
        else if key = "replay"
            m.keyIndex = 37
            pressKey()
            return true
        end if
        return false
    end if
    if m.zone = "suggest"
        if key = "OK"
            pickSuggestion()
        else if key = "up"
            if m.sugIndex > 0
                m.sugIndex = m.sugIndex - 1
                paintSuggestions()
            else
                m.keyIndex = 37
                setZone("keys")
            end if
        else if key = "down"
            if m.sugIndex < m.suggestions.Count() - 1 then m.sugIndex = m.sugIndex + 1
            paintSuggestions()
        else if key = "right"
            if m.flat.Count() > 0 then setZone("grid")
        else if key = "left"
            openMenu()
        else if key = "back"
            setZone("keys")
        else if key = "replay"
            m.keyIndex = 37
            setZone("keys")
            pressKey()
        else
            return false
        end if
        return true
    end if
    ' In the results: Left from the first column goes back to the keys.
    if key = "options"
        i = m.grid.itemFocused
        if i >= 0 and i < m.flat.Count() then openOptions(m.flat[i], "row")
        return true
    else if key = "left"
        setZone("keys")
        return true
    else if key = "back"
        setZone("keys")
        return true
    end if
    return false
end function
