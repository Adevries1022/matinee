' Sign in (step 2 of setup), laid out like the Connect board: the person
' on the left, a Quick Connect code on the right, and a password button.
sub init()
    t = th()
    m.layer = m.top.findNode("layer")
    m.codeHost = m.top.findNode("codeHost")
    makeWordmark(m.layer).translation = [160, 64]
    m.steps = makeSteps(m.layer, 2, 1760, 70)
    m.avatar = m.layer.CreateChild("Group")
    m.avatar.translation = [160, 200]
    m.nameLabel = makeTitle(m.layer, "", 56)
    m.nameLabel.translation = [160, 392]
    m.nameLabel.width = 600
    m.nameLabel.wrap = true
    m.instr = makeLabel(m.layer, "", 24, "regular", t.meta)
    m.instr.translation = [160, 540]
    m.instr.width = 600
    m.instr.wrap = true
    m.instr.lineSpacing = 10

    makePanel(m.layer, 880, 760, 24).translation = [880, 200]
    makeLabel(m.layer, "Quick Connect", 30, "semibold", t.text).translation = [936, 256]
    m.qcIntro = makeLabel(m.layer, "On your phone or computer, open Jellyfin, go to Quick Connect in your user menu and enter:", 22, "regular", t.meta)
    m.qcIntro.translation = [936, 312]
    m.qcIntro.width = 768
    m.qcIntro.wrap = true
    m.qcIntro.lineSpacing = 10
    m.codeHost.translation = [936, 420]
    sg = m.layer.CreateChild("Group")
    sg.translation = [936, 576]
    makeShape(sg, "pkg:/images/circle.png", 10, 10, t.accent).translation = [0, 11]
    m.status = makeLabel(sg, "", 20, "regular", t.muted)
    m.status.translation = [22, 0]
    m.status.width = 740
    m.status.wrap = true
    m.pwBtn = makeBtn(m.layer, { kind: "primary", icon: "user", text: "Use password instead", size: 22, padX: 32 })
    m.pwBtn.group.translation = [936, 680]
    paintBtn(m.pwBtn, true)

    m.poll = m.top.findNode("poll")
    m.poll.observeField("fire", "onPoll")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.panel = invalid
    m.secret = ""
    m.triedGet = false
    m.done = false
    m.isSeerr = false
    showCode("")
end sub

sub showCode(code as string)
    t = th()
    m.codeHost.removeChildrenIndex(m.codeHost.getChildCount(), 0)
    for i = 0 to 5
        g = m.codeHost.CreateChild("Group")
        g.translation = [i * 110, 0]
        makeBox(g, 96, 120, 16, t.bg)
        makeOutline(g, 96, 120, 16, t.line)
        d = makeLabel(g, Mid(code, i + 1, 1), 64, "display", t.text)
        d.width = 96
        d.height = 120
        d.horizAlign = "center"
        d.vertAlign = "center"
    end for
end sub

sub start()
    u = m.top.user
    m.avatar.removeChildrenIndex(m.avatar.getChildCount(), 0)
    m.avatar.appendChild(makeAvatar(safeStr(u.id), safeStr(u.name), safeStr(u.imageTag), 160))
    m.nameLabel.text = "Sign in as " + safeStr(u.name)
    m.instr.text = "Approve this TV from your phone with Quick Connect, or use your password."
    showCode("")
    m.isSeerr = (m.top.mode = "seerr")
    if m.isSeerr
        m.steps.visible = false
        m.nameLabel.text = "Sign in to Seerr"
        m.instr.text = "Seerr uses your Jellyfin account (" + safeStr(u.name) + "), so your requests are yours."
        m.status.text = "Starting Quick Connect..."
        initiate()
        return
    end if

    ' Accounts without a password sign in with one press.
    if safeStr(u.id) <> "" and not isTrue(u.hasPassword)
        m.status.text = "Signing in..."
        passwordAuth("")
        return
    end if
    m.status.text = "Starting Quick Connect..."
    apiRequest("/QuickConnect/Enabled", {}, "onQcEnabled")
end sub

' ---------- Quick Connect ----------

sub onQcEnabled(event as object)
    res = event.getData()
    enabled = false
    if res.ok then enabled = isTrue(res.data)
    if enabled
        initiate()
    else
        m.status.text = "Quick Connect is turned off on this server, so sign in with your password. An Administrator can turn it on in the Jellyfin dashboard."
        openPassword()
    end if
end sub

sub initiate()
    if m.isSeerr
        seerrRequest("/auth/jellyfin/quickconnect/initiate", {}, "onInitiate", "POST")
    else
        apiRequest("/QuickConnect/Initiate", {}, "onInitiate", "POST")
    end if
end sub

sub onInitiate(event as object)
    res = event.getData()
    ' Older Jellyfin servers start Quick Connect with GET instead of POST.
    if not m.isSeerr and not res.ok and not m.triedGet and (res.code = 404 or res.code = 405)
        m.triedGet = true
        apiRequest("/QuickConnect/Initiate", {}, "onInitiate", "GET")
        return
    end if
    if res.ok and isValid(res.data)
        if isValid(res.data.Code) and isValid(res.data.Secret)
            m.secret = safeStr(res.data.Secret)
            showCode(safeStr(res.data.Code))
            m.status.text = "Waiting for approval"
            m.poll.control = "start"
            return
        end if
    end if
    m.status.text = "Couldn" + Chr(8217) + "t start Quick Connect. Sign in with your password instead."
    openPassword()
end sub

sub onPoll()
    if m.secret = "" or m.done then return
    if m.isSeerr
        seerrRequest("/auth/jellyfin/quickconnect/check", { "secret": m.secret }, "onPollResult")
    else
        apiRequest("/QuickConnect/Connect", { "secret": m.secret }, "onPollResult")
    end if
end sub

sub onPollResult(event as object)
    if m.done then return
    res = event.getData()
    if res.ok and isValid(res.data)
        if isTrue(res.data.Authenticated)
            m.poll.control = "stop"
            m.status.text = "Approved. Signing in..."
            if m.isSeerr
                seerrRequest("/auth/jellyfin/quickconnect/authenticate", {}, "onAuth", "POST", { "secret": m.secret })
            else
                apiRequest("/Users/AuthenticateWithQuickConnect", {}, "onAuth", "POST", { "Secret": m.secret })
            end if
        end if
    else if res.code = 404 or res.code = 401
        ' The code expired; get a fresh one.
        m.poll.control = "stop"
        m.secret = ""
        m.triedGet = false
        initiate()
    end if
end sub

' ---------- Password ----------

sub openPassword()
    if m.panel <> invalid or m.done then return
    p = CreateObject("roSGNode", "TextEntryPanel")
    p.title = "Password for " + safeStr(m.top.user.name)
    p.hint = "Leave it blank if this account doesn't have a password."
    p.buttonText = "Sign In"
    p.secure = true
    p.text = ""
    p.observeField("submitted", "onPassword")
    p.observeField("cancelled", "closePanel")
    m.top.appendChild(p)
    m.panel = p
    p.setFocus(true)
end sub

sub onPassword()
    pw = m.panel.submitted
    closePanel()
    m.status.text = "Signing in..."
    passwordAuth(pw)
end sub

sub closePanel()
    if m.panel = invalid then return
    m.top.removeChild(m.panel)
    m.panel = invalid
    m.top.setFocus(true)
end sub

sub passwordAuth(pw as string)
    if m.isSeerr
        seerrRequest("/auth/jellyfin", {}, "onAuth", "POST", { "username": safeStr(m.top.user.name), "password": pw })
    else
        apiRequest("/Users/AuthenticateByName", {}, "onAuth", "POST", { "Username": safeStr(m.top.user.name), "Pw": pw })
    end if
end sub

' ---------- Result ----------

sub onAuth(event as object)
    res = event.getData()
    if m.isSeerr
        if res.ok and res.cookie <> ""
            m.done = true
            m.poll.control = "stop"
            m.top.navigate = { action: "seerrAuthenticated", cookie: res.cookie }
            return
        end if
        if res.code = 403
            m.status.text = "Seerr didn't allow this account. An administrator may need to import it in Seerr's Users page."
        else if res.code = 401
            m.status.text = "That didn't work. Check the password and try again."
        else
            m.status.text = "Seerr sign-in failed (error " + res.code.ToStr() + ")."
        end if
        if m.secret <> "" then m.poll.control = "start"
        return
    end if
    if res.ok and isValid(res.data)
        if isValid(res.data.AccessToken) and isValid(res.data.User)
            m.done = true
            m.poll.control = "stop"
            usr = res.data.User
            m.top.navigate = {
                action: "authenticated",
                token: safeStr(res.data.AccessToken),
                userId: safeStr(usr.Id),
                userName: safeStr(usr.Name),
                imageTag: safeStr(usr.PrimaryImageTag),
                isAdmin: isAdminUser(usr)
            }
            return
        end if
    end if
    if res.code = 401
        m.status.text = "That didn't work. Check the password and try again."
    else
        m.status.text = "Sign-in failed (error " + res.code.ToStr() + ")."
    end if
    if m.secret <> "" then m.poll.control = "start"
end sub

' ---------- Focus, keys, closing ----------

sub onFocusChanged()
    if m.top.hasFocus() and m.panel <> invalid then m.panel.setFocus(true)
end sub

sub onClosed()
    if m.top.closed
        m.done = true
        m.poll.control = "stop"
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.panel <> invalid then return false
    if key = "OK" or key = "play"
        openPassword()
        return true
    end if
    return false
end function

function isAdminUser(usr as object) as boolean
    if not isValid(usr.Policy) then return false
    return isTrue(usr.Policy.IsAdministrator)
end function
