' A movie or show, laid out like the Detail board: artwork on the right
' two-thirds, a back pill, eyebrow, title, meta, blurb and buttons on the
' left; then season pills and episode Cards for shows, or "More like this"
' for movies. Focus zones: back, buttons, seasons, cards.

sub init()
    t = th()
    m.art = m.top.findNode("art")
    m.layer = m.top.findNode("layer")
    m.cards = m.top.findNode("cards")
    m.sink = m.top.findNode("sink")
    m.fadeIn = m.top.findNode("fadeIn")
    m.x = 120

    makeFade(m.layer, "detail", 1920, 1080)
    m.back = makeBackPill(m.layer, m.top.backLabel)

    m.eyebrow = makeLabel(m.layer, "", 18, "semibold", t.accent)
    m.eyebrow.translation = [m.x, 176]
    m.eyebrow.height = 22
    m.eyebrow.vertAlign = "center"
    m.title = makeLabel(m.layer, "", 96, "display", t.text)
    m.title.translation = [m.x, 206]
    m.title.width = 1100
    m.title.height = 110
    m.title.vertAlign = "center"
    m.logoBox = [m.x, 204, t.detailLogoW, t.detailLogoH]
    m.logo = makeLogo(m.layer)
    m.logo.observeField("loadStatus", "onLogoStatus")
    m.metaHost = m.layer.CreateChild("Group")
    m.metaHost.translation = [m.x, 330]
    m.blurb = makeLabel(m.layer, "", 24, "regular", t.soft)
    m.blurb.translation = [m.x, 384]
    m.blurb.width = 760
    m.blurb.wrap = true
    m.blurb.maxLines = 3
    m.blurb.lineSpacing = 10
    m.btnHost = m.layer.CreateChild("Group")
    m.pillHost = m.layer.CreateChild("Group")
    m.pillHost.translation = [m.x, 636]
    m.rowLabel = makeLabel(m.layer, "More like this", 26, "semibold", t.heading)
    m.rowLabel.translation = [m.x, 636]
    m.rowLabel.visible = false
    m.status = makeLabel(m.layer, "Loading...", 26, "regular", t.muted)
    m.status.translation = [m.x, 400]

    m.cards.observeField("rowItemSelected", "onCardSelected")
    m.art.observeField("loadStatus", "onArtStatus")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.top.observeField("backLabel", "onBackLabel")

    m.zone = "buttons"
    m.btnIndex = 0
    m.buttons = []
    m.actions = []
    m.pills = []
    m.seasons = []
    m.seasonIndex = 0
    m.playTarget = invalid
    m.nextUpSeasonId = ""
    m.epGen = 0
    m.restoreCard = -1
    m.isSeries = false
    m.played = false
    m.favorite = false
    m.trailerCount = 0
    m.item = invalid
    m.metaParts = []
    m.simGen = 0
    m.simPending = 0
    m.itemRatings = invalid
    ratingsInit()
    m.seenVersion = m.global.watchVersion
    setupOptions()
    paintAll()
end sub

sub onBackLabel()
    setBtnText(m.back, m.top.backLabel)
end sub

sub load()
    id = m.top.itemId
    if id = "" then return
    apiRequest("/Items/" + id, { "userId": m.global.userId, "Fields": "Overview,Genres,ChildCount,MediaStreams,DateLastMediaAdded,ProviderIds" }, "onItem")
end sub

sub onItem(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data)
        m.status.text = "Couldn't load this title."
        m.status.visible = true
        return
    end if
    item = res.data

    ' Episodes open their show, on the right season.
    if safeStr(item.Type) = "Episode" and isValid(item.SeriesId)
        m.top.seasonId = safeStr(item.SeasonId)
        m.top.itemId = safeStr(item.SeriesId)
        return
    end if

    m.item = item
    m.status.visible = false
    m.isSeries = (safeStr(item.Type) = "Series")
    m.played = false
    m.favorite = false
    if isValid(item.UserData)
        m.played = isTrue(item.UserData.Played)
        m.favorite = isTrue(item.UserData.IsFavorite)
    end if
    m.trailerCount = safeInt(item.LocalTrailerCount)

    m.eyebrow.text = UCase(eyebrowText(item))
    title = safeStr(item.Name)
    size = 96
    if measureText(title, 96, "display") > 1100 then size = 76
    if size = 76 and measureText(title, 76, "display") > 1100 then size = 60
    m.title.font = makeFont(size, "display")
    m.title.text = title
    t = th()
    showLogo(m.logo, m.title, logoUrl(item, t.detailLogoW, t.detailLogoH), m.logoBox)

    m.metaHost.removeChildrenIndex(m.metaHost.getChildCount(), 0)
    parts = []
    if isValid(item.ProductionYear) then parts.Push(item.ProductionYear.ToStr())
    if safeStr(item.OfficialRating) <> "" then parts.Push({ text: safeStr(item.OfficialRating), boxed: true })
    parts.Push(lengthText(item))
    parts.Push(firstGenre(item))
    access = accessText(item)
    if access <> "" then parts.Push(access)
    m.metaParts = parts
    kind = "movie"
    if m.isSeries then kind = "tv"
    tmdb = ""
    if isValid(item.ProviderIds) then tmdb = safeStr(item.ProviderIds.Tmdb)
    score = 0.0
    if isValid(item.CommunityRating) then score = item.CommunityRating
    m.itemRatings = ratingsFor(kind, tmdb, safeInt(item.CriticRating), score)
    drawMeta()
    m.blurb.text = safeStr(item.Overview)

    if hasBackdrop(item)
        uri = m.global.serverUrl + "/Items/" + safeStr(item.Id) + "/Images/Backdrop?fillWidth=1280&quality=85"
        if uri <> m.art.uri
            m.art.opacity = 0
            m.art.uri = uri
        end if
    end if

    if m.isSeries
        m.playTarget = invalid
        m.nextUpSeasonId = ""
        m.pillHost.visible = true
        m.rowLabel.visible = false
        apiRequest("/Shows/NextUp", { "userId": m.global.userId, "seriesId": safeStr(item.Id), "Limit": "1", "EnableResumable": "true", "EnableTotalRecordCount": "false" }, "onNextUp")
    else
        resume = 0
        if isValid(item.UserData) then resume = ticksToSeconds(item.UserData.PlaybackPositionTicks)
        m.playTarget = { itemId: safeStr(item.Id), startSeconds: resume, code: "" }
        m.pillHost.visible = false
        m.rowLabel.visible = true
        loadSimilar(item)
    end if
    buildButtons()
    if m.top.isInFocusChain() then restoreFocus()
end sub

' The meta line, then IMDb and Rotten Tomatoes scores after it.
sub drawMeta()
    m.metaHost.removeChildrenIndex(m.metaHost.getChildCount(), 0)
    parts = []
    parts.Append(m.metaParts)
    parts.Append(ratingParts(m.itemRatings))
    makeMeta(m.metaHost, parts, 22)
end sub

sub ratingsArrived(key as string)
    if m.itemRatings <> invalid
        if m.itemRatings.key = key then drawMeta()
    end if
end sub

' "Shows library · New episode added", "Movies library · Watched"
function eyebrowText(item as object) as string
    if safeStr(item.Type) = "Series"
        s = "Shows library"
        added = safeStr(item.DateLastMediaAdded)
        if added <> ""
            d = CreateObject("roDateTime")
            d.FromISO8601String(added)
            now = CreateObject("roDateTime")
            if now.AsSeconds() - d.AsSeconds() < 14 * 86400 then return s + " " + Chr(183) + " New episode added"
        end if
        if isValid(item.UserData)
            n = safeInt(item.UserData.UnplayedItemCount)
            if n = 1 then return s + " " + Chr(183) + " 1 episode to watch"
            if n > 1 then return s + " " + Chr(183) + " " + n.ToStr() + " episodes to watch"
        end if
        return s
    end if
    if m.played then return "Movies library " + Chr(183) + " Watched"
    return "Movies library"
end function

' "CC" when there are subtitles, "AD" when there is an audio description track.
function accessText(item as object) as string
    if not isValid(item.MediaStreams) then return ""
    cc = false
    ad = false
    for each s in item.MediaStreams
        if safeStr(s.Type) = "Subtitle" then cc = true
        if safeStr(s.Type) = "Audio"
            title = LCase(safeStr(s.DisplayTitle) + " " + safeStr(s.Title))
            if Instr(1, title, "descri") > 0 then ad = true
        end if
    end for
    parts = []
    if cc then parts.Push("CC")
    if ad then parts.Push("AD")
    return parts.Join(" " + Chr(183) + " ")
end function

sub onLogoStatus()
    placeLogo(m.logo, m.title, m.logoBox)
end sub

sub onArtStatus()
    if m.art.loadStatus = "ready" then m.fadeIn.control = "start"
end sub

' ---------- Shows: next up, seasons, episodes ----------

sub onNextUp(event as object)
    res = event.getData()
    if res.ok and isValid(res.data)
        if isValid(res.data.Items)
            if res.data.Items.Count() > 0
                ep = res.data.Items[0]
                resume = 0
                if isValid(ep.UserData) then resume = ticksToSeconds(ep.UserData.PlaybackPositionTicks)
                m.playTarget = { itemId: safeStr(ep.Id), startSeconds: resume, code: epCode(ep) }
                m.nextUpSeasonId = safeStr(ep.SeasonId)
                buildButtons()
            end if
        end if
    end if
    apiRequest("/Shows/" + safeStr(m.item.Id) + "/Seasons", { "userId": m.global.userId }, "onSeasons")
end sub

sub onSeasons(event as object)
    res = event.getData()
    m.seasons = []
    if res.ok and isValid(res.data)
        if isValid(res.data.Items) then m.seasons = res.data.Items
    end if
    pref = m.top.seasonId
    if pref = "" then pref = m.nextUpSeasonId
    m.seasonIndex = 0
    for i = 0 to m.seasons.Count() - 1
        if safeStr(m.seasons[i].Id) = pref then m.seasonIndex = i
    end for
    m.pillHost.removeChildrenIndex(m.pillHost.getChildCount(), 0)
    names = []
    for each s in m.seasons
        names.Push(safeStr(s.Name))
    end for
    m.pills = makePills(m.pillHost, names, m.seasonIndex)
    paintAll()
    loadEpisodes()
end sub

sub loadEpisodes()
    if m.seasons.Count() = 0 then return
    s = m.seasons[m.seasonIndex]
    m.top.seasonId = safeStr(s.Id)
    m.epGen = m.epGen + 1
    apiRequest("/Shows/" + safeStr(m.item.Id) + "/Episodes", { "userId": m.global.userId, "seasonId": safeStr(s.Id), "Fields": "Overview", "EnableTotalRecordCount": "false" }, "onEpisodes", "GET", invalid, m.epGen)
end sub

sub onEpisodes(event as object)
    res = event.getData()
    if res.tag <> m.epGen then return
    t = th()
    items = []
    if res.ok and isValid(res.data)
        if isValid(res.data.Items) then items = res.data.Items
    end if
    root = CreateObject("roSGNode", "ContentNode")
    row = root.CreateChild("ContentNode")
    targetIndex = -1
    for i = 0 to items.Count() - 1
        ep = items[i]
        c = itemToContent(ep, true)
        c.cardW = t.epW
        c.cardH = t.epH
        c.textBelow = true
        num = ""
        if isValid(ep.IndexNumber) then num = ep.IndexNumber.ToStr() + ". "
        c.heading = num + safeStr(ep.Name)
        c.badge = formatRuntime(ep.RunTimeTicks)
        if c.played then c.resumeSeconds = 0
        row.appendChild(c)
        if m.playTarget <> invalid
            if safeStr(ep.Id) = m.playTarget.itemId then targetIndex = i
        end if
    end for
    if m.playTarget = invalid and items.Count() > 0
        first = items[0]
        m.playTarget = { itemId: safeStr(first.Id), startSeconds: 0, code: epCode(first) }
        buildButtons()
    end if
    jump = 0
    if m.restoreCard >= 0
        jump = m.restoreCard
        m.restoreCard = -1
    else if targetIndex >= 0
        jump = targetIndex
    end if
    showCards(root, [t.epW + t.cellPadX * 2, t.epH + t.cellPadY * 2 + 110], 710, jump)
end sub

' ---------- Movies: more like this ----------

' Jellyfin's similar titles from the library first, then Seerr's
' recommendations that aren't among them, which can be requested.
sub loadSimilar(item as object)
    m.simGen = m.simGen + 1
    m.simLocal = []
    m.simSeerr = []
    m.simPending = 1
    apiRequest("/Items/" + safeStr(item.Id) + "/Similar", { "userId": m.global.userId, "Limit": "12", "Fields": "Overview,Genres,ChildCount" }, "onSimilar", "GET", invalid, m.simGen)
    tmdb = ""
    if isValid(item.ProviderIds) then tmdb = safeStr(item.ProviderIds.Tmdb)
    if tmdb <> "" and m.global.seerrState = "ready"
        m.simPending = 2
        seerrRequest("/movie/" + tmdb + "/recommendations", { "page": "1" }, "onSeerrSimilar", "GET", invalid, m.simGen)
    end if
end sub

sub onSimilar(event as object)
    res = event.getData()
    if res.tag <> m.simGen then return
    if res.ok and isValid(res.data)
        if isValid(res.data.Items) then m.simLocal = res.data.Items
    end if
    similarDone()
end sub

sub onSeerrSimilar(event as object)
    res = event.getData()
    if res.tag <> m.simGen then return
    if res.ok and isValid(res.data)
        if isValid(res.data.results) then m.simSeerr = res.data.results
    else
        print "[Matinee] more like this: Seerr recommendations failed, HTTP "; res.code
    end if
    similarDone()
end sub

' A Seerr title as a Card: its backdrop, with its Request Status as a badge.
function seerrCard(r as object) as object
    if safeStr(r.mediaType) = "" then r.mediaType = "movie"
    c = seerrToContent(r)
    img = tmdbImage(r.backdropPath, "w780")
    if img = "" then img = tmdbImage(r.posterPath, "w500")
    c.HDPosterUrl = img
    setCardSize(c, true)
    if c.badge = "" then c.badge = "Request"
    return c
end function

sub similarDone()
    m.simPending = m.simPending - 1
    if m.simPending > 0 then return
    t = th()
    root = CreateObject("roSGNode", "ContentNode")
    row = root.CreateChild("ContentNode")
    seen = {}
    for each it in m.simLocal
        row.appendChild(itemToContent(it, true))
        seen[safeStr(it.Id)] = true
    end for
    extra = 0
    for each r in m.simSeerr
        jf = ""
        if isValid(r.mediaInfo) then jf = safeStr(r.mediaInfo.jellyfinMediaId)
        if extra < 12 and (jf = "" or not seen.DoesExist(jf)) and jf <> safeStr(m.item.Id)
            row.appendChild(seerrCard(r))
            extra = extra + 1
        end if
    end for
    print "[Matinee] more like this: "; m.simLocal.Count(); " from the library, "; extra; " from Seerr"
    m.rowLabel.visible = row.getChildCount() > 0
    jump = 0
    if m.restoreCard >= 0
        jump = m.restoreCard
        m.restoreCard = -1
    end if
    showCards(root, [t.landW + t.cellPadX * 2, t.landH + t.cellPadY * 2], 686, jump)
end sub

sub showCards(root as object, cell as object, top as integer, jump as integer)
    t = th()
    count = root.getChild(0).getChildCount()
    m.cards.translation = [m.x - t.cellPadX, top - t.cellPadY]
    m.cards.itemSize = [1920 - m.x + t.cellPadX, cell[1]]
    m.cards.rowItemSize = [cell]
    m.cards.rowItemSpacing = [[0, 0]]
    m.cards.content = root
    m.cards.visible = count > 0
    if count > 0
        if jump > count - 1 then jump = count - 1
        m.cards.jumpToRowItem = [0, jump]
    end if
    if m.zone = "cards" and count = 0
        m.zone = "buttons"
        paintAll()
    end if
    if m.top.isInFocusChain() then restoreFocus()
end sub

sub onCardSelected(event as object)
    idx = event.getData()
    row = m.cards.content.getChild(0)
    c = row.getChild(idx[1])
    if c = invalid then return
    m.restoreCard = idx[1]
    optionsCardPressed(c, cardsContext())
end sub

' Episode Cards are already on their show, so Title Options leaves out
' "Go to" for them.
function cardsContext() as string
    if m.isSeries then return "season"
    return "row"
end function

' A short OK press plays an episode or opens a More like this title.
' Holding OK opens Title Options instead.
sub cardTapped(c as object)
    if Left(c.itemType, 6) = "seerr-"
        ' On the server already: its Details. Otherwise its Request Details.
        if c.jellyfinId <> ""
            m.top.navigate = { action: "details", itemId: c.jellyfinId }
        else
            m.top.navigate = seerrNav(c)
        end if
    else if m.isSeries
        m.top.navigate = { action: "play", itemId: c.itemId, startSeconds: c.resumeSeconds }
    else
        m.top.navigate = { action: "details", itemId: c.itemId }
    end if
end sub

' ---------- Buttons ----------

sub buildButtons()
    m.btnHost.removeChildrenIndex(m.btnHost.getChildCount(), 0)
    m.buttons = []
    m.actions = []
    t = m.playTarget
    resume = 0
    if t <> invalid then resume = t.startSeconds
    lbl = "Play"
    if resume > 0 then lbl = "Resume"
    if m.isSeries and t <> invalid
        if t.code <> "" then lbl = lbl + " " + t.code
    end if
    addButton({ kind: "primary", icon: "play", text: lbl }, "play")
    if not m.isSeries and resume > 0 then addButton({ kind: "secondary", text: "Start over", size: 22, padX: 30 }, "start")
    listIcon = "mylist"
    if m.favorite then listIcon = "mylist_on"
    addButton({ kind: "secondary", icon: listIcon, text: "My List", size: 22, padX: 30, iconSize: 24 }, "mylist")
    if m.trailerCount > 0 then addButton({ kind: "secondary", icon: "trailer", text: "Trailer", size: 22, padX: 30, iconSize: 24 }, "trailer")
    addButton({ kind: "secondary", icon: "more", text: "More", size: 22, padX: 30, iconSize: 24 }, "more")

    ' Sit the buttons under the blurb, above the season pills.
    y = 384
    if m.blurb.text <> ""
        rect = m.blurb.boundingRect()
        y = 384 + Int(rect.height) + 32
    end if
    if y > 540 then y = 540
    rowBtns(m.buttons, m.x, y, 20)
    if m.btnIndex >= m.buttons.Count() then m.btnIndex = 0
    paintAll()
end sub

sub addButton(opts as object, action as string)
    m.buttons.Push(makeBtn(m.btnHost, opts))
    m.actions.Push(action)
end sub

sub paintAll()
    focusBtn = -1
    if m.zone = "buttons" then focusBtn = m.btnIndex
    paintBtns(m.buttons, focusBtn)
    paintBtn(m.back, m.zone = "back")
    focusPill = -1
    if m.zone = "seasons" then focusPill = m.seasonIndex
    selectPill(m.pills, m.seasonIndex, focusPill)
end sub

sub doButton()
    if m.actions.Count() = 0 then return
    action = m.actions[m.btnIndex]
    t = m.playTarget
    if action = "play"
        if t <> invalid then m.top.navigate = { action: "play", itemId: t.itemId, startSeconds: t.startSeconds }
    else if action = "start"
        if t <> invalid then m.top.navigate = { action: "play", itemId: t.itemId, startSeconds: 0 }
    else if action = "mylist"
        m.favorite = not m.favorite
        setFavorite(safeStr(m.item.Id), m.favorite)
        if m.favorite
            setBtnIcon(m.buttons[m.btnIndex], "mylist_on")
        else
            setBtnIcon(m.buttons[m.btnIndex], "mylist")
        end if
        m.global.watchVersion = m.global.watchVersion + 1
        m.seenVersion = m.global.watchVersion
    else if action = "trailer"
        apiRequest("/Items/" + safeStr(m.item.Id) + "/LocalTrailers", { "userId": m.global.userId }, "onTrailerList")
    else if action = "more"
        openOptions(itemToContent(m.item, true), "details")
    end if
end sub

sub onTrailerList(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    if type(res.data) <> "roArray" then return
    if res.data.Count() = 0 then return
    m.top.navigate = { action: "play", itemId: safeStr(res.data[0].Id), startSeconds: 0, trailer: true }
end sub

' Title Options saved a change to this title or one of its Cards.
sub titleChanged(_change as object)
    m.seenVersion = m.global.watchVersion
    reloadKeepingPlace()
end sub

sub reloadKeepingPlace()
    if m.cards.content <> invalid
        f = m.cards.rowItemFocused
        ' Before the Cards have had focus this can be an empty array.
        if f <> invalid
            if f.Count() > 1 and f[1] <> invalid then m.restoreCard = f[1]
        end if
    end if
    load()
end sub

sub onRefresh()
    if m.global.watchVersion <> m.seenVersion
        m.seenVersion = m.global.watchVersion
        reloadKeepingPlace()
    end if
end sub

' ---------- Focus & keys ----------

sub restoreContentFocus()
    restoreFocus()
end sub

sub restoreFocus()
    if m.zone = "cards" and m.cards.visible
        m.cards.setFocus(true)
    else
        m.sink.setFocus(true)
    end if
end sub

sub setZone(zone as string)
    m.zone = zone
    paintAll()
    restoreFocus()
end sub

sub onFocusChanged()
    if m.top.hasFocus() then restoreFocus()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if optionsKey(key, press) then return true
    if not press then return false
    if key = "options"
        if m.zone = "cards"
            f = m.cards.rowItemFocused
            if f <> invalid and f.Count() > 1
                openOptions(m.cards.content.getChild(0).getChild(f[1]), cardsContext())
            end if
        else if m.item <> invalid
            openOptions(itemToContent(m.item, true), "details")
        end if
        return true
    end if
    hasSeasons = m.isSeries and m.seasons.Count() > 0
    if m.zone = "back"
        if key = "OK"
            m.top.navigate = { action: "back" }
        else if key = "down"
            setZone("buttons")
        end if
        return key <> "back"
    else if m.zone = "buttons"
        if key = "left"
            if m.btnIndex > 0 then m.btnIndex = m.btnIndex - 1
            paintAll()
        else if key = "right"
            if m.btnIndex < m.buttons.Count() - 1 then m.btnIndex = m.btnIndex + 1
            paintAll()
        else if key = "OK"
            doButton()
        else if key = "play"
            m.btnIndex = 0
            doButton()
        else if key = "up"
            setZone("back")
        else if key = "down"
            if hasSeasons
                setZone("seasons")
            else if m.cards.visible
                setZone("cards")
            end if
        else
            return false
        end if
        return true
    else if m.zone = "seasons"
        if key = "left" or key = "right"
            dirn = 1
            if key = "left" then dirn = -1
            n = m.seasonIndex + dirn
            if n >= 0 and n < m.seasons.Count()
                m.seasonIndex = n
                paintAll()
                loadEpisodes()
            end if
        else if key = "up"
            setZone("buttons")
        else if key = "down" or key = "OK"
            if m.cards.visible then setZone("cards")
        else
            return false
        end if
        return true
    else if m.zone = "cards"
        if key = "up"
            if hasSeasons
                setZone("seasons")
            else
                setZone("buttons")
            end if
            return true
        end if
    end if
    return false
end function
