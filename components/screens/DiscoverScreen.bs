' Discover: browse Seerr for things to request (Search is for a title you
' already know). A Hero shows the Focused title; Rows below hold trending,
' popular and coming-soon titles, then streaming services and genres, which
' open a Discover category of their own. OK on a title opens its Request
' Details. The Hero and Rows live in DiscoverHost.bs.

sub init()
    t = th()
    m.heroLayer = m.top.findNode("heroLayer")
    m.rows = m.top.findNode("rows")
    m.empty = m.top.findNode("empty")
    m.sink = m.top.findNode("sink")
    m.empty.translation = [t.leftPad, 270]

    discoverInit()
    m.top.observeField("focusedChild", "onFocusChanged")
    m.global.observeField("seerrState", "onSeerrState")

    m.loaded = false
    m.region = "US"
    setupMenu("discover")
    start()
end sub

sub start()
    if m.global.seerrState = "ready"
        m.loaded = true
        heroText("Discover", "Loading...", "", "")
        seerrRequest("/settings/public", {}, "onSettings")
    else
        showEmpty()
    end if
end sub

sub onSeerrState()
    if m.global.seerrState = "ready" and not m.loaded then start()
end sub

sub onRefresh()
    if m.global.seerrState = "ready" and not m.loaded then start()
end sub

' The streaming services offered as tiles, in this order, when Seerr's
' region has them. Ids are TMDB watch providers.
function serviceList() as object
    return [
        { id: 8, name: "Netflix" }
        { id: 9, name: "Prime Video" }
        { id: 337, name: "Disney+" }
        { id: 1899, name: "Max" }
        { id: 15, name: "Hulu" }
        { id: 350, name: "Apple TV+" }
        { id: 531, name: "Paramount+" }
        { id: 386, name: "Peacock" }
    ]
end function

sub onSettings(event as object)
    res = event.getData()
    settings = invalid
    if res.ok then settings = res.data
    region = seerrRegion(settings)
    m.region = region
    defs = []
    defs.Push({ title: "Trending", path: "/discover/trending", query: {}, mediaType: "", tiles: "" })
    defs.Push({ title: "Popular movies", path: "/discover/movies", query: {}, mediaType: "movie", tiles: "" })
    defs.Push({ title: "Popular series", path: "/discover/tv", query: {}, mediaType: "tv", tiles: "" })
    defs.Push({ title: "Streaming services", path: "/watchproviders/movies", query: { "watchRegion": region }, tiles: "services", mediaType: "" })
    defs.Push({ title: "Coming soon: movies", path: "/discover/movies/upcoming", query: {}, mediaType: "movie", tiles: "" })
    defs.Push({ title: "Coming soon: series", path: "/discover/tv/upcoming", query: {}, mediaType: "tv", tiles: "" })
    defs.Push({ title: "Movie genres", path: "/discover/genreslider/movie", query: {}, tiles: "genres", mediaType: "movie" })
    defs.Push({ title: "Series genres", path: "/discover/genreslider/tv", query: {}, tiles: "genres", mediaType: "tv" })
    fetchRows(defs)
end sub

function makeTiles(d as object, data as dynamic) as object
    if d.tiles = "services"
        ' No region list: offer every service anyway.
        if data = invalid then return serviceTiles([])
        return serviceTiles(data)
    end if
    if data = invalid then return []
    return genreTiles(data, d.mediaType)
end function

function serviceTiles(providers as dynamic) as object
    t = th()
    logos = {}
    if type(providers) = "roArray"
        for each p in providers
            logos[safeInt(p.id).ToStr()] = safeStr(p.logoPath)
        end for
    end if
    tiles = []
    for each s in serviceList()
        key = s.id.ToStr()
        if logos.Count() = 0 or logos.DoesExist(key)
            c = newContent()
            c.itemType = "discover-service"
            c.itemId = key
            c.heading = s.name
            c.meta = "Streaming service"
            c.description = "Popular movies and series on " + s.name + "."
            if logos.DoesExist(key) then c.HDPosterUrl = tmdbImage(logos[key], "w154")
            c.cardW = t.landH
            c.cardH = t.landH
            tiles.Push(c)
        end if
    end for
    return tiles
end function

function genreTiles(genres as dynamic, mediaType as string) as object
    tiles = []
    if type(genres) <> "roArray" then return tiles
    kind = "movies"
    if mediaType = "tv" then kind = "series"
    n = 0
    for each g in genres
        c = newContent()
        c.itemType = "discover-genre-" + mediaType
        c.itemId = safeInt(g.id).ToStr()
        c.heading = safeStr(g.name)
        c.meta = "Genre"
        c.description = "Popular " + kind + " in " + c.heading + "."
        art = ""
        if isValid(g.backdrops)
            ' Neighbouring genres often share a first backdrop: take a different one.
            if g.backdrops.Count() > 0 then art = g.backdrops[n mod g.backdrops.Count()]
        end if
        c.HDPosterUrl = tmdbImage(art, "w780")
        c.backdropUrl = tmdbImage(art, "w1280")
        setCardSize(c, true)
        tiles.Push(c)
        n = n + 1
    end for
    return tiles
end function

sub noRows()
    heroText("Discover", "Nothing to show", "", "Seerr didn" + Chr(8217) + "t send anything to browse. Try again in a moment.")
    m.heroNote.text = ""
end sub

function canTakeFocus() as boolean
    return not menuIsOpen()
end function

sub showEmpty()
    t = th()
    heroText("", "", "", "")
    m.heroNote.text = ""
    m.rows.visible = false
    e = m.empty
    e.removeChildrenIndex(e.getChildCount(), 0)
    st = m.global.seerrState
    title = "Seerr isn" + Chr(8217) + "t set up"
    body = "An Administrator can add it in Settings " + Chr(8250) + " Servers & services."
    m.emptyBtn = invalid
    if st = "signedOut"
        title = "Sign in to Seerr"
        body = "Seerr uses your Jellyfin account, so your requests are yours."
        m.emptyBtn = "seerrSignIn"
    end if
    makeTitle(e, "Discover", 64).translation = [0, -190]
    makePanel(e, 760, 260, 18)
    makeLabel(e, title, 30, "semibold", t.text).translation = [56, 56]
    b = makeLabel(e, body, 22, "regular", t.muted)
    b.translation = [56, 108]
    b.width = 648
    b.wrap = true
    if m.emptyBtn <> invalid
        btn = makeBtn(e, { kind: "primary", text: "Sign in", h: 64, size: 22, padX: 32 })
        btn.group.translation = [56, 168]
        paintBtn(btn, true)
    end if
    e.visible = true
end sub

' ---------- Choosing ----------

sub tileSelected(c as object)
    if c.itemType = "discover-service"
        m.top.navigate = { action: "discoverCategory", category: { kind: "service", id: c.itemId, name: c.heading, region: m.region } }
    else if Left(c.itemType, 15) = "discover-genre-"
        m.top.navigate = { action: "discoverCategory", category: { kind: "genre", id: c.itemId, name: c.heading, mediaType: Mid(c.itemType, 16) } }
    end if
end sub

' ---------- Focus & keys ----------

sub restoreContentFocus()
    if m.rows.visible and m.rows.content <> invalid
        m.rows.setFocus(true)
    else
        m.sink.setFocus(true)
    end if
end sub

sub onFocusChanged()
    if m.top.hasFocus() and not menuIsOpen() then restoreContentFocus()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if menuIsOpen() then return false
    if key = "left"
        openMenu()
        return true
    else if key = "OK" and not m.rows.visible and m.emptyBtn <> invalid
        m.top.navigate = { action: m.emptyBtn }
        return true
    else if key = "back"
        return rowsBackToTop()
    end if
    return false
end function
