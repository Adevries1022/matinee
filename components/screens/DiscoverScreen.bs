' Discover: browse Seerr for things to request (Search is for a title you
' already know). A Hero shows the Focused title; Rows below hold trending,
' popular and coming-soon titles, then streaming services and genres, which
' open a grid of their own. OK on a title opens the request panel.

sub init()
    t = th()
    m.heroLayer = m.top.findNode("heroLayer")
    m.rows = m.top.findNode("rows")
    m.empty = m.top.findNode("empty")
    m.modal = m.top.findNode("modal")
    m.sink = m.top.findNode("sink")
    m.empty.translation = [t.leftPad, 270]

    buildHero()
    styleRows()
    m.rows.observeField("rowItemFocused", "onItemFocused")
    m.rows.observeField("rowItemSelected", "onItemSelected")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.global.observeField("seerrState", "onSeerrState")

    m.gen = 0
    m.loaded = false
    m.heroItem = invalid
    m.heroRatings = invalid
    ratingsInit()
    panelInit()
    setupMenu("discover")
    start()
end sub

sub start()
    if m.global.seerrState = "ready"
        m.loaded = true
        heroText("Discover", "Loading...", "", "")
        panelLoad()
    else
        showEmpty()
    end if
end sub

sub onSeerrState()
    if m.global.seerrState = "ready" and not m.loaded then start()
end sub

sub onRefresh()
    if m.global.seerrState = "ready" and not m.loaded then start()
end sub

sub onOpen()
    if m.top.open <> invalid then openPanelFor(m.top.open)
end sub

' ---------- Hero ----------

sub buildHero()
    t = th()
    layer = m.heroLayer
    m.heroArt = layer.CreateChild("Poster")
    m.heroArt.id = "heroArt"
    m.heroArt.width = 1920
    m.heroArt.height = 780
    m.heroArt.loadWidth = 1920
    m.heroArt.loadHeight = 780
    m.heroArt.loadDisplayMode = "scaleToZoom"
    m.heroArt.opacity = 0
    m.heroArt.observeField("loadStatus", "onHeroArtStatus")
    makeFade(layer, "hero", 1920, 780)
    fade = makeFadeUp(layer, 1920, 204, t.bg)
    fade.translation = [0, 480]
    below = layer.CreateChild("Rectangle")
    below.translation = [0, 684]
    below.width = 1920
    below.height = 396
    below.color = t.bg

    m.heroFade = layer.CreateChild("Animation")
    m.heroFade.duration = 0.35
    m.heroFade.easeFunction = "outQuad"
    interp = m.heroFade.CreateChild("FloatFieldInterpolator")
    interp.key = [0.0, 1.0]
    interp.keyValue = [0.0, 1.0]
    interp.fieldToInterp = "heroArt.opacity"

    x = t.leftPad
    m.heroEyebrow = makeLabel(layer, "", 18, "semibold", t.accent)
    m.heroEyebrow.translation = [x, 196]
    m.heroEyebrow.height = 22
    m.heroEyebrow.vertAlign = "center"
    m.heroTitle = makeLabel(layer, "", 88, "display", t.text)
    m.heroTitle.translation = [x, 228]
    ' Discover has no Hero buttons, so long titles can run to the right edge.
    m.heroTitle.width = 1600
    m.heroTitle.height = 116
    m.heroTitle.vertAlign = "center"
    m.heroMetaHost = layer.CreateChild("Group")
    m.heroMetaHost.translation = [x, 360]
    m.heroBlurb = makeLabel(layer, "", 26, "regular", t.soft)
    m.heroBlurb.translation = [x, 410]
    m.heroBlurb.width = 860
    m.heroBlurb.wrap = true
    m.heroBlurb.maxLines = 2
    m.heroBlurb.lineSpacing = 8
    ' What OK does, or a short message after a request.
    m.heroNote = makeLabel(layer, "", 22, "semibold", t.muted)
    m.heroNote.translation = [x, 520]
    m.heroNote.width = 1400

    m.heroTimer = layer.CreateChild("Timer")
    m.heroTimer.duration = 0.3
    m.heroTimer.repeat = false
    m.heroTimer.observeField("fire", "applyHero")
end sub

sub heroText(eyebrow as string, title as string, meta as string, blurb as string)
    size = 88
    ' measureText runs a little short of the drawn width, so step down early.
    if measureText(title, 88, "display") > 1100 then size = 64
    if size = 64 and measureText(title, 64, "display") > 1400 then size = 52
    m.heroTitle.font = makeFont(size, "display")
    m.heroEyebrow.text = UCase(eyebrow)
    m.heroTitle.text = title
    drawHeroMeta([meta])
    m.heroBlurb.text = blurb
end sub

' Show a Card in the Hero after a short pause, so scrolling stays smooth.
sub heroShow(c as object, immediate = false as boolean)
    m.heroItem = c
    if immediate
        applyHero()
    else
        m.heroTimer.control = "stop"
        m.heroTimer.control = "start"
    end if
end sub

sub applyHero()
    c = m.heroItem
    if c = invalid then return
    heroText(c.rowTitle, c.heading, c.meta, c.description)
    m.heroRatings = invalid
    if Left(c.itemType, 6) = "seerr-"
        m.heroRatings = ratingsFor(Mid(c.itemType, 7), c.tmdbId, 0, c.score)
        drawTitleMeta()
    end if
    noteFor(c)
    ' Services have no backdrop: keep the last one.
    if c.backdropUrl <> "" and c.backdropUrl <> m.heroArt.uri
        m.heroArt.opacity = 0
        m.heroArt.uri = c.backdropUrl
    end if
end sub

sub drawHeroMeta(parts as object)
    m.heroMetaHost.removeChildrenIndex(m.heroMetaHost.getChildCount(), 0)
    makeMeta(m.heroMetaHost, parts, 22)
end sub

' "2026 · Movie" and the title's scores.
sub drawTitleMeta()
    c = m.heroItem
    if c = invalid then return
    kind = "Movie"
    if c.itemType = "seerr-tv" then kind = "Series"
    parts = [c.year, kind]
    parts.Append(ratingParts(m.heroRatings))
    drawHeroMeta(parts)
end sub

sub ratingsArrived(key as string)
    if m.heroRatings <> invalid
        if m.heroRatings.key = key then drawTitleMeta()
    end if
end sub

sub noteFor(c as object)
    t = th()
    m.heroNote.color = t.muted
    s = c.requestStatus
    text = "Press OK to request"
    if Left(c.itemType, 9) = "discover-"
        text = "Press OK to browse"
    else if s = 5
        text = "On your server " + Chr(183) + " press OK for details"
    else if s = 2
        text = "Requested " + Chr(183) + " waiting for approval"
    else if s = 3
        text = "Requested " + Chr(183) + " downloading"
    else if s = 4
        text = "Partly on your server " + Chr(183) + " press OK to request the rest"
    end if
    m.heroNote.text = text
end sub

sub onHeroArtStatus()
    if m.heroArt.loadStatus = "ready" then m.heroFade.control = "start"
end sub

' ---------- Rows ----------

sub styleRows()
    t = th()
    m.rows.translation = [t.leftPad - t.cellPadX, t.rowsTop]
    m.rows.itemSize = [1920 - t.leftPad + t.cellPadX, t.landH + t.cellPadY * 2 + 56]
    m.rows.rowItemSpacing = [[0, 0]]
    m.rows.itemSpacing = [0, 18]
    m.rows.rowLabelOffset = [[t.cellPadX, 2]]
    m.rows.rowLabelColor = t.heading
    m.rows.rowLabelFont = makeFont(26, "semibold")
end sub

' The streaming services offered as tiles, in this order, when Seerr's
' region has them. Ids are TMDB watch providers.
function serviceList() as object
    return [
        { id: 8, name: "Netflix" }
        { id: 9, name: "Prime Video" }
        { id: 337, name: "Disney+" }
        { id: 1899, name: "Max" }
        { id: 15, name: "Hulu" }
        { id: 350, name: "Apple TV+" }
        { id: 531, name: "Paramount+" }
        { id: 386, name: "Peacock" }
    ]
end function

' Called by the request panel once Seerr's settings (with the region) arrive.
sub panelSettings()
    region = seerrRegion()
    defs = []
    defs.Push({ title: "Trending", path: "/discover/trending", query: {}, mediaType: "", tiles: "" })
    defs.Push({ title: "Popular movies", path: "/discover/movies", query: {}, mediaType: "movie", tiles: "" })
    defs.Push({ title: "Popular series", path: "/discover/tv", query: {}, mediaType: "tv", tiles: "" })
    defs.Push({ title: "Streaming services", path: "/watchproviders/movies", query: { "watchRegion": region }, tiles: "services", mediaType: "" })
    defs.Push({ title: "Coming soon: movies", path: "/discover/movies/upcoming", query: {}, mediaType: "movie", tiles: "" })
    defs.Push({ title: "Coming soon: series", path: "/discover/tv/upcoming", query: {}, mediaType: "tv", tiles: "" })
    defs.Push({ title: "Movie genres", path: "/discover/genreslider/movie", query: {}, tiles: "genres", mediaType: "movie" })
    defs.Push({ title: "Series genres", path: "/discover/genreslider/tv", query: {}, tiles: "genres", mediaType: "tv" })
    m.region = region
    fetchRows(defs)
end sub

sub fetchRows(defs as object)
    m.gen = m.gen + 1
    m.rowDefs = defs
    m.rowResults = []
    for i = 0 to defs.Count() - 1
        m.rowResults.Push(invalid)
    end for
    m.pending = defs.Count()
    for i = 0 to defs.Count() - 1
        d = defs[i]
        seerrRequest(d.path, d.query, "onRowData", "GET", invalid, m.gen * 1000 + i)
    end for
end sub

sub onRowData(event as object)
    res = event.getData()
    tag = res.tag
    if tag \ 1000 <> m.gen then return
    i = tag mod 1000
    d = m.rowDefs[i]
    items = []
    if res.ok and isValid(res.data)
        if d.tiles = "services"
            items = serviceTiles(res.data)
        else if d.tiles = "genres"
            items = genreTiles(res.data, d.mediaType)
        else if isValid(res.data.results)
            for each r in res.data.results
                mt = safeStr(r.mediaType)
                if mt = "" then mt = d.mediaType
                if mt = "movie" or mt = "tv" then items.Push(discoverContent(r, mt))
            end for
        end if
    else if res.code = 401 or res.code = 403
        m.top.navigate = { action: "seerrSignedOut" }
    else if d.tiles = "services"
        ' No region list: offer every service anyway.
        items = serviceTiles([])
    end if
    m.rowResults[i] = items
    m.pending = m.pending - 1
    if m.pending <= 0 then buildRows()
end sub

function serviceTiles(providers as dynamic) as object
    t = th()
    logos = {}
    if type(providers) = "roArray"
        for each p in providers
            logos[safeInt(p.id).ToStr()] = safeStr(p.logoPath)
        end for
    end if
    tiles = []
    for each s in serviceList()
        key = s.id.ToStr()
        if logos.Count() = 0 or logos.DoesExist(key)
            c = newContent()
            c.itemType = "discover-service"
            c.itemId = key
            c.heading = s.name
            c.meta = "Streaming service"
            c.description = "Popular movies and series on " + s.name + "."
            if logos.DoesExist(key) then c.HDPosterUrl = tmdbImage(logos[key], "w154")
            c.cardW = t.landH
            c.cardH = t.landH
            tiles.Push(c)
        end if
    end for
    return tiles
end function

function genreTiles(genres as dynamic, mediaType as string) as object
    tiles = []
    if type(genres) <> "roArray" then return tiles
    kind = "movies"
    if mediaType = "tv" then kind = "series"
    n = 0
    for each g in genres
        c = newContent()
        c.itemType = "discover-genre-" + mediaType
        c.itemId = safeInt(g.id).ToStr()
        c.heading = safeStr(g.name)
        c.meta = "Genre"
        c.description = "Popular " + kind + " in " + c.heading + "."
        art = ""
        if isValid(g.backdrops)
            ' Neighbouring genres often share a first backdrop: take a different one.
            if g.backdrops.Count() > 0 then art = g.backdrops[n mod g.backdrops.Count()]
        end if
        c.HDPosterUrl = tmdbImage(art, "w780")
        c.backdropUrl = tmdbImage(art, "w1280")
        setCardSize(c, true)
        tiles.Push(c)
        n = n + 1
    end for
    return tiles
end function

sub buildRows()
    t = th()
    root = CreateObject("roSGNode", "ContentNode")
    sizes = []
    heights = []
    for i = 0 to m.rowDefs.Count() - 1
        items = m.rowResults[i]
        d = m.rowDefs[i]
        if items <> invalid
            if items.Count() > 0
                row = root.CreateChild("ContentNode")
                row.title = d.title
                for each c in items
                    c.rowTitle = d.title
                    row.appendChild(c)
                end for
                cw = items[0].cardW
                ch = items[0].cardH
                sizes.Push([cw + t.cellPadX * 2, ch + t.cellPadY * 2])
                heights.Push(ch + t.cellPadY * 2 + 56)
            end if
        end if
    end for

    if root.getChildCount() = 0
        heroText("Discover", "Nothing to show", "", "Seerr didn" + Chr(8217) + "t send anything to browse. Try again in a moment.")
        m.heroNote.text = ""
        m.rows.visible = false
        return
    end if

    m.empty.visible = false
    m.rows.rowItemSize = sizes
    m.rows.rowHeights = heights
    m.rows.content = root
    m.rows.visible = true
    if m.top.isInFocusChain() and not menuIsOpen() and not m.modalOpen then m.rows.setFocus(true)
    heroShow(root.getChild(0).getChild(0), true)
end sub

sub showEmpty()
    t = th()
    heroText("", "", "", "")
    m.heroNote.text = ""
    m.rows.visible = false
    e = m.empty
    e.removeChildrenIndex(e.getChildCount(), 0)
    st = m.global.seerrState
    title = "Seerr isn" + Chr(8217) + "t set up"
    body = "An Administrator can add it in Settings " + Chr(8250) + " Servers & services."
    m.emptyBtn = invalid
    if st = "signedOut"
        title = "Sign in to Seerr"
        body = "Seerr uses your Jellyfin account, so your requests are yours."
        m.emptyBtn = "seerrSignIn"
    end if
    makeTitle(e, "Discover", 64).translation = [0, -190]
    makePanel(e, 760, 260, 18)
    makeLabel(e, title, 30, "semibold", t.text).translation = [56, 56]
    b = makeLabel(e, body, 22, "regular", t.muted)
    b.translation = [56, 108]
    b.width = 648
    b.wrap = true
    if m.emptyBtn <> invalid
        btn = makeBtn(e, { kind: "primary", text: "Sign in", h: 64, size: 22, padX: 32 })
        btn.group.translation = [56, 168]
        paintBtn(btn, true)
    end if
    e.visible = true
end sub

' ---------- Choosing ----------

sub onItemFocused(event as object)
    idx = event.getData()
    c = cardAt(idx)
    if c <> invalid then heroShow(c)
end sub

sub onItemSelected(event as object)
    c = cardAt(event.getData())
    if c = invalid then return
    if c.itemType = "discover-service"
        m.top.navigate = { action: "discoverCategory", category: { kind: "service", id: c.itemId, name: c.heading, region: m.region } }
    else if Left(c.itemType, 15) = "discover-genre-"
        m.top.navigate = { action: "discoverCategory", category: { kind: "genre", id: c.itemId, name: c.heading, mediaType: Mid(c.itemType, 16) } }
    else
        chooseTitle(c)
    end if
end sub

function cardAt(idx as dynamic) as object
    if idx = invalid or m.rows.content = invalid then return invalid
    row = m.rows.content.getChild(idx[0])
    if row = invalid then return invalid
    return row.getChild(idx[1])
end function

sub panelNote(text as string)
    m.heroNote.text = text
    m.heroNote.color = th().accent
end sub

sub panelRequested()
    ' The note already says so; the Card's badge updates on the next visit.
end sub

' ---------- Focus & keys ----------

sub restoreContentFocus()
    if m.rows.visible and m.rows.content <> invalid
        m.rows.setFocus(true)
    else
        m.sink.setFocus(true)
    end if
end sub

sub onFocusChanged()
    if m.top.hasFocus() and not menuIsOpen() and not m.modalOpen then restoreContentFocus()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.modalOpen then return modalKey(key)
    if menuIsOpen() then return false
    if key = "left"
        openMenu()
        return true
    else if key = "OK" and not m.rows.visible and m.emptyBtn <> invalid
        m.top.navigate = { action: m.emptyBtn }
        return true
    else if key = "back" and m.rows.visible
        ' Back from lower Rows jumps to the top instead of leaving.
        f = m.rows.rowItemFocused
        if f <> invalid
            if f[0] > 0 or f[1] > 0
                m.rows.jumpToRowItem = [0, 0]
                return true
            end if
        end if
    end if
    return false
end function
