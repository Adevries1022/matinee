<?xml version="1.0" encoding="utf-8" ?>
<!-- Plays a title with Matinee's own on-screen controls (the Player OSD)
     instead of Roku's trickplay bar. See ADR 0004. -->
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="playItem" type="assocarray" onChange="start" />
    <field id="closed" type="boolean" onChange="onClosed" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="PlayerScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" enableUI="false" />
    <Label id="status" translation="[160,500]" width="1600" horizAlign="center" wrap="true" text="" visible="false" />
    <Group id="osd" visible="false" />
    <Group id="skipLayer" visible="false" />
    <Group id="upNext" visible="false" />
    <Group id="picker" visible="false" />
    <Group id="sink" focusable="true" />
    <Timer id="countdown" duration="1" repeat="true" />
    <Timer id="hideTimer" duration="5" repeat="false" />
    <Timer id="seekTimer" duration="0.6" repeat="false" />
    <Timer id="scrubTimer" duration="0.25" repeat="true" />
    <Timer id="holdTimer" duration="0.5" repeat="false" />
  </children>
</component>
