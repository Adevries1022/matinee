<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="playItem" type="assocarray" onChange="start" />
    <field id="closed" type="boolean" onChange="onClosed" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="PlayerScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" />
    <Label id="status" translation="[160,500]" width="1600" horizAlign="center" wrap="true" text="Loading...">
      <Font role="font" uri="font:SystemFontFile" size="34" />
    </Label>
    <Label id="hint" translation="[0,40]" width="1880" horizAlign="right" visible="false" text="* Audio and subtitles">
      <Font role="font" uri="font:SystemFontFile" size="24" />
    </Label>
    <Group id="upNext" visible="false" />
    <Group id="picker" visible="false" />
    <Timer id="countdown" duration="1" repeat="true" />
    <Timer id="hintTimer" duration="4" repeat="false" />
  </children>
</component>
