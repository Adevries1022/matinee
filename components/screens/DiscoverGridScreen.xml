<?xml version="1.0" encoding="utf-8" ?>
<!-- One Discover category as a grid: a genre, or a streaming service with
     Movies and Series tabs. Uses the shared request panel. -->
<component name="DiscoverGridScreen" extends="Group">
  <interface>
    <!-- category: { kind: "genre" | "service", id, name, mediaType (genre), region (service) } -->
    <field id="category" type="assocarray" onChange="onCategory" />
    <field id="backLabel" type="string" value="Discover" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="DiscoverGridScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/RequestPanel.bs" />
  <children>
    <Group id="layer" />
    <MarkupGrid
      id="grid"
      itemComponentName="RequestItem"
      numColumns="4"
      numRows="3"
      drawFocusFeedback="false"
      vertFocusAnimationStyle="floatingFocus"
      visible="false" />
    <Group id="modal" visible="false" />
    <Group id="sink" focusable="true" />
  </children>
</component>
