' Home, Series and Movies: the Rail, the Hero for the Focused title with
' Play / Details / My List, and Rows of Cards from y = 640.
' Focus moves between three zones: the Rows, the Hero buttons (Up from the
' first Row) and the server pill and avatar at the top right (Up again).

sub init()
    t = th()
    m.heroLayer = m.top.findNode("heroLayer")
    m.chrome = m.top.findNode("chrome")
    m.status = m.top.findNode("status")
    m.rows = m.top.findNode("rows")
    m.status.font = makeFont(26)
    m.status.color = t.muted
    m.status.translation = [t.leftPad, t.rowsTop + 20]
    m.status.width = 1600
    m.status.text = "Loading..."

    buildHero()
    styleRows()
    wm = makeWordmark(m.chrome)
    wm.translation = [t.leftPad, 64]
    m.badges = makeTopBadges(m.chrome)

    m.rows.observeField("rowItemFocused", "onItemFocused")
    m.rows.observeField("rowItemSelected", "onItemSelected")
    m.top.observeField("focusedChild", "onFocusChanged")

    m.zone = "rows"
    m.btnIndex = 0
    m.badgeIndex = 1
    m.gen = 0
    m.kind = ""
    m.seenVersion = m.global.watchVersion
    m.seenPrefs = m.global.prefsVersion
end sub

' ---------- Hero ----------

sub buildHero()
    t = th()
    layer = m.heroLayer
    m.heroArt = layer.CreateChild("Poster")
    m.heroArt.id = "heroArt"
    m.heroArt.width = 1920
    m.heroArt.height = 780
    m.heroArt.loadWidth = 1920
    m.heroArt.loadHeight = 780
    m.heroArt.loadDisplayMode = "scaleToZoom"
    m.heroArt.opacity = 0
    m.heroArt.observeField("loadStatus", "onHeroArtStatus")
    setupTrailer(layer, 1, 600)
    makeFade(layer, "hero", 1920, 780)
    fade = makeFadeUp(layer, 1920, 300, t.bg)
    fade.translation = [0, 480]
    below = layer.CreateChild("Rectangle")
    below.translation = [0, 780]
    below.width = 1920
    below.height = 300
    below.color = t.bg

    m.heroFade = layer.CreateChild("Animation")
    m.heroFade.duration = 0.35
    m.heroFade.easeFunction = "outQuad"
    interp = m.heroFade.CreateChild("FloatFieldInterpolator")
    interp.key = [0.0, 1.0]
    interp.keyValue = [0.0, 1.0]
    interp.fieldToInterp = "heroArt.opacity"

    x = t.leftPad
    m.heroEyebrow = makeLabel(layer, "", 18, "semibold", t.accent)
    m.heroEyebrow.translation = [x, 196]
    m.heroEyebrow.height = 22
    m.heroEyebrow.vertAlign = "center"
    m.heroTitle = makeLabel(layer, "", 104, "display", t.text)
    m.heroTitle.translation = [x, 228]
    m.heroTitle.width = 1200
    m.heroTitle.height = 116
    m.heroTitle.vertAlign = "center"
    m.heroMetaHost = layer.CreateChild("Group")
    m.heroMetaHost.translation = [x, 360]
    m.heroBlurb = makeLabel(layer, "", 26, "regular", t.soft)
    m.heroBlurb.translation = [x, 410]
    m.heroBlurb.width = 720
    m.heroBlurb.wrap = true
    m.heroBlurb.maxLines = 2
    m.heroBlurb.lineSpacing = 8

    m.btnPlay = makeBtn(layer, { kind: "primary", icon: "play", text: "Play", padX: 40 })
    m.btnDetails = makeBtn(layer, { kind: "secondary", icon: "info", text: "Details" })
    m.btnList = makeBtn(layer, { kind: "square", icon: "plus", iconSize: 28 })
    m.buttons = [m.btnPlay, m.btnDetails, m.btnList]
    rowBtns(m.buttons, x, 516, 20)

    m.heroTimer = layer.CreateChild("Timer")
    m.heroTimer.duration = 0.3
    m.heroTimer.repeat = false
    m.heroTimer.observeField("fire", "applyHero")
    m.heroItem = invalid
    m.heroFavorite = false
end sub

' Show a Card in the Hero after a short pause, so scrolling stays smooth.
sub heroShow(c as object, immediate = false as boolean)
    trailerStop()
    m.heroItem = c
    if immediate
        applyHero()
    else
        m.heroTimer.control = "stop"
        m.heroTimer.control = "start"
    end if
end sub

sub applyHero()
    c = m.heroItem
    if c = invalid then return
    t = th()
    m.heroEyebrow.text = UCase(c.rowTitle)
    title = c.heading
    size = 104
    if measureText(title, 104, "display") > 1200 then size = 80
    if size = 80 and measureText(title, 80, "display") > 1200 then size = 64
    m.heroTitle.font = makeFont(size, "display")
    m.heroTitle.text = title

    m.heroMetaHost.removeChildrenIndex(m.heroMetaHost.getChildCount(), 0)
    parts = []
    if c.itemType = "Episode"
        parts.Push(c.subtitle)
    else
        parts.Push(c.year)
        if c.rating <> "" then parts.Push({ text: c.rating, boxed: true })
        parts.Push(c.length)
        parts.Push(c.genre)
    end if
    makeMeta(m.heroMetaHost, parts, 22)
    m.heroBlurb.text = c.description

    if c.resumeSeconds > 0
        setBtnText(m.btnPlay, "Resume")
    else
        setBtnText(m.btnPlay, "Play")
    end if
    rowBtns(m.buttons, t.leftPad, 516, 20)
    m.heroFavorite = c.favorite
    if c.itemType = "Episode" and c.seriesId <> ""
        ' My List holds the show, so ask whether the show is saved.
        m.heroFavorite = false
        apiRequest("/Items/" + c.seriesId, { "userId": m.global.userId }, "onSeriesUserData", "GET", invalid, c.seriesId)
    end if
    paintListButton()

    if trailersOn() then trailerSchedule(c)
    if c.backdropUrl <> m.heroArt.uri
        m.heroArt.opacity = 0
        m.heroArt.uri = c.backdropUrl
    end if
end sub

sub onSeriesUserData(event as object)
    res = event.getData()
    if m.heroItem = invalid or safeStr(res.tag) <> m.heroItem.seriesId then return
    if res.ok and isValid(res.data)
        if isValid(res.data.UserData) then m.heroFavorite = isTrue(res.data.UserData.IsFavorite)
    end if
    paintListButton()
end sub

sub paintListButton()
    if m.heroFavorite
        setBtnIcon(m.btnList, "check")
    else
        setBtnIcon(m.btnList, "plus")
    end if
end sub

sub onHeroArtStatus()
    if m.heroArt.loadStatus = "ready" then m.heroFade.control = "start"
end sub

function trailersOn() as boolean
    p = m.global.prefs
    if p = invalid then return true
    return p.trailers <> false
end function

' ---------- Rows ----------

sub styleRows()
    t = th()
    m.rows.translation = [t.leftPad - t.cellPadX, t.rowsTop]
    m.rows.itemSize = [1920 - t.leftPad + t.cellPadX, t.posterH + t.cellPadY * 2 + 56]
    m.rows.rowItemSpacing = [[0, 0]]
    m.rows.itemSpacing = [0, 18]
    m.rows.rowLabelOffset = [[t.cellPadX, 2]]
    m.rows.rowLabelColor = t.heading
    m.rows.rowLabelFont = makeFont(26, "semibold")
end sub

sub load()
    lib = m.top.library
    m.kind = ""
    if lib <> invalid
        if isValid(lib.kind) then m.kind = lib.kind
    end if
    key = "home"
    if m.kind <> "" then key = m.kind
    setupMenu(key)
    m.status.visible = true
    apiRequest("/UserViews", { "userId": m.global.userId }, "onViews")
end sub

sub onViews(event as object)
    res = event.getData()
    views = []
    if res.ok and isValid(res.data)
        if isValid(res.data.Items)
            for each v in res.data.Items
                ct = safeStr(v.CollectionType)
                if ct = "movies" or ct = "tvshows"
                    views.Push({ id: safeStr(v.Id), name: safeStr(v.Name), collectionType: ct })
                end if
            end for
        end if
        m.global.views = views
    else if not res.ok
        m.status.text = "Couldn't reach your Jellyfin server (error " + res.code.ToStr() + ")."
        return
    end if
    if m.kind = ""
        loadHome()
    else
        loadLibrary()
    end if
end sub

function baseQuery(extra as object) as object
    q = { "userId": m.global.userId, "Fields": "Overview,Genres,ChildCount", "EnableTotalRecordCount": "false", "Limit": "24" }
    q.Append(extra)
    return q
end function

sub loadHome()
    portrait = th().portraitPosters
    defs = []
    defs.Push({ title: "Continue watching", path: "/UserItems/Resume", landscape: true, kind: "resume", action: "play", query: baseQuery({ "MediaTypes": "Video" }) })
    defs.Push({ title: "Next up", path: "/Shows/NextUp", landscape: true, kind: "", action: "play", query: baseQuery({}) })
    defs.Push({ title: "Recently added", path: "/Items/Latest", landscape: not portrait, kind: "", action: "details", query: baseQuery({ "IncludeItemTypes": "Movie,Series" }) })
    defs.Push({ title: "Picked for you", path: "/Items", landscape: not portrait, kind: "", action: "details", query: baseQuery({ "Recursive": "true", "IncludeItemTypes": "Movie,Series", "SortBy": "Random" }) })
    defs.Push({ title: "Highly rated", path: "/Items", landscape: not portrait, kind: "", action: "details", query: baseQuery({ "Recursive": "true", "IncludeItemTypes": "Movie,Series", "SortBy": "CommunityRating", "SortOrder": "Descending" }) })
    fetchRows(defs)
end sub

sub loadLibrary()
    m.libTypes = "Movie"
    if m.kind = "series" then m.libTypes = "Series"
    apiRequest("/Genres", { "userId": m.global.userId, "Recursive": "true", "SortBy": "SortName", "IncludeItemTypes": m.libTypes }, "onGenres")
end sub

function libQuery(extra as object) as object
    q = baseQuery({ "Recursive": "true", "IncludeItemTypes": m.libTypes, "Limit": "30" })
    q.Append(extra)
    return q
end function

sub onGenres(event as object)
    res = event.getData()
    portrait = th().portraitPosters
    resumeTypes = "Movie"
    if m.kind = "series" then resumeTypes = "Episode"
    defs = []
    defs.Push({ title: "Continue watching", path: "/UserItems/Resume", landscape: true, kind: "resume", action: "play", query: baseQuery({ "MediaTypes": "Video", "IncludeItemTypes": resumeTypes }) })
    defs.Push({ title: "Recently added", path: "/Items", landscape: not portrait, kind: "", action: "details", query: libQuery({ "SortBy": "DateCreated", "SortOrder": "Descending" }) })
    defs.Push({ title: "Not watched yet", path: "/Items", landscape: not portrait, kind: "", action: "details", query: libQuery({ "Filters": "IsUnplayed", "SortBy": "Random" }) })
    if res.ok and isValid(res.data)
        if isValid(res.data.Items)
            n = 0
            for each g in res.data.Items
                if n < 14
                    defs.Push({ title: safeStr(g.Name), path: "/Items", landscape: not portrait, kind: "", action: "details", query: libQuery({ "GenreIds": safeStr(g.Id), "SortBy": "Random" }) })
                end if
                n = n + 1
            end for
        end if
    end if
    fetchRows(defs)
end sub

sub fetchRows(defs as object)
    m.gen = m.gen + 1
    m.rowDefs = defs
    m.rowResults = []
    for i = 0 to defs.Count() - 1
        m.rowResults.Push(invalid)
    end for
    m.pending = defs.Count()
    for i = 0 to defs.Count() - 1
        d = defs[i]
        apiRequest(d.path, d.query, "onRowData", "GET", invalid, m.gen * 1000 + i)
    end for
end sub

sub onRowData(event as object)
    res = event.getData()
    tag = res.tag
    if tag \ 1000 <> m.gen then return
    i = tag mod 1000
    items = []
    if res.ok and isValid(res.data)
        if type(res.data) = "roArray"
            items = res.data
        else if isValid(res.data.Items)
            items = res.data.Items
        end if
    end if
    m.rowResults[i] = items
    m.pending = m.pending - 1
    if m.pending <= 0 then buildRows()
end sub

sub buildRows()
    root = CreateObject("roSGNode", "ContentNode")
    sizes = []
    heights = []
    m.rowActions = []
    for i = 0 to m.rowDefs.Count() - 1
        items = m.rowResults[i]
        d = m.rowDefs[i]
        if items <> invalid
            if items.Count() > 0
                row = root.CreateChild("ContentNode")
                row.title = d.title
                for each it in items
                    c = itemToContent(it, d.landscape, d.kind)
                    c.rowTitle = d.title
                    row.appendChild(c)
                end for
                cell = cellSize(d.landscape)
                sizes.Push(cell)
                heights.Push(cell[1] + 56)
                m.rowActions.Push(d.action)
            end if
        end if
    end for

    if root.getChildCount() = 0
        m.status.text = "Nothing here yet. Once Jellyfin has some movies or shows, they'll show up here."
        m.status.visible = true
        m.rows.visible = false
        return
    end if

    m.status.visible = false
    m.rows.rowItemSize = sizes
    m.rows.rowHeights = heights
    m.rows.content = root
    m.rows.visible = true
    if m.top.isInFocusChain() and not menuIsOpen() and m.zone = "rows" then m.rows.setFocus(true)
    heroShow(root.getChild(0).getChild(0), true)
    if m.kind = "" then savePreview(root)
end sub

' A few Cards for the live preview on the Themes screen.
sub savePreview(root as object)
    preview = []
    row = root.getChild(0)
    for i = 0 to row.getChildCount() - 1
        if preview.Count() < 6
            c = row.getChild(i)
            preview.Push({ heading: c.heading, meta: c.meta, backdrop: c.backdropUrl, image: c.HDPosterUrl, progress: c.progress })
        end if
    end for
    m.global.previewItems = preview
end sub

' ---------- Focus & selection ----------

sub onItemFocused(event as object)
    idx = event.getData()
    if idx = invalid or m.rows.content = invalid then return
    row = m.rows.content.getChild(idx[0])
    if row = invalid then return
    c = row.getChild(idx[1])
    if c = invalid then return
    m.focused = c
    heroShow(c)
end sub

sub onItemSelected(event as object)
    idx = event.getData()
    row = m.rows.content.getChild(idx[0])
    if row = invalid then return
    c = row.getChild(idx[1])
    if c = invalid then return
    openItem(c, m.rowActions[idx[0]])
end sub

sub openItem(c as object, action as string)
    if action = "play" and c.itemType <> "Series"
        m.top.navigate = { action: "play", itemId: c.itemId, startSeconds: c.resumeSeconds }
    else if action = "play"
        playSeries(c.itemId)
    else
        id = c.itemId
        if c.itemType = "Episode" and c.seriesId <> "" then id = c.seriesId
        m.top.navigate = { action: "details", itemId: id, seasonId: c.seasonId }
    end if
end sub

' Play a show: its next episode, or the first one.
sub playSeries(seriesId as string)
    m.playSeriesId = seriesId
    apiRequest("/Shows/NextUp", { "userId": m.global.userId, "seriesId": seriesId, "Limit": "1", "EnableResumable": "true" }, "onSeriesNext")
end sub

sub onSeriesNext(event as object)
    res = event.getData()
    ep = invalid
    if res.ok and isValid(res.data)
        if isValid(res.data.Items)
            if res.data.Items.Count() > 0 then ep = res.data.Items[0]
        end if
    end if
    if ep <> invalid
        startSecs = 0
        if isValid(ep.UserData) then startSecs = ticksToSeconds(ep.UserData.PlaybackPositionTicks)
        m.top.navigate = { action: "play", itemId: safeStr(ep.Id), startSeconds: startSecs }
    else
        m.top.navigate = { action: "details", itemId: m.playSeriesId }
    end if
end sub

sub heroButton(index as integer)
    c = m.heroItem
    if c = invalid then return
    if index = 0
        if c.itemType = "Series"
            playSeries(c.itemId)
        else
            m.top.navigate = { action: "play", itemId: c.itemId, startSeconds: c.resumeSeconds }
        end if
    else if index = 1
        openItem(c, "details")
    else
        target = c.itemId
        if c.itemType = "Episode" and c.seriesId <> "" then target = c.seriesId
        m.heroFavorite = not m.heroFavorite
        if c.itemType <> "Episode" then c.favorite = m.heroFavorite
        setFavorite(target, m.heroFavorite)
        paintListButton()
    end if
end sub

sub setZone(zone as string)
    m.zone = zone
    focusIndex = -1
    if zone = "buttons" then focusIndex = m.btnIndex
    paintBtns(m.buttons, focusIndex)
    badgeFocus = -1
    if zone = "badges" then badgeFocus = m.badgeIndex
    paintTopBadges(m.badges, badgeFocus)
    if zone = "rows"
        restoreRows()
    else
        m.top.setFocus(true)
    end if
end sub

sub restoreRows()
    if m.rows.content <> invalid and m.rows.visible
        m.rows.setFocus(true)
    else
        m.top.setFocus(true)
    end if
end sub

sub restoreContentFocus()
    setZone(m.zone)
end sub

sub onFocusChanged()
    if m.top.hasFocus() and not menuIsOpen() and m.zone = "rows"
        if m.rows.content <> invalid and m.rows.visible then m.rows.setFocus(true)
    end if
end sub

sub onRefresh()
    ' The look changed on the Themes screen: rebuild with it.
    if m.global.prefsVersion <> m.seenPrefs
        m.seenPrefs = m.global.prefsVersion
        m.top.navigate = { action: "rebuildHome" }
        return
    end if
    if m.global.watchVersion <> m.seenVersion
        m.seenVersion = m.global.watchVersion
        if m.rowDefs <> invalid then fetchRows(m.rowDefs)
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or menuIsOpen() then return false
    if key = "play"
        if toggleTrailerSound() then return true
        heroButton(0)
        return true
    end if
    if m.zone = "rows"
        if key = "left"
            openMenu()
            return true
        else if key = "up"
            setZone("buttons")
            return true
        else if key = "options"
            if m.focused <> invalid then openItem(m.focused, "details")
            return true
        else if key = "back"
            ' Back from lower Rows jumps to the top instead of exiting.
            f = m.rows.rowItemFocused
            if m.rows.content <> invalid and f <> invalid
                if f[0] > 0 or f[1] > 0
                    m.rows.jumpToRowItem = [0, 0]
                    return true
                end if
            end if
        end if
        return false
    else if m.zone = "buttons"
        if key = "left"
            if m.btnIndex = 0
                openMenu()
            else
                m.btnIndex = m.btnIndex - 1
                paintBtns(m.buttons, m.btnIndex)
            end if
        else if key = "right"
            if m.btnIndex < m.buttons.Count() - 1 then m.btnIndex = m.btnIndex + 1
            paintBtns(m.buttons, m.btnIndex)
        else if key = "down" or key = "back"
            setZone("rows")
        else if key = "up"
            setZone("badges")
        else if key = "OK"
            heroButton(m.btnIndex)
        end if
        return true
    else if m.zone = "badges"
        if key = "left"
            m.badgeIndex = 0
            paintTopBadges(m.badges, m.badgeIndex)
        else if key = "right"
            m.badgeIndex = 1
            paintTopBadges(m.badges, m.badgeIndex)
        else if key = "down" or key = "back"
            setZone("buttons")
        else if key = "OK"
            if m.badgeIndex = 0
                m.top.navigate = { action: "settings" }
            else
                m.top.navigate = { action: "switchUser" }
            end if
        end if
        return true
    end if
    return false
end function
