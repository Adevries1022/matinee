<?xml version="1.0" encoding="utf-8" ?>
<!-- A movie or show: artwork on the right, details and buttons on the left,
     then season pills and episode Cards (shows) or "More like this" (movies). -->
<component name="DetailsScreen" extends="Group">
  <interface>
    <field id="itemId" type="string" onChange="load" />
    <field id="seasonId" type="string" />
    <field id="backLabel" type="string" value="Home" />
    <field id="refresh" type="boolean" alwaysNotify="true" onChange="onRefresh" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="DetailsScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <children>
    <Poster id="art" translation="[640,0]" width="1280" height="1080" loadWidth="1280" loadHeight="1080" loadDisplayMode="scaleToZoom" opacity="0" />
    <Group id="layer" />
    <RowList
      id="cards"
      itemComponentName="CardItem"
      numRows="1"
      showRowLabel="[false]"
      drawFocusFeedback="false"
      rowFocusAnimationStyle="floatingFocus"
      visible="false" />
    <Group id="sink" focusable="true" />
    <Animation id="fadeIn" duration="0.35" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="art.opacity" />
    </Animation>
  </children>
</component>
