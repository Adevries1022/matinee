' One Discover category as a grid of titles: a genre (movies or series), or
' a streaming service with Movies and Series tabs. More pages load as you
' scroll. OK on a title opens the request panel; Back returns to Discover.

sub init()
    t = th()
    m.layer = m.top.findNode("layer")
    m.grid = m.top.findNode("grid")
    m.modal = m.top.findNode("modal")
    m.sink = m.top.findNode("sink")

    m.back = makeBackPill(m.layer, m.top.backLabel)
    m.heading = makeTitle(m.layer, "", 64)
    m.heading.translation = [160, 130]
    m.sub = makeLabel(m.layer, "", 20, "regular", t.muted)
    m.sub.translation = [160, 232]
    m.sub.width = 1100
    m.tabHost = m.layer.CreateChild("Group")
    m.tabs = []

    pad = t.cellPadX
    m.grid.translation = [160 - pad, 290 - pad]
    m.grid.itemSize = [389 + pad * 2, 219 + pad * 2 + 72]
    m.grid.itemSpacing = [28 - pad * 2, 36 - pad * 2]
    m.grid.observeField("itemSelected", "onSelected")
    m.grid.observeField("itemFocused", "onFocused")
    m.top.observeField("focusedChild", "onFocusChanged")

    m.tab = 0
    m.zone = "grid"
    m.items = []
    m.page = 1
    m.loadingMore = false
    m.gen = 0
    m.cat = invalid
    panelInit()
end sub

sub onCategory()
    m.cat = m.top.category
    if m.cat = invalid then return
    m.heading.text = safeStr(m.cat.name)
    if m.cat.kind = "service"
        m.tabs = makePills(m.tabHost, ["Movies", "Series"], 0)
        last = m.tabs[m.tabs.Count() - 1]
        m.tabHost.translation = [1800 - (last.group.translation[0] + last.w), 200]
    end if
    panelLoad()
    loadTab()
end sub

' Seerr's settings aren't needed here beyond 4K, which the panel handles.
sub panelSettings()
end sub

function gridMediaType() as string
    if m.cat.kind = "genre" then return safeStr(m.cat.mediaType)
    if m.tab = 1 then return "tv"
    return "movie"
end function

function pagePath() as string
    if gridMediaType() = "tv" then return "/discover/tv"
    return "/discover/movies"
end function

function pageQuery(page as integer) as object
    q = { "page": page.ToStr() }
    if m.cat.kind = "genre"
        q["genre"] = safeStr(m.cat.id)
    else
        q["watchProviders"] = safeStr(m.cat.id)
        q["watchRegion"] = safeStr(m.cat.region)
    end if
    return q
end function

sub loadTab()
    m.gen = m.gen + 1
    m.items = []
    m.page = 1
    kind = "movies"
    if gridMediaType() = "tv" then kind = "series"
    if m.cat.kind = "genre"
        m.sub.text = "Popular " + kind + " in " + safeStr(m.cat.name) + ". Press OK on one to request it."
    else
        m.sub.text = "Popular " + kind + " on " + safeStr(m.cat.name) + ". Press OK on one to request it."
    end if
    m.sub.color = th().muted
    paint()
    seerrRequest(pagePath(), pageQuery(1), "onPage", "GET", invalid, m.gen)
end sub

sub onPage(event as object)
    res = event.getData()
    if res.tag <> m.gen then return
    m.loadingMore = false
    if res.ok and isValid(res.data)
        if isValid(res.data.results)
            mt = gridMediaType()
            for each r in res.data.results
                m.items.Push(discoverContent(r, mt))
            end for
        end if
    else if res.code = 401 or res.code = 403
        m.top.navigate = { action: "seerrSignedOut" }
    end if
    render()
end sub

sub onFocused(event as object)
    i = event.getData()
    ' Keep going: fetch the next page near the end.
    if not m.loadingMore and i >= m.items.Count() - 8 and m.page < 5 and m.items.Count() >= 20
        m.loadingMore = true
        m.page = m.page + 1
        seerrRequest(pagePath(), pageQuery(m.page), "onMore", "GET", invalid, m.gen)
    end if
end sub

sub onMore(event as object)
    res = event.getData()
    if res.tag <> m.gen then return
    m.loadingMore = false
    if not res.ok or not isValid(res.data) then return
    if not isValid(res.data.results) then return
    root = m.grid.content
    mt = gridMediaType()
    for each r in res.data.results
        c = discoverContent(r, mt)
        m.items.Push(c)
        root.appendChild(c)
    end for
end sub

sub render()
    root = CreateObject("roSGNode", "ContentNode")
    for each c in m.items
        root.appendChild(c)
    end for
    m.grid.content = root
    m.grid.visible = m.items.Count() > 0
    if m.items.Count() = 0
        m.sub.text = "Nothing here right now."
    end if
    if m.top.isInFocusChain() and not m.modalOpen then restoreContentFocus()
end sub

sub paint()
    if m.tabs.Count() = 0 then return
    focusTab = -1
    if m.zone = "tabs" then focusTab = m.tab
    selectPill(m.tabs, m.tab, focusTab)
end sub

sub onSelected(event as object)
    i = event.getData()
    if i < 0 or i >= m.items.Count() then return
    chooseTitle(m.items[i])
end sub

sub panelNote(text as string)
    m.sub.text = text
    m.sub.color = th().accent
end sub

sub panelRequested()
    render()
end sub

' ---------- Focus & keys ----------

sub restoreContentFocus()
    if m.zone = "grid" and m.grid.visible
        m.grid.setFocus(true)
    else
        m.sink.setFocus(true)
    end if
end sub

sub onFocusChanged()
    if m.top.hasFocus() and not m.modalOpen then restoreContentFocus()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.modalOpen then return modalKey(key)
    if m.zone = "grid"
        if key = "up" and m.tabs.Count() > 0
            m.zone = "tabs"
            paint()
            restoreContentFocus()
            return true
        end if
        return false
    else if m.zone = "tabs"
        if key = "left" and m.tab > 0
            m.tab = m.tab - 1
            loadTab()
        else if key = "right" and m.tab < m.tabs.Count() - 1
            m.tab = m.tab + 1
            loadTab()
        else if key = "down" or key = "OK"
            m.zone = "grid"
            paint()
            restoreContentFocus()
        else if key = "back"
            return false
        end if
        return true
    end if
    return false
end function
