<?xml version="1.0" encoding="utf-8" ?>
<!-- Who's watching: pick a User, add one, or manage saved sign-ins. -->
<component name="WhoScreen" extends="Group">
  <interface>
    <field id="message" type="string" onChange="onMessage" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="WhoScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <children>
    <Group id="layer" />
    <Group id="strip" />
    <Group id="modal" visible="false" />
  </children>
</component>
