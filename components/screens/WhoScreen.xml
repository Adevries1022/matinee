<?xml version="1.0" encoding="utf-8" ?>
<!-- Who's Watching: pick a User. -->
<component name="WhoScreen" extends="Group">
  <interface>
    <field id="message" type="string" onChange="onMessage" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="WhoScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <children>
    <Label id="brand" text="MATINEE" translation="[160,60]">
      <Font role="font" uri="font:BoldSystemFontFile" size="30" />
    </Label>
    <Label id="heading" translation="[0,250]" width="1920" horizAlign="center" text="Who's watching?">
      <Font role="font" uri="font:BoldSystemFontFile" size="72" />
    </Label>
    <Group id="strip" translation="[96,420]" />
    <Label id="status" translation="[160,820]" width="1600" horizAlign="center" wrap="true">
      <Font role="font" uri="font:SystemFontFile" size="28" />
    </Label>
    <Label id="tip" translation="[0,1000]" width="1920" horizAlign="center" text="Press * on your remote to change server">
      <Font role="font" uri="font:SystemFontFile" size="24" />
    </Label>
  </children>
</component>
