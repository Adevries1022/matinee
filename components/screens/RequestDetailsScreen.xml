<?xml version="1.0" encoding="utf-8" ?>
<!-- Request Details: a Seerr title that isn't (all) on the server, laid out
     like Detail. Request in place of Play, season pills for shows, and
     "More like this". -->
<component name="RequestDetailsScreen" extends="Group">
  <interface>
    <!-- media: { tmdbId, mediaType: "movie" | "tv" } -->
    <field id="media" type="assocarray" onChange="load" />
    <!-- The Card it was opened from, whose badge a request updates. -->
    <field id="card" type="node" />
    <field id="backLabel" type="string" value="Discover" />
    <field id="refresh" type="boolean" alwaysNotify="true" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="RequestDetailsScreen.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Api.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ui.bs" />
  <script type="text/brightscript" uri="pkg:/components/util/Ratings.bs" />
  <children>
    <Poster id="art" translation="[640,0]" width="1280" height="1080" loadWidth="1280" loadHeight="1080" loadDisplayMode="scaleToZoom" opacity="0" />
    <Group id="layer" />
    <RowList
      id="cards"
      itemComponentName="CardItem"
      numRows="1"
      showRowLabel="[false]"
      drawFocusFeedback="false"
      rowFocusAnimationStyle="floatingFocus"
      visible="false" />
    <Group id="sink" focusable="true" />
    <Animation id="fadeIn" duration="0.35" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="art.opacity" />
    </Animation>
  </children>
</component>
