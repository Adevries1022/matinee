' The request panel, shared by Discover and its category grids: quality,
' seasons for shows, then Send request. Requests go out as the signed-in
' User's own Seerr account.
' The screen has m.modal and m.sink nodes, and defines restoreContentFocus(),
' panelNote(text) for short messages, panelSettings() for when Seerr's public
' settings arrive, and panelRequested() after a request goes through.

sub panelInit()
    m.perms = 0
    m.modalOpen = false
    m.seerrSettings = invalid
    ' 4K needs the setting here and a 4K server in Seerr for that media type.
    m.show4k = readSetting("seerr4k", "false") = "true"
    m.has4k = { movie: false, tv: false }
end sub

' Ask Seerr who's signed in (for auto-approval) and for its public settings.
sub panelLoad()
    seerrRequest("/auth/me", {}, "onPanelMe")
    seerrRequest("/settings/public", {}, "onPanelSettings")
end sub

sub onPanelMe(event as object)
    res = event.getData()
    if res.ok and isValid(res.data)
        m.perms = safeInt(res.data.permissions)
        if m.modalOpen then drawPanel()
    else if res.code = 401 or res.code = 403
        m.top.navigate = { action: "seerrSignedOut" }
    end if
end sub

sub onPanelSettings(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data)
        panelSettings()
        return
    end if
    m.seerrSettings = res.data
    m.has4k = { movie: isTrue(res.data.movie4kEnabled), tv: isTrue(res.data.series4kEnabled) }
    panelSettings()
    if not m.modalOpen then return
    ' The panel can open first when coming from Search.
    if not m.qualityPicked then m.quality = defaultQuality()
    drawPanel()
end sub

' The country for streaming services: Seerr's streaming or discover region.
function seerrRegion() as string
    s = m.seerrSettings
    if s <> invalid
        for each k in ["streamingRegion", "discoverRegion", "region"]
            v = safeStr(s[k])
            if Len(v) = 2 then return v
        end for
    end if
    return "US"
end function

' A Seerr title as a backdrop Card for Discover's Rows and grids.
function discoverContent(r as object, mediaType = "" as string) as object
    if safeStr(r.mediaType) = "" and mediaType <> "" then r.mediaType = mediaType
    c = seerrToContent(r)
    url = tmdbImage(r.backdropPath, "w780")
    if url = "" then url = tmdbImage(r.posterPath, "w500")
    c.HDPosterUrl = url
    if c.backdropUrl = "" then c.backdropUrl = url
    setCardSize(c, true)
    return c
end function

' OK on a title: Details when it's on the server, a note while it's on its
' way, otherwise the request panel.
sub chooseTitle(c as object)
    s = c.requestStatus
    if s = 5
        if c.jellyfinId <> "" then m.top.navigate = { action: "details", itemId: c.jellyfinId }
    else if s = 2
        panelNote("Already requested " + Chr(183) + " waiting for approval")
    else if s = 3
        panelNote("Already requested " + Chr(183) + " downloading")
    else
        openPanel(c)
    end if
end sub

' Open the panel for { tmdbId, mediaType } (from Search).
sub openPanelFor(o as object)
    mt = safeStr(o.mediaType)
    seerrRequest("/" + mt + "/" + safeStr(o.tmdbId), {}, "onOpenDetail", "GET", invalid, mt)
end sub

sub onOpenDetail(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    openPanel(discoverContent(res.data, safeStr(res.tag)))
end sub

sub openPanel(c as object)
    m.cur = c
    m.isTv = (c.itemType = "seerr-tv")
    m.quality = defaultQuality()
    m.qualityPicked = false
    m.seasonChoice = 0
    m.seasonCount = 0
    m.modalRow = 0
    m.modalCol = 0
    m.modalOpen = true
    if m.isTv
        seerrRequest("/tv/" + c.itemId, {}, "onTvSeasons")
    end if
    drawPanel()
    m.modal.visible = true
    m.sink.setFocus(true)
end sub

sub onTvSeasons(event as object)
    res = event.getData()
    if not res.ok or not isValid(res.data) then return
    n = 0
    if isValid(res.data.seasons)
        for each s in res.data.seasons
            if safeInt(s.seasonNumber) > 0 then n = n + 1
        end for
    end if
    m.seasonCount = n
    if m.modalOpen then drawPanel()
end sub

function seasonLabels() as object
    labels = ["All seasons", "Season 1"]
    if m.seasonCount > 1 then labels.Push("Latest only")
    return labels
end function

function can4k() as boolean
    if not m.show4k then return false
    if m.isTv then return m.has4k.tv
    return m.has4k.movie
end function

function defaultQuality() as integer
    if can4k() and readSetting("seerrQuality", "1080p") = "4K" then return 1
    return 0
end function

function qualityLabels() as object
    if can4k() then return ["1080p", "4K"]
    return ["1080p"]
end function

function modalRows() as object
    rows = ["quality"]
    if m.isTv then rows.Push("seasons")
    rows.Push("buttons")
    return rows
end function

sub drawPanel()
    t = th()
    m.modal.removeChildrenIndex(m.modal.getChildCount(), 0)
    h = 516
    if m.isTv then h = 636
    md = makeModal(m.modal, 820, h)
    b = md.body
    art = b.CreateChild("Poster")
    art.translation = [48, 48]
    art.width = 200
    art.height = 112
    art.loadWidth = 200
    art.loadHeight = 112
    art.loadDisplayMode = "scaleToZoom"
    art.uri = m.cur.HDPosterUrl
    makeShape(b, "pkg:/images/corners_r12.9.png", 200, 112, t.panel).translation = [48, 48]
    kind = "movie"
    if m.isTv then kind = "series"
    makeLabel(b, "Request " + kind, 18, "regular", t.muted).translation = [276, 62]
    tl = makeTitle(b, m.cur.heading, 40)
    tl.translation = [276, 88]
    tl.width = 500
    rows = modalRows()
    focusRow = rows[m.modalRow]
    y = 196
    makeLabel(b, "Quality", 20, "semibold", t.text).translation = [48, y]
    qHost = b.CreateChild("Group")
    qHost.translation = [48, y + 36]
    m.qPills = makePills(qHost, qualityLabels(), m.quality, 60, 20)
    fq = -1
    if focusRow = "quality" then fq = m.modalCol
    selectPill(m.qPills, m.quality, fq)
    y = y + 120
    if m.isTv
        makeLabel(b, "Seasons", 20, "semibold", t.text).translation = [48, y]
        sHost = b.CreateChild("Group")
        sHost.translation = [48, y + 36]
        m.sPills = makePills(sHost, seasonLabels(), m.seasonChoice, 60, 20)
        fs = -1
        if focusRow = "seasons" then fs = m.modalCol
        selectPill(m.sPills, m.seasonChoice, fs)
        y = y + 120
    end if
    dest = "Radarr"
    if m.isTv then dest = "Sonarr"
    approval = "needs an admin to approve"
    if seerrAutoApproves(m.perms, m.isTv, m.quality = 1) then approval = "approved automatically"
    makeBox(b, 724, 60, 12, t.raised).translation = [48, y]
    il = makeLabel(b, "Sends to " + dest + " " + Chr(183) + " " + approval, 18, "regular", t.meta)
    il.translation = [68, y]
    il.height = 60
    il.vertAlign = "center"
    y = y + 92
    send = makeBtn(b, { kind: "primary", text: "Send request", size: 22, padX: 40 })
    cancel = makeBtn(b, { kind: "secondary", text: "Cancel", size: 22, padX: 32 })
    rowBtns([send, cancel], 48, y, 16)
    fb = -1
    if focusRow = "buttons" then fb = m.modalCol
    paintBtns([send, cancel], fb)
    send.bg.blendColor = t.accent
    send.label.color = t.bg
end sub

sub closePanel()
    m.modalOpen = false
    m.modal.visible = false
    restoreContentFocus()
end sub

sub sendRequest()
    c = m.cur
    body = { "mediaType": "movie", "mediaId": c.itemId.ToInt(), "is4k": (m.quality = 1) }
    if m.isTv
        body.mediaType = "tv"
        if m.seasonChoice = 0
            body.seasons = "all"
        else if m.seasonChoice = 1
            body.seasons = [1]
        else
            body.seasons = [m.seasonCount]
        end if
    end if
    panelNote("Sending your request...")
    seerrRequest("/request", {}, "onRequested", "POST", body)
    closePanel()
end sub

sub onRequested(event as object)
    res = event.getData()
    if res.ok
        panelNote("Requested " + m.cur.heading + ". It" + Chr(8217) + "s in My requests until it" + Chr(8217) + "s ready to watch.")
        m.cur.requestStatus = 2
        m.cur.badge = requestStatusLabel(2)
        panelRequested()
    else if res.code = 403
        panelNote("Your Seerr account isn" + Chr(8217) + "t allowed to request this. Ask an Administrator.")
    else if res.code = 409
        panelNote("Someone has already requested this.")
    else if res.code = 401
        m.top.navigate = { action: "seerrSignedOut" }
    else
        panelNote("The request didn" + Chr(8217) + "t go through (error " + res.code.ToStr() + ").")
    end if
end sub

function modalKey(key as string) as boolean
    rows = modalRows()
    row = rows[m.modalRow]
    count = 2
    if row = "quality" then count = qualityLabels().Count()
    if row = "seasons" then count = seasonLabels().Count()
    if key = "back"
        closePanel()
    else if key = "up"
        if m.modalRow > 0
            m.modalRow = m.modalRow - 1
            m.modalCol = 0
        end if
    else if key = "down"
        if m.modalRow < rows.Count() - 1
            m.modalRow = m.modalRow + 1
            m.modalCol = 0
        end if
    else if key = "left"
        if m.modalCol > 0 then m.modalCol = m.modalCol - 1
    else if key = "right"
        if m.modalCol < count - 1 then m.modalCol = m.modalCol + 1
    else if key = "OK"
        if row = "quality"
            m.quality = m.modalCol
            m.qualityPicked = true
        else if row = "seasons"
            m.seasonChoice = m.modalCol
        else if m.modalCol = 0
            sendRequest()
            return true
        else
            closePanel()
            return true
        end if
    end if
    if m.modalOpen then drawPanel()
    return true
end function
