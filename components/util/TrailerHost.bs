' Trailer Preview: after a title has been Focused for a few seconds, its
' trailer fades in behind the Hero text, shifted right so more of it shows,
' with its edges fading into the screen. The Hero backdrop
' fades away while it plays. It has sound unless Trailer sound in Playback
' & quality is off, and the screen's header fades out. Only trailer files
' stored on the server are used (for example ones downloaded by Trailarr).
' Play toggles the sound. Moving focus or leaving the screen stops it, and
' Trailer previews in Playback & quality turns it off.
'
' Auto-play: staying on a title opens the player and starts it, like the
' streaming services: when its Trailer Preview ends, or after
' autoPlaySeconds when there's no trailer. The screen can set m.autoSeconds
' for a different wait (titles the User is watching skip the trailer and
' use autoResumeSeconds). The last autoCountSeconds of the wait, or of the
' trailer, show the Auto-play Countdown ("Starting in 5" with a filling
' bar) at the bottom right. Any key press restarts the wait; moving to
' another title or leaving the screen cancels it. It's off until "Start a
' title you stay on" in Playback & quality is turned on. The screen defines
' autoPlayStart().

' area: [x, y, w, h] where the trailer plays; its left, top and bottom edges
' fade into the background. backdrop: the Hero artwork (with an id), faded
' out while the trailer plays. chrome: the header (wordmark, server pill,
' avatar) to fade out too. It needs an id.
sub setupTrailer(layer as object, insertIndex as integer, area as object, backdrop as object, chrome as object)
    t = th()
    x = area[0]
    y = area[1]
    w = area[2]
    h = area[3]
    grp = CreateObject("roSGNode", "Group")
    grp.id = "trailerGroup"
    grp.opacity = 0
    grp.visible = false
    layer.insertChild(grp, insertIndex)
    m.trailerGroup = grp
    v = grp.CreateChild("Video")
    v.translation = [x, y]
    v.width = w
    v.height = h
    v.enableUI = false
    v.mute = true
    v.observeField("state", "onTrailerState")
    v.notificationInterval = 0.5
    v.observeField("position", "onTrailerPosition")
    m.trailerVideo = v
    ' Soft edges in the background color, so the picture melts into the screen.
    edgeL = makeFade(grp, "h", t.trailerFeatherX, h)
    edgeL.translation = [x, y]
    ' A top edge below the top of the screen fades too.
    if y > 0
        edgeT = grp.CreateChild("Poster")
        edgeT.uri = "pkg:/images/grad_vd.png"
        edgeT.loadDisplayMode = "scaleToFill"
        edgeT.blendColor = t.bg
        edgeT.width = w
        edgeT.height = t.trailerFeatherY
        edgeT.translation = [x, y]
    end if
    edgeB = makeFadeUp(grp, w, t.trailerFeatherY, t.bg)
    edgeB.translation = [x, y + h - t.trailerFeatherY]

    ' A quiet hint so people know the sound is one press away.
    m.trailerHint = makeLabel(layer, "Press Play for sound", 24, true, t.muted)
    ' At the right, just above the Rows.
    m.trailerHint.translation = [x + w - 96 - 400, t.rowsTop - 40]
    m.trailerHint.width = 400
    m.trailerHint.horizAlign = "right"
    m.trailerHint.visible = false

    ' The Auto-play Countdown pill, in the same spot as the hint.
    pw = t.countPillW
    ph = t.countPillH
    m.countPill = layer.CreateChild("Group")
    m.countPill.translation = [x + w - 96 - pw, t.rowsTop - 40 - (ph - 32) \ 2]
    m.countPill.visible = false
    makeBox(m.countPill, pw, ph, ph \ 2, t.black, 0.55)
    m.countText = makeLabel(m.countPill, "", 22, "semibold", t.text)
    m.countText.width = pw
    m.countText.height = ph - 8
    m.countText.horizAlign = "center"
    m.countText.vertAlign = "center"
    barX = ph \ 2
    barW = pw - barX * 2
    barY = ph - 10 - t.countBarH
    track = m.countPill.CreateChild("Rectangle")
    track.translation = [barX, barY]
    track.width = barW
    track.height = t.countBarH
    track.color = t.barBg
    m.countFill = m.countPill.CreateChild("Rectangle")
    m.countFill.id = "countFill"
    m.countFill.translation = [barX, barY]
    m.countFill.width = 0
    m.countFill.height = t.countBarH
    m.countFill.color = t.accent
    m.countAnim = m.countPill.CreateChild("Animation")
    m.countAnim.easeFunction = "linear"
    ci0 = m.countAnim.CreateChild("FloatFieldInterpolator")
    ci0.key = [0.0, 1.0]
    ci0.keyValue = [0.0, barW * 1.0]
    ci0.fieldToInterp = "countFill.width"
    m.countBarW = barW
    m.countTick = layer.CreateChild("Timer")
    m.countTick.duration = 1
    m.countTick.repeat = true
    m.countTick.observeField("fire", "onCountTick")
    m.counting = false
    m.autoRearm = false

    m.trailerBackdrop = backdrop
    m.trailerFade = layer.CreateChild("Animation")
    m.trailerFade.duration = 0.8
    m.trailerFade.easeFunction = "outQuad"
    interp = m.trailerFade.CreateChild("FloatFieldInterpolator")
    interp.key = [0.0, 1.0]
    interp.keyValue = [0.0, 1.0]
    interp.fieldToInterp = "trailerGroup.opacity"
    bi = m.trailerFade.CreateChild("FloatFieldInterpolator")
    bi.key = [0.0, 1.0]
    bi.keyValue = [1.0, 0.0]
    bi.fieldToInterp = backdrop.id + ".opacity"

    m.trailerChrome = chrome
    m.chromeFade = m.top.CreateChild("Animation")
    m.chromeFade.duration = 0.8
    m.chromeFade.easeFunction = "outQuad"
    ci = m.chromeFade.CreateChild("FloatFieldInterpolator")
    ci.key = [0.0, 1.0]
    ci.keyValue = [1.0, 0.0]
    ci.fieldToInterp = chrome.id + ".opacity"

    m.trailerTimer = layer.CreateChild("Timer")
    m.trailerTimer.duration = th().trailerDelaySeconds
    m.trailerTimer.repeat = false
    m.trailerTimer.observeField("fire", "trailerFetch")

    m.autoTimer = layer.CreateChild("Timer")
    m.autoTimer.repeat = false
    m.autoTimer.observeField("fire", "onAutoWaitDone")
    m.autoArmed = false

    m.trailerFor = ""
    m.trailerWant = ""
    m.trailerItem = invalid
    m.trailerTry = ""
    m.trailerPlaying = false
    m.top.observeField("visible", "onTrailerScreenVisible")
end sub

' ---------- Auto-play ----------

function autoPlayOn() as boolean
    p = m.global.prefs
    if p = invalid then return false
    return isTrue(p.autoPlayTitle)
end function

' Start (or restart) the wait for the title in the Hero. The quiet part of
' the wait runs on autoTimer; its last autoCountSeconds show the Countdown.
sub autoPlayArm()
    autoPlayDisarm()
    m.autoRearm = false
    if not autoPlayOn() or not m.top.visible then return
    m.autoArmed = true
    secs = th().autoPlaySeconds
    if m.autoSeconds <> invalid then secs = m.autoSeconds
    quiet = secs - th().autoCountSeconds
    if quiet > 0
        m.autoTimer.duration = quiet
        m.autoTimer.control = "start"
    else
        countdownShow(secs, false)
    end if
end sub

sub onAutoWaitDone()
    if not m.autoArmed or not m.top.visible then return
    countdownShow(th().autoCountSeconds, false)
end sub

' A key was pressed: wait the full time again. While a trailer is playing
' the title starts when it ends, so a press only matters during its
' Countdown: that one is called off and the full wait starts after the
' trailer.
sub autoPlayNudge()
    if not m.autoArmed then return
    if not m.trailerPlaying
        autoPlayArm()
    else if m.counting
        autoPlayDisarm()
        m.autoRearm = true
    end if
end sub

sub autoPlayDisarm()
    m.autoArmed = false
    if m.autoTimer <> invalid then m.autoTimer.control = "stop"
    countdownHide()
end sub

sub autoPlayFire()
    if not m.autoArmed then return
    m.autoArmed = false
    countdownHide()
    if not m.top.visible then return
    autoPlayStart()
end sub

' ---------- Auto-play Countdown ----------

' Show "Starting in N" with the bar filling over N seconds. byTrailer: the
' trailer's end starts the title, so the ticks only count down.
sub countdownShow(secs as integer, byTrailer as boolean)
    if secs < 1 then secs = 1
    m.counting = true
    m.countByTrailer = byTrailer
    m.countLeft = secs
    paintCountdown()
    m.countFill.width = 0
    m.countAnim.duration = secs
    m.countAnim.control = "start"
    m.countPill.visible = true
    m.trailerHint.visible = false
    m.countTick.control = "start"
    print "[Matinee] auto-play: starting in "; secs
end sub

sub countdownHide()
    if m.countTick = invalid then return
    m.countTick.control = "stop"
    m.countAnim.control = "stop"
    m.countPill.visible = false
    if m.counting and m.trailerPlaying then m.trailerHint.visible = true
    m.counting = false
end sub

sub paintCountdown()
    m.countText.text = "Starting in " + m.countLeft.ToStr()
end sub

sub onCountTick()
    if not m.counting then return
    m.countLeft = m.countLeft - 1
    if m.countByTrailer
        if m.countLeft < 1 then m.countLeft = 1
        paintCountdown()
    else if m.countLeft <= 0
        autoPlayFire()
    else
        paintCountdown()
    end if
end sub

' Over a playing trailer, its last seconds show the Countdown too.
sub onTrailerPosition()
    if not m.autoArmed or not m.trailerPlaying or m.counting then return
    dur = m.trailerVideo.duration
    if dur <= 0 then return
    remain = dur - m.trailerVideo.position
    if remain > th().autoCountSeconds or remain <= 0 then return
    secs = Int(remain + 0.5)
    countdownShow(secs, true)
end sub

' Start the countdown for a Card. Episodes use their show's trailer.
sub trailerSchedule(c as object)
    trailerStop()
    m.trailerWant = ""
    if c = invalid then return
    if Left(c.itemType, 6) = "seerr-" then return
    id = c.itemId
    if c.itemType = "Episode" and c.seriesId <> "" then id = c.seriesId
    trailerScheduleId(id)
end sub

' A hidden screen only remembers the title: the Hero timer can still fire
' after the screen was left, and its trailer would play behind the next one.
sub trailerScheduleId(id as string)
    trailerStop()
    m.trailerWant = id
    m.autoRearm = false
    if id = "" or not m.top.visible then return
    m.trailerFor = id
    m.trailerTimer.control = "start"
end sub

sub trailerFetch()
    if m.trailerFor = "" or not m.top.visible then return
    m.trailerLegacy = false
    print "[Matinee] trailer: looking for local trailers of "; m.trailerFor
    apiRequest("/Items/" + m.trailerFor + "/LocalTrailers", { "userId": m.global.userId }, "onTrailers", "GET", invalid, m.trailerFor)
end sub

sub onTrailers(event as object)
    res = event.getData()
    if safeStr(res.tag) <> m.trailerFor or not m.top.visible then return
    ' Servers older than 10.9 use the per-user path.
    if not res.ok and res.code = 404 and not m.trailerLegacy
        m.trailerLegacy = true
        apiRequest("/Users/" + m.global.userId + "/Items/" + m.trailerFor + "/LocalTrailers", {}, "onTrailers", "GET", invalid, m.trailerFor)
        return
    end if
    if not res.ok or not isValid(res.data)
        print "[Matinee] trailer: request failed, HTTP "; res.code
        return
    end if
    if type(res.data) <> "roArray" then return
    print "[Matinee] trailer: server has "; res.data.Count(); " local trailer(s)"
    if res.data.Count() = 0 then return
    m.trailerItem = res.data[0]
    playTrailer("direct")
end sub

sub playTrailer(how as string)
    tr = m.trailerItem
    if tr = invalid then return
    id = safeStr(tr.Id)
    token = m.global.token
    content = CreateObject("roSGNode", "ContentNode")
    fmt = LCase(safeStr(tr.Container))
    comma = Instr(1, fmt, ",")
    if comma > 0 then fmt = Left(fmt, comma - 1)
    if fmt = "mov" or fmt = "m4v" then fmt = "mp4"
    if how = "direct" and (fmt = "mp4" or fmt = "mkv")
        content.url = m.global.serverUrl + "/Videos/" + id + "/stream?static=true&api_key=" + token
        content.streamFormat = fmt
    else
        ' Fall back to a light HLS stream the Roku can always play.
        how = "hls"
        url = m.global.serverUrl + "/Videos/" + id + "/master.m3u8?MediaSourceId=" + id
        url = url + "&VideoCodec=h264&AudioCodec=aac&MaxStreamingBitrate=8000000&TranscodingMaxAudioChannels=2"
        url = url + "&SegmentContainer=ts&DeviceId=" + m.global.deviceId + "&api_key=" + token
        content.url = url
        content.streamFormat = "hls"
    end if
    m.trailerTry = how
    ' Never write the access token to the debug log (anyone on the LAN can read port 8085).
    logUrl = content.url
    if token <> "" then logUrl = logUrl.Replace(token, "***")
    print "[Matinee] trailer: playing ("; how; ") "; logUrl
    m.trailerVideo.mute = not trailerSoundOn()
    paintTrailerHint()
    m.trailerVideo.content = content
    m.trailerVideo.control = "play"
end sub

sub onTrailerState()
    st = m.trailerVideo.state
    if st = "playing"
        if not m.trailerPlaying
            m.trailerPlaying = true
            m.trailerGroup.visible = true
            m.trailerHint.visible = true
            m.trailerFade.control = "start"
            trailerHideChrome()
            ' The title starts when the trailer ends instead.
            m.autoTimer.control = "stop"
        end if
    else if st = "error"
        print "[Matinee] trailer: playback error: "; m.trailerVideo.errorMsg
        if m.trailerTry = "direct"
            playTrailer("hls")
        else
            again = m.autoArmed or m.autoRearm
            trailerStop()
            if again then autoPlayArm()
        end if
    else if st = "finished"
        armed = m.autoArmed
        rearm = m.autoRearm
        trailerStop()
        if armed
            m.autoArmed = true
            autoPlayFire()
        else if rearm
            autoPlayArm()
        end if
    end if
end sub

sub trailerStop()
    if m.trailerTimer = invalid then return
    autoPlayDisarm()
    m.trailerTimer.control = "stop"
    m.trailerFor = ""
    m.trailerItem = invalid
    if m.trailerPlaying or m.trailerVideo.state = "buffering" or m.trailerVideo.state = "playing"
        m.trailerVideo.control = "stop"
    end if
    m.trailerPlaying = false
    m.trailerFade.control = "stop"
    m.trailerGroup.opacity = 0
    m.trailerGroup.visible = false
    ' Bring the backdrop back, unless a new one is still loading (it fades in).
    if m.trailerBackdrop.loadStatus = "ready" then m.trailerBackdrop.opacity = 1
    m.trailerHint.visible = false
    trailerShowChrome()
end sub

' Fade the header out so it doesn't sit on the trailer.
sub trailerHideChrome()
    if m.trailerChrome = invalid or not m.trailerPlaying then return
    if m.zone = "badges" then return
    m.chromeFade.control = "start"
end sub

' Bring the header back: the trailer stopped, or focus moved up to it.
sub trailerShowChrome()
    if m.trailerChrome = invalid then return
    m.chromeFade.control = "stop"
    m.trailerChrome.opacity = 1
end sub

function trailerSoundOn() as boolean
    p = m.global.prefs
    if p = invalid then return true
    return p.trailerSound <> false
end function

sub paintTrailerHint()
    if m.trailerVideo.mute
        m.trailerHint.text = "Press Play for sound"
    else
        m.trailerHint.text = "Press Play to mute"
    end if
end sub

' Play toggles the trailer's sound. Returns true if a trailer was playing.
function toggleTrailerSound() as boolean
    if m.trailerVideo = invalid then return false
    if not m.trailerPlaying then return false
    m.trailerVideo.mute = not m.trailerVideo.mute
    paintTrailerHint()
    return true
end function

' Leaving stops the trailer; coming back counts down again for the title
' that was Focused.
sub onTrailerScreenVisible()
    want = m.trailerWant
    trailerStop()
    if m.top.visible and trailersOn() then trailerScheduleId(want)
    m.trailerWant = want
end sub
