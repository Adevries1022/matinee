<?xml version="1.0" encoding="utf-8" ?>
<!-- One title (movie, show or episode) as shown on a Card. -->
<component name="MediaContent" extends="ContentNode">
  <interface>
    <field id="itemId" type="string" />
    <field id="itemType" type="string" />
    <field id="seriesId" type="string" />
    <field id="seasonId" type="string" />
    <field id="heading" type="string" />
    <field id="subtitle" type="string" />
    <field id="meta" type="string" />
    <field id="year" type="string" />
    <field id="rating" type="string" />
    <field id="length" type="string" />
    <field id="genre" type="string" />
    <field id="epCode" type="string" />
    <field id="rowTitle" type="string" />
    <field id="backdropUrl" type="string" />
    <!-- The title's own Logo artwork, drawn in place of the title text. -->
    <field id="logoUrl" type="string" />
    <field id="progress" type="float" />
    <field id="resumeSeconds" type="integer" />
    <field id="cardW" type="integer" />
    <field id="cardH" type="integer" />
    <field id="played" type="boolean" />
    <!-- The User is partway through it: a movie or episode with a resume
         point, an unwatched episode, or a show with some episodes watched. -->
    <field id="watching" type="boolean" />
    <field id="favorite" type="boolean" />
    <!-- Episode Cards: title and description under the artwork, not over it. -->
    <field id="textBelow" type="boolean" />
    <!-- My List: a remove badge at the top right while the Card is Focused. -->
    <field id="removable" type="boolean" />
    <field id="badge" type="string" />
    <field id="requestStatus" type="integer" />
    <!-- Seerr titles that are on the server: their Jellyfin item. -->
    <field id="jellyfinId" type="string" />
    <!-- For Ratings: the title's TMDB id, Jellyfin's Rotten Tomatoes score
         (CriticRating, 0 when unknown) and TMDB's 0-10 score. -->
    <field id="tmdbId" type="string" />
    <field id="criticRating" type="integer" />
    <field id="score" type="float" />
  </interface>
</component>
