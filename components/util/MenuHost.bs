' Shared Rail handling for the browse screens (Home, Series, Movies,
' Search, My List, Discover, My requests, Activity). A screen calls setupMenu(key) in
' init and defines restoreContentFocus() to put focus back on its content.
' Left opens the Rail.

sub setupMenu(currentKey as string)
    m.menuKey = currentKey
    m.menu = CreateObject("roSGNode", "MainMenu")
    m.menu.currentKey = currentKey
    m.menu.items = menuItems()
    m.menu.observeField("chosen", "onMenuChosen")
    m.menu.observeField("closeRequested", "onMenuClose")
    m.top.appendChild(m.menu)
    m.global.observeField("seerrState", "onMenuSourcesChanged")
    m.global.observeField("views", "onMenuSourcesChanged")
    m.global.observeField("servicesVersion", "onMenuSourcesChanged")
end sub

function menuItems() as object
    items = [{ key: "search", label: "Search", icon: "search" }, { key: "home", label: "Home", icon: "home" }]
    hasShows = false
    hasMovies = false
    views = m.global.views
    if views <> invalid
        for each v in views
            if v.collectionType = "tvshows" then hasShows = true
            if v.collectionType = "movies" then hasMovies = true
        end for
    end if
    if hasShows then items.Push({ key: "series", label: "Series", icon: "series" })
    if hasMovies then items.Push({ key: "movies", label: "Movies", icon: "movies" })
    items.Push({ key: "mylist", label: "My List", icon: "mylist" })
    if m.global.seerrState <> "none" and m.global.seerrState <> ""
        items.Push({ key: "discover", label: "Discover", icon: "discover" })
        items.Push({ key: "myrequests", label: "My requests", icon: "downloads" })
    end if
    if arrConfigured() then items.Push({ key: "activity", label: "Activity", icon: "activity" })
    items.Push({ key: "settings", label: "Settings", icon: "settings" })
    return items
end function

sub onMenuSourcesChanged()
    if m.menu = invalid then return
    m.menu.items = menuItems()
end sub

function menuOpenKey() as string
    return "left"
end function

function menuIsOpen() as boolean
    if m.menu = invalid then return false
    return m.menu.open
end function

sub openMenu()
    m.menu.open = true
    m.menu.setFocus(true)
end sub

sub onMenuClose()
    m.menu.open = false
    restoreContentFocus()
end sub

sub onMenuChosen()
    key = m.menu.chosen
    m.menu.open = false
    restoreContentFocus()
    if key = m.menuKey then return
    m.top.navigate = { action: key }
end sub
