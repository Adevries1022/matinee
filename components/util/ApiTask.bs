' Runs one HTTP request against the Jellyfin server off the render thread.
sub init()
    m.top.functionName = "execute"
end sub

sub execute()
    req = m.top.request
    if req.warmHls = true
        warmHls(req)
        return
    end if
    result = send(req, req.server, req.headers)
    ' Seerr's name didn't resolve: try once through the Jellyfin machine's
    ' address, naming Seerr in the Host header, and keep using it if it
    ' answers (see seerrRequest).
    fb = req.fallback
    if result.code = -6 and fb <> invalid
        headers = {}
        if req.headers <> invalid then headers.Append(req.headers)
        headers["Host"] = fb.host
        again = send(req, fb.via + "/api/v1", headers)
        if again.code > 0
            if m.global.seerrVia = "" then print "[Matinee] Seerr's name stopped resolving; going through "; fb.via
            m.global.seerrVia = fb.via
            result = again
        end if
    end if
    m.top.response = result
end sub

function send(req as object, server as string, extra as dynamic) as object
    result = { ok: false, code: 0, data: invalid, error: "", tag: req.tag, cookie: "" }

    xfer = CreateObject("roUrlTransfer")
    port = CreateObject("roMessagePort")
    xfer.SetMessagePort(port)

    url = server + req.path
    q = req.query
    if q <> invalid
        if q.Count() > 0
            parts = []
            for each k in q
                parts.Push(xfer.Escape(k) + "=" + xfer.Escape(toStr(q[k])))
            end for
            url = url + "?" + parts.Join("&")
        end if
    end if

    xfer.SetUrl(url)
    if LCase(Left(url, 5)) = "https"
        xfer.SetCertificatesFile("common:/certs/ca-bundle.crt")
        xfer.InitClientCertificates()
        ' Home servers often use self-signed certificates, so they're allowed
        ' unless "Allow self-signed certificates" is turned off.
        verify = req.verify
        if type(verify) <> "Boolean" and type(verify) <> "roBoolean" then verify = false
        if not verify
            xfer.EnablePeerVerification(false)
            xfer.EnableHostVerification(false)
        end if
    end if
    xfer.AddHeader("Accept", "application/json")
    xfer.AddHeader("Content-Type", "application/json")
    if req.auth <> invalid
        if req.auth <> "" then xfer.AddHeader("Authorization", req.auth)
    end if
    if extra <> invalid
        for each k in extra
            xfer.AddHeader(k, toStr(extra[k]))
        end for
    end if
    xfer.RetainBodyOnError(true)

    method = UCase(req.method)
    started = false
    if method = "GET"
        started = xfer.AsyncGetToString()
    else if method = "DELETE"
        xfer.SetRequest("DELETE")
        started = xfer.AsyncGetToString()
    else
        if method <> "POST" then xfer.SetRequest(method)
        body = req.bodyJson
        if body = invalid then body = ""
        started = xfer.AsyncPostFromString(body)
    end if

    if not started
        result.error = "request did not start"
        return result
    end if

    msg = wait(20000, port)
    if type(msg) = "roUrlEvent"
        code = msg.GetResponseCode()
        result.code = code
        result.cookie = readCookies(msg)
        text = msg.GetString()
        if code >= 200 and code < 300
            result.ok = true
            if text <> invalid
                if text <> "" then result.data = ParseJson(text)
            end if
        else
            result.error = msg.GetFailureReason()
        end if
    else
        xfer.AsyncCancel()
        result.error = "timeout"
    end if
    return result
end function

function toStr(v as dynamic) as string
    t = type(v)
    if t = "String" or t = "roString" then return v
    if t = "Boolean" or t = "roBoolean"
        if v then return "true"
        return "false"
    end if
    if t = "Invalid" or t = "roInvalid" or t = "<uninitialized>" then return ""
    return v.ToStr()
end function

' Collect "name=value" pairs from any Set-Cookie headers (Seerr sessions).
function readCookies(msg as object) as string
    pairs = []
    headers = msg.GetResponseHeadersArray()
    if headers = invalid then return ""
    for each h in headers
        for each k in h
            if LCase(k) = "set-cookie"
                v = toStr(h[k])
                semi = Instr(1, v, ";")
                if semi > 0 then v = Left(v, semi - 1)
                if v <> "" then pairs.Push(v)
            end if
        end for
    end for
    return pairs.Join("; ")
end function

' ---------- Warming up a transcode ----------

' Jellyfin's first HLS segment after it starts (or restarts) a transcode
' carries several seconds of earlier audio, so the sound runs ahead of the
' picture. Fetching the segment before the start point first makes the
' Roku's first segment come from a transcode that's already running, and
' that one is in sync. req.server is the master playlist URL; req.start is
' the start point in seconds.
sub warmHls(req as object)
    result = { ok: false, code: 0, data: invalid, error: "", tag: req.tag, cookie: "" }
    url = req.server
    cut = Instr(1, url, "master.m3u8")
    if cut = 0
        result.error = "not a master playlist"
        m.top.response = result
        return
    end if
    base = Left(url, cut - 1)
    master = getText(url, req)
    mainRel = firstUri(master)
    if mainRel = ""
        result.error = "no variant playlist"
        m.top.response = result
        return
    end if
    playlist = getText(base + mainRel, req)
    startAt = req.start
    t = 0.0
    idx = -1
    uris = []
    dur = 0.0
    for each line in playlist.Tokenize(Chr(10))
        line = line.Trim()
        if Left(line, 8) = "#EXTINF:"
            dur = Val(Mid(line, 9))
        else if line <> "" and Left(line, 1) <> "#"
            if idx < 0 and startAt >= t and startAt < t + dur then idx = uris.Count()
            uris.Push(line)
            t = t + dur
        end if
    end for
    if idx < 1
        ' At the very start the first segment is already in sync.
        result.ok = true
        result.data = { segment: idx }
        m.top.response = result
        return
    end if
    xfer = newXfer(base + uris[idx - 1], req)
    port = CreateObject("roMessagePort")
    xfer.SetMessagePort(port)
    tmp = "tmp:/warm.ts"
    if xfer.AsyncGetToFile(tmp)
        msg = wait(30000, port)
        if type(msg) = "roUrlEvent"
            result.code = msg.GetResponseCode()
            result.ok = (result.code >= 200 and result.code < 300)
        else
            xfer.AsyncCancel()
            result.error = "timeout"
        end if
    end if
    DeleteFile(tmp)
    result.data = { segment: idx }
    m.top.response = result
end sub

function firstUri(text as string) as string
    for each line in text.Tokenize(Chr(10))
        line = line.Trim()
        if line <> "" and Left(line, 1) <> "#" then return line
    end for
    return ""
end function

function getText(url as string, req as object) as string
    xfer = newXfer(url, req)
    port = CreateObject("roMessagePort")
    xfer.SetMessagePort(port)
    if not xfer.AsyncGetToString() then return ""
    msg = wait(15000, port)
    if type(msg) <> "roUrlEvent"
        xfer.AsyncCancel()
        return ""
    end if
    if msg.GetResponseCode() <> 200 then return ""
    return msg.GetString()
end function

function newXfer(url as string, req as object) as object
    xfer = CreateObject("roUrlTransfer")
    xfer.SetUrl(url)
    if LCase(Left(url, 5)) = "https"
        xfer.SetCertificatesFile("common:/certs/ca-bundle.crt")
        xfer.InitClientCertificates()
        verify = req.verify
        if type(verify) <> "Boolean" and type(verify) <> "roBoolean" then verify = false
        if not verify
            xfer.EnablePeerVerification(false)
            xfer.EnableHostVerification(false)
        end if
    end if
    if req.auth <> invalid
        if req.auth <> "" then xfer.AddHeader("Authorization", req.auth)
    end if
    return xfer
end function
