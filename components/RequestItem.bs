' Drawn from a MediaContent made by seerrToContent: requestStatus is
' Seerr's media status (0/1 none, 2 pending, 3 processing, 4 partly
' available, 5 available).
sub init()
    t = th()
    m.card = m.top.findNode("card")
    m.below = m.top.findNode("below")
    m.w = 389
    m.h = 219
    m.pad = t.cellPadX
    m.card.translation = [m.pad, m.pad]
    m.card.scaleRotateCenter = [m.w / 2, m.h / 2]
    makeBox(m.card, m.w, m.h, 14, t.raised)
    m.art = m.card.CreateChild("Poster")
    m.art.width = m.w
    m.art.height = m.h
    m.art.loadWidth = m.w
    m.art.loadHeight = m.h
    m.art.loadDisplayMode = "scaleToZoom"
    corners = makeShape(m.card, "pkg:/images/corners_r14.9.png", m.w, m.h, t.bg)
    corners.loadDisplayMode = "scaleToFill"
    m.chips = m.card.CreateChild("Group")
    m.ring = makeShape(m.top, "pkg:/images/ring_r18_w4.9.png", m.w + 8, m.h + 8, t.accent)
    m.ring.translation = [m.pad - 4, m.pad - 4]
    m.ring.visible = false
    m.below.translation = [m.pad, m.pad + m.h + 12]
end sub

function statusChip(status as integer) as object
    t = th()
    if status = 2 then return { label: "Pending approval", bg: t.warn, fg: "0x1A1405FF" }
    if status = 3 then return { label: "Downloading", bg: t.info, fg: "0x06142AFF" }
    if status = 4 then return { label: "Partly available", bg: t.ok, fg: "0x062012FF" }
    if status = 5 then return { label: "Available", bg: t.ok, fg: "0x062012FF" }
    return { label: "Not requested", bg: t.black, fg: t.soft }
end function

sub showContent()
    c = m.top.itemContent
    if c = invalid then return
    t = th()
    m.art.uri = c.HDPosterUrl
    m.chips.removeChildrenIndex(m.chips.getChildCount(), 0)
    kind = "Movie"
    if c.itemType = "seerr-tv" then kind = "Series"
    k = makeTag(m.chips, UCase(kind), { bg: t.black, bgOpacity: 0.6, fg: t.text, size: 15, h: 30 })
    k.group.translation = [14, 14]
    sc = statusChip(c.requestStatus)
    op = 1.0
    if c.requestStatus < 2 then op = 0.6
    s = makeTag(m.chips, sc.label, { bg: sc.bg, bgOpacity: op, fg: sc.fg, size: 16, h: 32, r: 16, padX: 12 })
    s.group.translation = [m.w - 14 - s.w, 14]

    m.below.removeChildrenIndex(m.below.getChildCount(), 0)
    btnText = ""
    if c.requestStatus < 2 or c.requestStatus = 4 then btnText = "Request"
    if c.requestStatus = 5 then btnText = "Play"
    btnW = 0
    if btnText <> ""
        b = makeBtn(m.below, { kind: "primary", text: btnText, h: 52, size: 18, padX: 22, r: 12 })
        if btnText = "Play"
            b.kind = "secondary"
            paintBtn(b, false)
        end if
        btnW = b.w
        b.group.translation = [m.w - b.w, 2]
    end if
    tl = makeLabel(m.below, c.heading, 24, "display", t.text)
    tl.width = m.w - btnW - 12
    ml = makeLabel(m.below, c.meta, 17, "regular", t.muted)
    ml.translation = [0, 34]
    ml.width = m.w - btnW - 12
end sub

sub updateFocus()
    pct = 0
    if m.top.gridHasFocus then pct = m.top.focusPercent
    m.ring.visible = pct > 0.5
    gx = Int(m.w * 0.02 * pct + 0.5)
    gy = Int(m.h * 0.02 * pct + 0.5)
    m.card.scale = [(m.w + gx * 2) / m.w, (m.h + gy * 2) / m.h]
    m.ring.translation = [m.pad - 4 - gx, m.pad - 4 - gy]
    m.ring.width = m.w + 8 + gx * 2
    m.ring.height = m.h + 8 + gy * 2
end sub
